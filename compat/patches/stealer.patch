-.modal-panel.reanalysis-panel { height: auto; flex: none; max-height: 85vh; overflow-y: auto; align-self: center; }
-.reanalysis-status { display: flex; justify-content: space-between; gap: 16px; margin: 24px 0 12px; color: var(--gold-bright); }
-.reanalysis-progress { width: 100%; height: 8px; border: 0; border-radius: 4px; overflow: hidden; accent-color: var(--gold-primary); background: var(--hairline); }
-.reanalysis-progress::-webkit-progress-bar { background: var(--hairline); }
-.reanalysis-progress::-webkit-progress-value { background: var(--gold-primary); }
-.reanalysis-counts { display: flex; flex-wrap: wrap; gap: 20px; margin: 16px 0; color: var(--text-muted); }
-.reanalysis-counts b { color: var(--text-main); font-variant-numeric: tabular-nums; }
-.reanalysis-current { overflow-wrap: anywhere; font-size: .85rem; color: var(--text-muted); }
-.reanalysis-errors { border-top: 1px solid var(--hairline); padding-top: 12px; margin-top: 16px; }
-.reanalysis-errors summary { cursor: pointer; color: var(--text-main); }
-.reanalysis-errors ul { max-height: 180px; overflow-y: auto; padding-left: 20px; font-size: .85rem; overflow-wrap: anywhere; }
-.reanalysis-errors li { margin: 10px 0; color: var(--text-muted); }
