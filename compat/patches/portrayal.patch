+        items = []
+        for user_id in dict.fromkeys(str(uid) for uid in participants):
+            if self.cfg.message.is_protected_user(user_id):
+                continue
+            profile = self.db.get(user_id)
+            if not profile:
+                continue
+            for source_umo in sorted(allowed):
+                record = profile.scoped_portraits.get(source_umo)
+                if (
+                    not isinstance(record, dict)
+                    or record.get("source_umo") != source_umo
+                    or str(record.get("subject_id") or "") != user_id
