+    def set_deferred(self, profile: UserProfile) -> None:
+        """Update memory only; the caller must call save() once when done.
+
+        save() rewrites the whole profile file (full json.dumps + atomic
+        replace). Callers that update many profiles in one batch (ingest_events
+        processes one event per profile) previously paid one full rewrite per
+        event; batching keeps the final file byte-identical with a single write.
+        """
+        self._data[profile.user_id] = profile
