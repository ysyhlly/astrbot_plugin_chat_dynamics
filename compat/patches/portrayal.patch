+    def get_private_shared_profiles(
+        self,
+        *,
+        platform: str,
+        participants: list[str],
+        persona_id: str = "",
+    ) -> list[dict[str, Any]]:
+        """Read only explicitly allowed, source-attributed portraits for the same subject."""
+        configured = getattr(self.cfg, "private_shared_group_sources", [])
+        if not isinstance(configured, (list, tuple, set)):
+            return []
+        allowed = {
+            str(source).strip()
+            for source in configured
+            if _group_source_matches(source, platform)
+        }
+        if not allowed:
+            return []
