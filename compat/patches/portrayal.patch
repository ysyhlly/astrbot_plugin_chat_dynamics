+def _is_private_event(event: object) -> bool:
+    getter = getattr(event, "get_message_type", None)
+    if not callable(getter):
+        return False
+    try:
+        message_type = getter()
+    except Exception:
+        return False
+    label = f"{getattr(message_type, 'name', '')} {message_type}".casefold()
+    return ("private" in label or "friend" in label) and "group" not in label
+
+
+def _group_source_matches(source_umo: object, platform: object) -> bool:
+    parts = str(source_umo or "").strip().split(":")
+    expected = str(platform or "").strip().casefold()
+    return (
+        len(parts) >= 3
+        and parts[1].casefold() == "groupmessage"
+        and bool(expected)
+        and parts[0].casefold() == expected
+        and bool(":".join(parts[2:]).strip())
+    )
+
