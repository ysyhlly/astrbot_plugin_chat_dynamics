+    async def ingest_events(self, events: list[dict]) -> dict:
+        """Rebuild bounded, extractive background from attributed local speech.
+
+        Old unscoped portraits are never relabelled. No LLM or outgoing message
+        is needed to preserve what a participant actually said in this group.
+        """
+        accepted = 0
+        # 逐事件只改内存、循环结束统一落盘：db.set() 每次都会全量重写画像文件
+        # （json.dumps 整个库 + 原子替换），一批 N 个事件会产生 N 次全量写盘。
+        # 循环体内没有 await，所以这段对事件循环而言是原子的；finally 保证异常
+        # 中断时已接受的变更仍会落盘，最终文件内容与逐条 set() 完全相同。
+        try:
+            for event in events:
+                scope = event.get("scope", {})
+                umo, uid = scope.get("umo", ""), str(event.get("actor_id", ""))
+                if (event.get("schema_version") != 1 or event.get("type") != "message.received"
+                        or not umo or not uid or self.cfg.message.is_protected_user(uid)):
+                    continue
+                text = str(event.get("text", "")).strip()
+                if not text or not event.get("event_id"):
+                    continue
+                profile = self.db.get(uid) or UserProfile(user_id=uid)
+                record = dict(profile.scoped_portraits.get(umo) or {})
+                evidence = list(record.get("evidence", []))
+                if any(e.get("source_id") == event["event_id"] for e in evidence):
+                    continue
+                evidence.append({"source_id": event["event_id"], "text": text[:240],
+                                 "occurred_at": event.get("occurred_at", 0), "fact_kind": "observation"})
+                evidence.sort(key=lambda e: e.get("occurred_at", 0))
+                evidence = evidence[-20:]
+                # Keep a manually generated scoped portrait; append its new sources.
+                if not record.get("text") or record.get("extractive"):
+                    record.update(text="该成员在本群的近期原话（发言记录，不证明内容属实）：" +
+                                  "；".join(e["text"][:120] for e in evidence[-3:]), extractive=True)
+                record.update(source_umo=umo, subject_id=uid, evidence=evidence,
+                              timestamp=max(e["occurred_at"] for e in evidence))
+                profile.scoped_portraits[umo] = record
+                self.db.set_deferred(profile)
+                accepted += 1
+        finally:
+            if accepted:
+                self.db.save()
+        return {"schema_version": 1, "accepted": accepted}
