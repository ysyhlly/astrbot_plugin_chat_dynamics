+    @staticmethod
+    def _native_prune_source_views(source_views, selected_atom_ids):
+        output = []
+        for source_view in source_views if isinstance(source_views, list) else []:
+            if not isinstance(source_view, dict):
+                continue
+            view = source_view.get("evidence_view")
+            if not isinstance(view, dict):
+                continue
+            atoms = [atom for atom in view.get("atoms", [])
+                     if isinstance(atom, dict) and atom.get("atom_id") in selected_atom_ids]
+            if not atoms:
+                continue
+            copied_view = dict(view)
+            copied_view["atoms"] = atoms
+            copied_view["slots"] = {
+                key: [atom for atom in values if isinstance(atom, dict)
+                      and atom.get("atom_id") in selected_atom_ids]
+                for key, values in (view.get("slots") or {}).items()
+                if isinstance(values, list)
+            }
+            material_ids = {
+                str(ref.get("material_id"))
+                for atom in atoms for ref in atom.get("source_refs", [])
+                if isinstance(ref, dict) and isinstance(ref.get("material_id"), str)
+            }
+            event_ids = {
+                str(ref.get("source_event_id"))
+                for atom in atoms for ref in atom.get("source_refs", [])
+                if isinstance(ref, dict) and isinstance(ref.get("source_event_id"), str)
+            }
+            copied = dict(source_view)
+            copied["evidence_view"] = copied_view
+            copied["native_materials"] = [row for row in source_view.get("native_materials", [])
+                                           if isinstance(row, dict)
+                                           and (row.get("source_locator", {}).get("kind") == "conversation_row"
+                                                and row.get("material_id") in material_ids)]
+            copied["native_events"] = [row for row in source_view.get("native_events", [])
+                                        if isinstance(row, dict) and row.get("event_id") in event_ids]
+            output.append(copied)
+        return output
+
+    @staticmethod
+    def _native_merge_source_view(source_views, candidate):
+        """Keep one immutable view per scope/card/purpose/revision request identity."""
+        if not isinstance(source_views, list) or not isinstance(candidate, dict):
+            return False
+        candidate_scope = candidate.get("scope")
+        candidate_view = candidate.get("evidence_view")
+        if not isinstance(candidate_scope, dict) or not isinstance(candidate_view, dict):
+            return False
+        try:
+            candidate_scope_key = scope_key(candidate_scope)
+        except Exception:
+            return False
+        for current in source_views:
+            if not isinstance(current, dict):
+                continue
+            current_scope = current.get("scope")
+            current_view = current.get("evidence_view")
+            if not isinstance(current_scope, dict) or not isinstance(current_view, dict):
+                continue
+            try:
+                same_scope = scope_key(current_scope) == candidate_scope_key
+            except Exception:
+                same_scope = False
+            if not same_scope:
+                continue
+            if (current.get("purpose") != candidate.get("purpose")
+                    or current.get("card_version") != candidate.get("card_version")
+                    or current_view.get("correction_revision") != candidate_view.get("correction_revision")):
+                return False
+            atom_by_id = {
+                atom.get("atom_id"): atom
+                for atom in [*current_view.get("atoms", []), *candidate_view.get("atoms", [])]
+                if isinstance(atom, dict) and isinstance(atom.get("atom_id"), str)
+            }
+            merged_view = dict(current_view)
+            merged_view["atoms"] = list(atom_by_id.values())
+            keys = set(current_view.get("slots", {})) | set(candidate_view.get("slots", {}))
+            merged_view["slots"] = {}
+            for key in keys:
+                by_id = {}
+                for atom in [*(current_view.get("slots", {}).get(key, []) or []),
+                             *(candidate_view.get("slots", {}).get(key, []) or [])]:
+                    if isinstance(atom, dict) and isinstance(atom.get("atom_id"), str):
+                        by_id[atom["atom_id"]] = atom
+                merged_view["slots"][key] = list(by_id.values())
+            merged_view["evidence_status"] = EvidenceViewService._evidence_status(merged_view)
+            current["evidence_view"] = merged_view
+            for field, unique_key in (("native_materials", "material_id"), ("native_events", "event_id")):
+                rows = [*current.get(field, []), *candidate.get(field, [])]
+                unique = {}
+                for row in rows:
+                    if not isinstance(row, dict):
+                        continue
+                    identity = row.get(unique_key)
+                    if field == "native_events":
+                        identity = (identity, row.get("atom_id"))
+                    if identity is not None:
+                        previous = unique.get(identity)
+                        if (isinstance(previous, dict) and previous.get("retrieval_hit") is True
+                                and row.get("retrieval_hit") is not True):
+                            continue
+                        unique[identity] = row
+                current[field] = list(unique.values())
+            return True
+        source_views.append(candidate)
+        return True
+
+    @staticmethod
+    def _native_blocking_context(event):
+        getter = getattr(event, "get_extra", None)
+        value = getter("_autonomous_blocking_context_v1", None) if callable(getter) else None
+        return request_identity(value)
+
+    async def _filter_native_frames(self, event, request_scope, frames):
+        """Apply a fresh public current-private Blocking policy to source UID frames."""
+        getter = getattr(self.context, "get_all_stars", None)
+        if not callable(getter):
+            return False
+        try:
+            stars = getter()
+            if inspect.isawaitable(stars):
+                stars = await stars
+        except Exception:
+            return False
+        entries = stars.items() if isinstance(stars, dict) else (("", item) for item in (stars or ()))
+        for key, entry in entries:
+            get = entry.get if isinstance(entry, dict) else lambda field, default=None: getattr(entry, field, default)
+            if not get("activated", True):
+                continue
+            names = (key, get("name"), get("root_dir_name"), get("module_path"))
+            if not any("autonomous_blocking" in str(value or "").casefold() for value in names):
+                continue
+            star = get("star_cls") or get("star") or get("plugin")
+            if star is None or isinstance(star, type):
+                continue
+            resolver = getattr(star, "resolve_context", None)
+            filter_material = getattr(star, "filter_material", None)
+            if getattr(star, "enabled", None) is False:
+                return [dict(frame) for frame in frames]
+            if not callable(resolver) or not callable(filter_material):
+                return False
+            try:
+                context = resolver(event=event, scope=dict(request_scope))
+                if inspect.isawaitable(context):
+                    context = await context
+                if (not isinstance(context, dict) or context.get("ready") is not True
+                        or context.get("umo") != request_scope.get("umo")):
+                    return False
+                owner = context.get("owner")
+                platform_getter = getattr(event, "get_platform_id", None)
+                self_getter = getattr(event, "get_self_id", None)
+                if not callable(platform_getter) or not callable(self_getter):
+                    return False
+                try:
+                    event_platform = str(platform_getter() or "")
+                    event_self = str(self_getter() or "")
+                except Exception:
+                    return False
+                if (not isinstance(owner, dict)
+                        or owner.get("platform_instance_id") != event_platform
+                        or owner.get("self_id") != event_self
+                        or not event_platform or not event_self):
+                    return False
+                result = filter_material(context, {"quotes": [dict(frame) for frame in frames]}, "reply")
+                if inspect.isawaitable(result):
+                    result = await result
+            except Exception:
+                return False
+            allowed = result.get("quotes") if isinstance(result, dict) else None
+            if not isinstance(allowed, list):
+                return False
+            original = {(frame.get("atom_id"), frame.get("text"), frame.get("author_uid")) for frame in frames}
+            current = {(frame.get("atom_id"), frame.get("text"), frame.get("author_uid"))
+                       for frame in allowed if isinstance(frame, dict)}
+            surviving = original & current
+            return [dict(frame) for frame in frames
+                    if (frame.get("atom_id"), frame.get("text"), frame.get("author_uid")) in surviving]
+        return False
+
+    def _native_row_policy_check(self, event, request_scope):
+        """Build a request-local fresh Blocking check for one source row."""
+        async def check(descriptor, material):
+            return await self._native_row_policy_allowed(
+                event, request_scope, descriptor, material
+            )
+        return check
+
+    async def _native_row_policy_allowed(self, event, request_scope, descriptor, material):
+        if (not isinstance(request_scope, dict) or not isinstance(descriptor, dict)
+                or not isinstance(material, dict)):
+            return False
+        locator = descriptor.get("source_locator")
+        source_scope = locator.get("scope") if isinstance(locator, dict) else None
+        if (not isinstance(source_scope, dict)
+                or locator.get("kind") != "conversation_row"
+                or material.get("source_status") != "conversation_row"
+                or material.get("role") != "user"
+                or not isinstance(material.get("author_id"), str)
+                or not material.get("author_id")
+                or not isinstance(material.get("row_hash"), str)
+                or not isinstance(material.get("text"), str)):
+            return False
+        try:
+            persona_id = await get_persona_id(self.context, event)
+            if persona_id != request_scope.get("persona_id"):
+                return False
+            allowed_scopes = await self._native_read_scopes(
+                event, request_scope, persona_id
+            )
+            source_scope_key = scope_key(source_scope)
+            if not any(scope_key(scope) == source_scope_key
+                       for scope, _readonly, _policy in allowed_scopes):
+                return False
+        except Exception:
+            return False
+        source_uids = [material["author_id"]]
+        subjects = material.get("subject_ids", [])
+        if isinstance(subjects, list):
+            source_uids.extend(str(value) for value in subjects
+                               if isinstance(value, str) and value.strip())
+        frame = {
+            "atom_id": str(descriptor.get("material_id", "")),
+            "scope_umo": source_scope.get("umo", ""),
+            "text": material["text"],
+            "author_uid": material["author_id"],
+            "source_uids": list(dict.fromkeys(source_uids)),
+            "source_kind": "conversation_row",
+            "provenance_complete": True,
+        }
+        allowed = await self._filter_native_frames(event, request_scope, [frame])
+        return isinstance(allowed, list) and len(allowed) == 1
+
+    async def _resolve_evidence_source_refs(self, scope: dict, source_refs: list[dict] | None) -> tuple[list[dict], int]:
+        """Resolve event-only references against this plugin's exact-scope archive."""
+        if not source_refs:
+            return [], 0
+        manager = self.initializer.conversation_manager
+        store = getattr(manager, "store", None) if manager else None
+        loader = getattr(store, "load_narrative_event", None)
+        try:
+            expected_scope_id = scope_key(scope)
+        except Exception:
+            return [], min(len(source_refs), MAX_MATERIALS)
+        output = []
+        rejected = 0
+        batch_loader = getattr(store, "load_narrative_events", None)
+        batch_events = None
+        if callable(batch_loader):
+            ids = []
+            for raw in source_refs[:MAX_MATERIALS]:
+                if isinstance(raw, dict) and raw.get("source_kind") != "host_history":
+                    eid = raw.get("source_event_id", raw.get("event_id"))
+                    if isinstance(eid, str) and eid.strip():
+                        ids.append(eid.strip())
+            try:
+                candidate_events = await batch_loader(scope, ids)
+                if isinstance(candidate_events, dict):
+                    batch_events = candidate_events
+            except asyncio.CancelledError:
+                raise
+            except Exception:
+                batch_events = {}
+        for raw in source_refs[:MAX_MATERIALS]:
+            if not isinstance(raw, dict):
+                rejected += 1
+                continue
+            if raw.get("item_kind") == "evidence_atom":
+                # Typed atoms are accepted only through the explicit typed_items
+                # view path, where current scope, revision and roots are checked.
+                rejected += 1
+                continue
+            if raw.get("source_kind") == "host_history":
+                output.append(raw)
+                continue
+            source_id = raw.get("source_event_id", raw.get("event_id"))
+            source_kind = raw.get("source_kind")
+            if source_kind == "event" or source_id is not None:
+                if not callable(loader) or not isinstance(source_id, str) or not source_id.strip():
+                    rejected += 1
+                    continue
+                claimed_scope_hash = raw.get("scope_key")
+                if claimed_scope_hash and claimed_scope_hash != expected_scope_id:
+                    rejected += 1
+                    continue
+                try:
+                    stored = (batch_events.get(source_id.strip()) if batch_events is not None
+                              else await loader(scope, source_id.strip()))
+                except Exception:
+                    stored = None
+                if not isinstance(stored, dict):
+                    rejected += 1
+                    continue
+                canonical_scope = self._canonical_event_scope(scope, stored.get("scope"))
+                if canonical_scope is None:
+                    rejected += 1
+                    continue
+                if raw.get("event_type") and raw["event_type"] != stored.get("type"):
+                    rejected += 1
+                    continue
+                if raw.get("actor_id") and raw["actor_id"] != stored.get("actor_id"):
+                    rejected += 1
+                    continue
+                output.append({
+                    "source_kind": "event", "event_id": stored["event_id"],
+                    "event_type": stored["type"], "scope": canonical_scope,
+                    "text": stored["text"], "actor_id": stored.get("actor_id"),
+                    "occurred_at": stored.get("occurred_at"),
+                })
+            else:
+                output.append(raw)
+        return output, rejected
+
+    @staticmethod
+    def _canonical_event_scope(request_scope: dict, archived_scope: dict) -> dict | None:
+        """Return only loader-verified identity fields; discard retrieval metadata."""
+        if not isinstance(request_scope, dict) or not isinstance(archived_scope, dict):
+            return None
+        canonical = {}
+        for key in ("platform", "umo", "persona_id", "instance_id"):
+            requested = request_scope.get(key)
+            stored = archived_scope.get(key)
+            if (not isinstance(requested, str) or not requested.strip() or
+                    not isinstance(stored, str) or not stored.strip() or
+                    stored != requested):
+                return None
+            canonical[key] = stored
+        return canonical
+
+    async def get_evidence_view(self, scope: dict, source_refs: list[dict] | None = None,
+                                purpose: str = "reply", card_version: str = "",
+                                conversation_id: str | None = None,
+                                snapshot_fingerprint: str | None = None,
+                                materials: list[dict] | None = None,
+                                typed_items: list[dict] | None = None,
+                                allow_derivation: bool = True) -> dict:
+        request_started = time.perf_counter()
+        if self._terminating:
+            return EvidenceViewService._empty_view("terminating", purpose, card_version)
+        if purpose not in PURPOSES:
+            return EvidenceViewService._empty_view("invalid_purpose", purpose, card_version)
+        if not await self._narrative_scope_allowed(scope):
+            return EvidenceViewService._empty_view("scope_not_allowed", purpose, card_version)
+        auth_done = time.perf_counter()
+        if not self.initializer.is_initialized or not self.evidence_service:
+            return EvidenceViewService._empty_view("service_unavailable", purpose, card_version)
+        combined_materials = []
+        combined_typed_items = [row for row in (typed_items or []) if isinstance(row, dict)]
+        for row in [*(source_refs or []), *(materials or [])]:
+            if not isinstance(row, dict):
+                continue
+            if row.get("item_kind") == "evidence_atom":
+                combined_typed_items.append(row)
+            else:
+                combined_materials.append(row)
+        combined_materials = combined_materials[:MAX_MATERIALS]
+        combined_typed_items = combined_typed_items[:MAX_MATERIALS]
+        resolved_refs, rejected = await self._resolve_evidence_source_refs(scope, combined_materials)
+        refs_done = time.perf_counter()
+        view = await self.evidence_service.get_evidence_view(
+            scope, source_refs=resolved_refs, purpose=purpose, card_version=card_version,
+            conversation_id=conversation_id, snapshot_fingerprint=snapshot_fingerprint,
+            typed_items=combined_typed_items, allow_derivation=allow_derivation,
+        )
+        if rejected:
+            diagnostics = dict(view.get("diagnostics", {}))
+            diagnostics["source_refs_rejected"] = int(diagnostics.get("source_refs_rejected", 0)) + rejected
+            view = {**view, "diagnostics": diagnostics}
+            view["evidence_status"] = EvidenceViewService._evidence_status(view)
+        diagnostics = dict(view.get('diagnostics', {}))
+        diagnostics['request_stage_ms'] = {
+            'scope_auth': round((auth_done-request_started)*1000, 2),
+            'source_resolve': round((refs_done-auth_done)*1000, 2),
+            'cached_view': round((time.perf_counter()-refs_done)*1000, 2)}
+        view = {**view, 'diagnostics': diagnostics}
+        return view
+
+    async def queue_material_derivation(self, materials: list[dict], scope: dict | None = None,
+                                        purpose: str = "reply", card_version: str = "") -> dict:
+        if (
+            self._terminating or not self.evidence_service or not isinstance(scope, dict) or
+            purpose not in PURPOSES or not await self._narrative_scope_allowed(scope)
+        ):
+            return {"schema_version": 1, "accepted": False, "queued": 0,
+                    "duplicates": 0, "skipped": len(materials) if isinstance(materials, list) else 0,
+                    "material_ids": []}
+        resolved, rejected = await self._resolve_evidence_source_refs(scope, materials)
+        result = await self.evidence_service.queue_material_derivation(
+            resolved, scope=scope, purpose=purpose, card_version=card_version
+        )
+        if rejected:
+            result["skipped"] = int(result.get("skipped", 0)) + rejected
+        return result
+
+    async def _load_evidence_material(self, descriptor: dict) -> dict | None:
+        """Rehydrate a deferred source by its exact locator, never by stored text."""
+        locator = descriptor.get("source_locator")
+        if not isinstance(locator, dict) or not isinstance(locator.get("scope"), dict):
+            return None
+        scope = {key: locator["scope"].get(key) for key in
+                 ("platform", "umo", "persona_id", "instance_id")}
+        try:
+            if scope_key(scope) != str(descriptor.get("scope_key", "")):
+                return None
+        except Exception:
+            return None
+        if not self.evidence_service:
+            return None
+        revision = self.evidence_service.peek_evidence_revision(scope)
+        if (not revision.get("available") or
+                revision.get("correction_revision") != descriptor.get("correction_revision")):
+            return None
+
+        kind = locator.get("kind")
+        raw = None
+        if kind == "event":
+            event_id = locator.get("event_id")
+            if not isinstance(event_id, str) or not event_id.strip():
+                return None
+            manager = getattr(self.initializer, "conversation_manager", None)
+            store = getattr(manager, "store", None) if manager else None
+            loader = getattr(store, "load_narrative_event", None)
+            event = await loader(scope, event_id) if callable(loader) else None
+            if not isinstance(event, dict):
+                return None
+            if event.get("type") != locator.get("event_type"):
+                return None
+            raw = {
+                "source_kind": "event", "event_id": event_id,
+                "event_type": event.get("type"), "scope": event.get("scope"),
+                "text": event.get("text"), "actor_id": event.get("actor_id"),
+                "occurred_at": event.get("occurred_at"),
+                "source_position": descriptor.get("position", 0),
+                "receipt": event.get("receipt"),
+            }
+        elif kind == "conversation_row":
+            row_id = locator.get("row_id")
+            source_memory_id = locator.get("source_memory_id")
+            row = await self._native_verified_source_row(
+                scope, source_memory_id, row_id,
+                persona_id=str(scope.get("persona_id") or ""),
+                persona_filtering=bool(
+                    getattr(self.config_manager, "filtering_settings", {}).get(
+                        "use_persona_filtering", True
+                    )
+                ),
+            )
+            if not isinstance(row, dict):
+                return None
+            raw = {**row, "source_kind": "conversation_row",
+                   "source_memory_id": source_memory_id}
+        elif kind == "host_history":
+            conversation_id = locator.get("conversation_id")
+            fingerprint = locator.get("snapshot_fingerprint")
+            position = locator.get("position")
+            if (not isinstance(conversation_id, str) or not conversation_id or
+                    not isinstance(fingerprint, str) or not fingerprint or
+                    isinstance(position, bool) or not isinstance(position, int) or position < 0):
+                return None
+            manager = getattr(self.initializer, "conversation_manager", None)
+            conversation = await manager.get_conversation(scope["umo"], conversation_id) if manager else None
+            history = getattr(conversation, "history", None) if conversation else None
+            if not isinstance(history, str) or hashlib.sha256(history.encode("utf-8")).hexdigest() != fingerprint:
+                return None
+            try:
+                rows = json.loads(history)
+            except (TypeError, ValueError):
+                return None
+            if not isinstance(rows, list) or position >= len(rows) or not isinstance(rows[position], dict):
+                return None
+            row = rows[position]
+            if (not set(row).issubset({"role", "content"}) or
+                    row.get("role") not in {"user", "assistant"} or
+                    row.get("role") != locator.get("role") or "content" not in row):
+                return None
+            content = row.get("content")
+            if isinstance(content, str):
+                text = content
+            elif isinstance(content, list):
+                visible_parts = [
+                    part.get("text", "") for part in content
+                    if isinstance(part, dict) and set(part) == {"type", "text"} and
+                    part.get("type") == "text" and isinstance(part.get("text"), str)
+                ]
+                text = "".join(visible_parts)
+            else:
+                return None
+            raw = {
+                "source_kind": "host_history", "conversation_id": conversation_id,
+                "snapshot_fingerprint": fingerprint, "position": position,
+                "role": row.get("role"), "text": text,
+                "source_prefix_anchor": locator.get("source_prefix_anchor", ""),
+                "history_epoch": locator.get("history_epoch", ""),
+            }
+        elif kind == "legacy_summary":
+            document_id = locator.get("document_id")
+            source_umo = locator.get("source_umo")
+            if (not isinstance(document_id, str) or not document_id.isdigit() or
+                    source_umo not in {scope.get("umo"), scope_key(scope)}):
+                return None
+            engine = getattr(self.initializer, "memory_engine", None)
+            memory = await engine.get_memory(int(document_id)) if engine else None
+            if not isinstance(memory, dict):
+                return None
+            metadata = memory.get("metadata") or {}
+            if isinstance(metadata, str):
+                try:
+                    metadata = json.loads(metadata)
+                except (TypeError, ValueError):
+                    return None
+            if not isinstance(metadata, dict) or source_origin(metadata) != source_umo:
+                return None
+            raw = {"source_kind": "legacy_summary", "document_id": document_id,
+                   "source_umo": source_umo, "text": memory.get("text")}
+        else:
+            return None
+
+        prepared = self.evidence_service._normalize(
+            raw, scope, str(descriptor.get("card_version", "")),
+            str(locator.get("purpose", "reply")), int(descriptor.get("correction_revision", 0)),
+        )
+        if not prepared:
+            return None
+        loaded_descriptor, material = prepared
+        for field in ("material_id", "scope_key", "material_kind", "role", "conversation_id",
+                      "snapshot_fingerprint", "position", "source_family_id", "text_hash", "projection_key"):
+            if loaded_descriptor.get(field) != descriptor.get(field):
+                return None
+        return material
+
+    async def _load_archived_evidence_event(self, scope: dict, event_id: str) -> dict | None:
+        """Read one exact-scope narrative event for cache provenance repair."""
+        if (self._canonical_event_scope(scope, scope) is None or
+                not isinstance(event_id, str) or not event_id.strip()):
+            return None
+        manager = getattr(self.initializer, "conversation_manager", None)
+        store = getattr(manager, "store", None) if manager else None
+        loader = getattr(store, "load_narrative_event", None)
+        if not callable(loader):
+            return None
+        event = await loader(scope, event_id.strip())
+        if not isinstance(event, dict) or event.get("event_id") != event_id.strip():
+            return None
+        canonical_scope = self._canonical_event_scope(scope, event.get("scope"))
+        if canonical_scope is None:
+            return None
+        return {**event, "scope": canonical_scope}
+
+    async def _evidence_material_policy(self, descriptor: dict, material: dict) -> bool | None:
+        """Recheck current memory boundaries before derivation and persistence."""
+        locator = descriptor.get("source_locator")
+        scope = locator.get("scope") if isinstance(locator, dict) else None
+        if not isinstance(scope, dict):
+            return False
+        try:
+            if scope_key(scope) != str(descriptor.get("scope_key", "")):
+                return False
+        except Exception:
+            return False
+        # The worker rehydrates source state before derivation and commit. Apply
+        # current scope and actor policy to that canonical material each time.
+        if descriptor.get("material_kind") == "source_event":
+            actor_id = material.get("actor_id") or ""
+        else:
+            actor_id = ""
+        if not await self._narrative_scope_allowed(scope, str(actor_id)):
+            return False
+        return await self._blocking_policy_gate.check(descriptor, material)
+
+    def _effective_rerank_status(self) -> dict:
+        """Report local rerank binding state without resolving/calling a provider."""
+        engine = getattr(self.initializer, "memory_engine", None)
+        config = getattr(engine, "config", {}) if engine else {}
+        config = config if isinstance(config, dict) else {}
+        enabled = bool(config.get("rerank_enabled", False))
+        provider_configured = bool(str(config.get("rerank_provider_id", "") or "").strip())
+        resolver_available = callable(getattr(engine, "rerank_provider_resolver", None)) if engine else False
+        if not enabled:
+            effective = "disabled"
+        elif not provider_configured:
+            effective = "skipped_unconfigured"
+        elif not resolver_available:
+            effective = "resolver_unavailable"
+        else:
+            effective = "configured_not_probed"
+        return {"enabled": enabled, "provider_configured": provider_configured,
+                "resolver_available": resolver_available, "effective": effective}
+
+    def peek_evidence_revision(self, scope: dict) -> dict:
+        try:
+            key = scope_key(scope)
+        except Exception:
+            return {"schema_version": 1, "available": False, "scope_key": "",
+                    "correction_revision": None, "revocations": []}
+        if not self.evidence_service or self._terminating:
+            return {"schema_version": 1, "available": False, "scope_key": key,
+                    "correction_revision": None, "revocations": []}
+        return self.evidence_service.peek_evidence_revision(scope)
+
+    async def correct_insight(self, target_id: str, expected_revision: int, action: str,
+                              replacement: str = "", reason: str = "", action_id: str = "") -> dict:
+        if not self.evidence_service or self._terminating:
+            raise RuntimeError("evidence store unavailable")
