+                                "FROM evidence_atoms WHERE atom_id=?", (target_id,)).fetchone()
+            if target:
+                scope_key = str(target[1])
+                roots = set(json.loads(target[5]))
+                material_roots = set(json.loads(target[7]))
+                material_roots.add(str(target[2]))
+            else:
+                material = db.execute("SELECT material_id,scope_key FROM evidence_materials WHERE material_id=?",
+                                      (target_id,)).fetchone()
+                if not material:
+                    db.rollback()
+                    raise ValueError("insight or material not found")
+                scope_key = str(material[1])
+                roots = set()
+                material_roots = {str(material[0])}
+            families = set()
+            for material_id in tuple(material_roots):
+                family = db.execute("SELECT source_family_id FROM evidence_materials WHERE material_id=? AND scope_key=?",
+                                    (material_id, scope_key)).fetchone()
+                if family and family[0]:
+                    families.add(str(family[0]))
+            if action_id:
+                previous = db.execute("SELECT correction_revision,target_id,action,replacement_atom_id,affected_ids_json "
+                                      "FROM evidence_corrections WHERE scope_key=? AND action_id=?",
+                                      (scope_key, action_id)).fetchone()
+                if previous:
+                    db.commit()
+                    return {"schema_version": 1, "scope_key": scope_key,
+                            "correction_revision": int(previous[0]), "target_id": previous[1],
+                            "action": previous[2], "replacement_atom_id": previous[3],
+                            "affected_ids": json.loads(previous[4]), "idempotent_replay": True}
+            revision_row = db.execute("SELECT correction_revision FROM evidence_scope_revisions WHERE scope_key=?",
+                                      (scope_key,)).fetchone()
+            revision = int(revision_row[0]) if revision_row else 0
+            if revision != int(expected_revision):
+                db.rollback()
+                raise RuntimeError("stale correction revision")
+            affected = set(roots) | set(material_roots) | families
+            if target:
+                affected.add(str(target[0]))
+            rows = db.execute("SELECT atom_id,material_id,root_ids_json,root_material_ids_json FROM evidence_atoms WHERE scope_key=? AND status IN ('active','reported_unverified','pending_continuity')",
+                              (scope_key,)).fetchall()
+            for row in rows:
+                atom_roots = set(json.loads(row[2]))
+                atom_material_roots = set(json.loads(row[3]))
+                material_row = db.execute("SELECT source_family_id FROM evidence_materials WHERE material_id=? AND scope_key=?",
+                                          (row[1], scope_key)).fetchone()
+                same_family = material_row and str(material_row[0]) in families
+                if atom_roots & roots or atom_material_roots & material_roots or str(row[1]) in material_roots or same_family:
+                    affected.add(str(row[0]))
+            new_revision = revision + 1
+            replacement_atom_id = None
+            if not target:
+                db.execute("UPDATE evidence_materials SET status='invalidated',diagnostics_code='admin_correction',updated_at=? "
+                           "WHERE material_id=? AND scope_key=?", (now, target_id, scope_key))
+                db.execute("DELETE FROM evidence_derivation_queue WHERE material_id=? AND scope_key=?",
+                           (target_id, scope_key))
+            if action == "supersede":
+                if target:
+                    target_atom = json.loads(target[6])
+                    replacement_atom_id = "atm1:" + hashlib.sha256(
+                        (scope_key + "\0" + str(target[3]) + "\0" + replacement.strip().casefold() + "\0" + str(new_revision)).encode()
+                    ).hexdigest()
+                    next_atom = dict(target_atom)
+                    next_atom.update({"atom_id": replacement_atom_id, "claim": replacement.strip(),
+                                      "status": "active", "revision": new_revision,
+                                      "supersedes": target_id, "derived_from": [target_id]})
+                    next_roots = sorted(roots)
+                    next_material_roots = sorted(material_roots)
+                    next_atom["root_evidence_ids"] = next_roots
+                    next_atom["root_material_ids"] = next_material_roots
+                    db.execute("""INSERT INTO evidence_atoms(atom_id,scope_key,material_id,kind,status,root_ids_json,root_material_ids_json,atom_json,revision,created_at,updated_at)
+                                  VALUES (?,?,?,?,?,?,?,?,?,?,?)""",
+                                 (replacement_atom_id, scope_key, str(target[2]), str(target[3]), "active",
+                                  _json(next_roots), _json(next_material_roots), _json(next_atom), new_revision, now, now))
+                    affected.add(replacement_atom_id)
+                else:
+                    db.rollback()
+                    raise ValueError("material-only supersede requires a derived insight first")
+            for material_id in material_roots:
+                db.execute("UPDATE evidence_materials SET status='invalidated',diagnostics_code='source_correction',updated_at=? "
+                           "WHERE material_id=? AND scope_key=?", (now, material_id, scope_key))
+                db.execute("DELETE FROM evidence_derivation_queue WHERE material_id=? AND scope_key=?",
+                           (material_id, scope_key))
+            correction_id = "cor1:" + uuid.uuid4().hex
+            affected_ids = sorted(affected)
+            db.execute("INSERT INTO evidence_corrections(correction_id,scope_key,correction_revision,target_id,action,replacement_atom_id,affected_ids_json,reason,action_id,created_at) VALUES (?,?,?,?,?,?,?,?,?,?)",
+                       (correction_id, scope_key, new_revision, target_id, action, replacement_atom_id,
+                        _json(affected_ids), reason.strip(), action_id[:160] if action_id else None, now))
+            db.execute("INSERT INTO evidence_scope_revisions(scope_key,correction_revision) VALUES (?,?) "
