+    async def _commit_write_transaction(self) -> None:
+        """Wait for the SQLite worker commit before releasing a writer lock.
+
+        aiosqlite queues connection work on a background thread. Shielding and
+        draining this one commit keeps cancellation from returning while the
+        same transaction can still commit later without its caller.
+        """
+        if self.connection is None:
+            raise RuntimeError("数据库连接未初始化")
+        commit_task = contextvars.Context().run(
+            asyncio.create_task, self.connection.commit()
+        )
+        cancelled = False
+        while not commit_task.done():
+            try:
+                await asyncio.shield(commit_task)
+            except asyncio.CancelledError:
+                cancelled = True
+            except BaseException:
+                break
+        try:
+            commit_task.result()
+        except BaseException:
+            try:
+                await asyncio.shield(self.connection.rollback())
+            except BaseException:
+                pass
+            raise
+        if cancelled:
+            raise asyncio.CancelledError
