+                       int(diagnostics.get("materials_terminal", 0) or 0) > 0 or
+                       int(diagnostics.get("materials_skipped", 0) or 0) > 0)
+        if atoms:
+            return "partial" if has_deferred or has_pending or has_invalid else "ready"
+        if has_invalid and has_pending:
+            return "partial"
+        if has_invalid:
+            return "invalid"
+        if has_deferred:
+            return "deferred"
+        if has_pending:
+            return "pending"
+        return "empty"
+
