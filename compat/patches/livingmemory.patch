+class BoundedRecallSearchContext:
+    """Own pure retrieval routes without retaining request/event objects.
+
+    Callers pass only a retriever method and its query/scope arguments. The
+    request waiter can time out while the global pool keeps any late route
+    result owned; no callback can append it to the request.
+    """
+
+    def __init__(self, pool: "BoundedRecallTaskPool", budget: RecallDeadline, *,
+                 scope: dict, query: str, purpose: str, card_version: str,
+                 correction_revision: int | None, persona_ids: tuple[str, ...],
+                 origin: str, max_parallel: int = 4, _parallel=None,
+                 _metrics=None, hard_deadline: bool = False, embedding_cache=None, local_only=False,
+                 adapter_access_snapshot=_ADAPTER_SNAPSHOT_UNSET):
+        self.pool = pool
+        self.budget = budget
+        self.scope = copy.deepcopy(scope)
+        self.query = str(query)
+        self.purpose = str(purpose)
+        self.card_version = str(card_version)
+        self.correction_revision = correction_revision
+        self.persona_ids = tuple(str(value) for value in persona_ids)
+        self.origin = str(origin)
+        self.hard_deadline = bool(hard_deadline)
+        self.embedding_cache = embedding_cache
+        self.local_only = local_only is True
+        from .memory_scope import current_adapter_access
+        self.adapter_access_snapshot=(current_adapter_access.get()
+            if adapter_access_snapshot is _ADAPTER_SNAPSHOT_UNSET else adapter_access_snapshot)
+        self._parallel = _parallel or asyncio.Semaphore(max(1, min(int(max_parallel), 4)))
+        (self.route_elapsed_ms, self.route_failures,
+         self.route_exception_types) = _metrics or ({}, {}, {})
+
+    def for_scope(self, scope: dict, correction_revision: int | None):
+        """Bind one authorized source scope while sharing this request's bounds."""
+        return BoundedRecallSearchContext(
+            self.pool, self.budget, scope=scope, query=self.query,
+            purpose=self.purpose, card_version=self.card_version,
+            correction_revision=correction_revision, persona_ids=self.persona_ids,
+            origin=self.origin, _parallel=self._parallel,
+            _metrics=(self.route_elapsed_ms, self.route_failures,
+                      self.route_exception_types),
+            hard_deadline=self.hard_deadline, embedding_cache=self.embedding_cache, local_only=self.local_only,
+            adapter_access_snapshot=self.adapter_access_snapshot,
+        )
+
+    def with_deadline(self, deadline: float):
+        """Shorten optional work while preserving the parent's validation budget."""
+        child = self.for_scope(self.scope, self.correction_revision)
+        child.budget = RecallDeadline(self.budget.started_at,
+                                     min(self.budget.search_deadline, deadline), 0.0)
+        return child
+
+    async def run(self, route: str, method: Callable[..., Any], *args,
+                  discriminator: Any = None, **kwargs) -> dict:
+        started = time.monotonic()
+        try:
+            return await self._run(route, method, *args, discriminator=discriminator, **kwargs)
+        except asyncio.CancelledError:
+            self.route_failures[route] = "cancelled"
+            raise
+        finally:
+            self.route_elapsed_ms[route] = self.route_elapsed_ms.get(route, 0) + int(
+                (time.monotonic() - started) * 1000)
+
+    async def _run(self, route: str, method: Callable[..., Any], *args,
+                  discriminator: Any = None, **kwargs) -> dict:
+        started = time.monotonic()
+        if not callable(method):
+            self.route_failures[route] = "unavailable"
+            return {"state": "unavailable", "value": None}
+        key = recall_task_key(
+            route=str(route), scope=self.scope, query=self.query,
+            purpose=self.purpose, card_version=self.card_version,
+            correction_revision=self.correction_revision,
+            persona_ids=self.persona_ids, origin=self.origin,
+            discriminator={"args":discriminator,"hard_deadline":self.hard_deadline,"local_only":self.local_only,
+                           "adapters":getattr(self.adapter_access_snapshot,'adapter_ids',None)},
+        )
+
+        slot_budget = max(0.0, self.budget.search_deadline - time.monotonic())
+        if slot_budget <= 0:
+            self.route_failures[route] = "timeout"
+            return {"state": "timeout", "value": None}
+        acquired = False
+        try:
+            await asyncio.wait_for(self._parallel.acquire(), timeout=slot_budget)
+            acquired = True
+        except asyncio.TimeoutError:
+            self.route_failures[route] = "timeout"
+            return {"state": "timeout", "value": None}
+        finally:
+            self.route_elapsed_ms[route + "_queue"] = self.route_elapsed_ms.get(route + "_queue", 0) + int(
+                (time.monotonic() - started) * 1000)
+        dispatch_started = time.monotonic()
+        async def execute_leaf():
+            work_started = time.monotonic()
+            self.route_elapsed_ms[route + "_dispatch"] = self.route_elapsed_ms.get(route + "_dispatch", 0) + int(
+                (work_started - dispatch_started) * 1000)
+            # The pool intentionally clears ambient ContextVars. Carry only
+            # this request's pure query-vector cache, never req/event objects.
+            from .retrieval.vector_search import query_embeddings
+            from .memory_scope import current_adapter_access
+            adapter_token=current_adapter_access.set(self.adapter_access_snapshot)
+            token = query_embeddings.set(self.embedding_cache) if self.embedding_cache is not None else None
+            try:
+                if self.hard_deadline:
+                    remaining = self.budget.search_deadline - time.monotonic()
+                    if remaining <= 0:
+                        raise TimeoutError("recall_search_deadline")
+                    async with asyncio.timeout(remaining):
+                        return await method(*args, **kwargs)
+                return await method(*args, **kwargs)
+            finally:
+                task = asyncio.current_task()
+                if task is not None:
+                    task._recall_finished_at = time.monotonic()
+                self.route_elapsed_ms[route + "_work"] = self.route_elapsed_ms.get(route + "_work", 0) + int(
+                    (time.monotonic() - work_started) * 1000)
+                if token is not None:
+                    query_embeddings.reset(token)
+                current_adapter_access.reset(adapter_token)
+
+        handle = self.pool.submit(key, execute_leaf, cache_result=False)
+        task = handle.get("task") if isinstance(handle, dict) else None
+        if handle.get("state") == "started" and isinstance(task, asyncio.Task):
+            task.add_done_callback(
+                lambda _completed: self._parallel.release(),
+                context=contextvars.Context(),
+            )
+            acquired = False  # ownership transfers to the pool task
+        elif acquired:
+            self._parallel.release()
+            acquired = False
+        outcome = await self.pool.wait(handle, deadline=self.budget.search_deadline,
+                                       metrics=self.route_elapsed_ms, route=route)
+        if self.hard_deadline and outcome.get("exception_type") == "TimeoutError":
+            outcome = {**outcome, "state": "timeout"}
+        state = str(outcome.get("state", "error"))
+        if state != "completed":
+            self.route_failures[route] = state
+            exception_type = outcome.get("exception_type")
+            if isinstance(exception_type, str):
+                self.route_exception_types[route] = exception_type[:64]
+        return outcome
+
