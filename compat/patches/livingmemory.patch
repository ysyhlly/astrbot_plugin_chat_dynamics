+        persona_filtering = bool(config.get("use_persona_filtering", True)) if isinstance(config, dict) else True
+        read_scopes = await self._native_read_scopes(event, request_scope, persona_id)
+        by_umo = {scope["umo"]: (scope, read_only) for scope, read_only, _ in read_scopes}
