+    async def correct(self, target_id: str, expected_revision: int, action: str,
+                      replacement: str = "", reason: str = "", action_id: str = "") -> dict:
+        return await asyncio.to_thread(self._correct_sync, target_id, expected_revision, action,
+                                       replacement, reason, action_id)
+
+    def _correct_sync(self, target_id: str, expected_revision: int, action: str,
+                      replacement: str, reason: str, action_id: str) -> dict:
+        if action not in {"withdraw", "dispute", "supersede"}:
+            raise ValueError("unsupported correction action")
+        if not target_id or len(target_id) > 160 or not reason.strip() or len(reason) > 500:
+            raise ValueError("target and a bounded correction reason are required")
+        if action == "supersede" and (not replacement.strip() or len(replacement) > 1200):
+            raise ValueError("supersede requires a bounded replacement")
+        now = time.time()
+        cache_update = None
+        with self._lock, self._session() as db:
+            db.execute("BEGIN IMMEDIATE")
