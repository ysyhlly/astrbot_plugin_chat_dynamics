+    def _pause_policy_jobs_sync(self, umo: str, now: float) -> int:
+        with self._lock, self._session() as db:
+            db.execute("BEGIN IMMEDIATE")
+            db.execute("UPDATE evidence_materials SET status='deferred',diagnostics_code='policy_unavailable',"
+                       "updated_at=? WHERE status NOT IN ('ready','invalidated','terminal') "
+                       "AND material_id IN (SELECT material_id FROM evidence_derivation_queue "
+                       "WHERE umo=? AND status IN ('queued','deferred'))", (now, umo))
+            cursor = db.execute("UPDATE evidence_derivation_queue SET status='owner_wait',lease_id='',lease_until=0,updated_at=? "
+                                "WHERE umo=? AND status IN ('queued','deferred')", (now, umo))
+            db.commit()
+            return max(0, int(cursor.rowcount))
