+                     "revision": int(r[6]), "updated_at": float(r[7]),
+                     "correction_revision": int(r[8])} for r in rows]
+
+    async def list_admin_materials(self, limit: int = 100) -> list[dict]:
+        return await asyncio.to_thread(self._list_admin_materials_sync, limit)
+
+    def _list_admin_materials_sync(self, limit: int) -> list[dict]:
