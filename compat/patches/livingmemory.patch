+async def _settle_thread_task(task: asyncio.Task) -> tuple[bool, BaseException | None]:
+    """Wait until a shielded to_thread task really exits despite repeat cancels."""
+    cancellation_seen = False
+    while not task.done():
+        try:
+            await asyncio.shield(task)
+        except asyncio.CancelledError:
+            cancellation_seen = True
+        except BaseException:
+            # The task has completed with an error; collect it below.
+            break
+    try:
+        task.result()
+    except BaseException as exc:
+        return cancellation_seen, exc
+    return cancellation_seen, None
