+        if isinstance(row_id, bool) or not isinstance(row_id, int) or row_id <= 0 or row_id in seen_ids:
+            continue
+        sender_id = data.get("sender_id")
+        if (not isinstance(sender_id, str) or not sender_id.strip() or sender_id == session_id or
+                sender_id.casefold() in {"unknown", "none", "null", "user"}):
+            continue
+        platform = data.get("platform")
+        if not isinstance(platform, str) or not platform.strip():
+            continue
+        content = Message.content_to_text(data.get("content"))
+        if not content:
+            continue
+        try:
+            timestamp = float(data.get("timestamp"))
+        except (TypeError, ValueError):
+            continue
+        if not math.isfinite(timestamp):
+            continue
+        canonical_row = {
+            "id": row_id,
+            "session_id": session_id,
+            "role": "user",
+            "sender_id": sender_id.strip(),
+            "platform": platform.strip(),
+            "timestamp": timestamp,
+            "content": content,
+        }
+        refs.append({
+            "id": row_id,
+            "session_id": session_id,
+            "role": "user",
+            "sender_id": sender_id.strip(),
+            "platform": platform.strip(),
+            "timestamp": timestamp,
+            "content_sha256": hashlib.sha256(content.encode("utf-8")).hexdigest(),
+            "row_hash": conversation_row_hash(canonical_row),
+        })
+        seen_ids.add(row_id)
+    return refs
