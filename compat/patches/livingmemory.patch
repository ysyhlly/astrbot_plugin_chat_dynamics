+    def _mark_material_sync(self, material_id: str, scope_key: str, status: str, diagnostics_code: str) -> None:
+        with self._lock, self._session() as db:
+            if status == "deferred" and diagnostics_code == "bounded_queue":
+                # Capacity deferral is not a model attempt; preserve an older
+                # failure and its retry timestamp.
+                db.execute("UPDATE evidence_materials SET status=CASE WHEN status='failed' THEN 'failed' ELSE 'deferred' END,"
+                           "diagnostics_code=?,updated_at=? WHERE material_id=? AND scope_key=?",
+                           (diagnostics_code[:48], time.time(), material_id, scope_key))
+                db.execute("UPDATE evidence_derivation_queue SET status='deferred',available_at=?,lease_id='',lease_until=0,updated_at=? "
+                           "WHERE material_id=? AND scope_key=?",
+                           (time.time(), time.time(), material_id, scope_key))
+            else:
+                db.execute("UPDATE evidence_materials SET status=?,diagnostics_code=?,updated_at=? WHERE material_id=? AND scope_key=?",
+                           (status, diagnostics_code[:48], time.time(), material_id, scope_key))
+            db.commit()
+
+    async def store_atoms(self, descriptor: dict, atoms: list[dict], lease_id: str | None = None,
+                          now: float | None = None) -> bool:
+        return await asyncio.to_thread(self._store_atoms_sync, descriptor, atoms, lease_id, now)
+
+    def _store_atoms_sync(self, descriptor: dict, atoms: list[dict], lease_id: str | None = None,
+                          now: float | None = None) -> bool:
+        now = time.time() if now is None else float(now)
+        with self._lock, self._session() as db:
+            db.execute("BEGIN IMMEDIATE")
+            if lease_id is not None:
+                lease = db.execute("SELECT 1 FROM evidence_derivation_queue WHERE material_id=? AND scope_key=? "
+                                   "AND status='leased' AND lease_id=? AND lease_until>?",
+                                   (descriptor["material_id"], descriptor["scope_key"], lease_id, now)).fetchone()
+                if not lease:
+                    db.rollback()
+                    return False
+            current = db.execute("SELECT status,text_hash,projection_key FROM evidence_materials "
+                                 "WHERE material_id=? AND scope_key=?",
+                                 (descriptor["material_id"], descriptor["scope_key"])).fetchone()
+            if current and (str(current[0]) == "invalidated" or
+                            str(current[1]) != str(descriptor["text_hash"]) or
+                            str(current[2]) != str(descriptor["projection_key"])):
+                db.rollback()
+                return False
+            revision_row = db.execute("SELECT correction_revision FROM evidence_scope_revisions WHERE scope_key=?",
+                                      (descriptor["scope_key"],)).fetchone()
+            current_revision = int(revision_row[0]) if revision_row else 0
+            if current_revision != int(descriptor.get("correction_revision", 0)):
+                db.execute("UPDATE evidence_materials SET status='deferred',diagnostics_code='revision_changed',updated_at=? "
+                           "WHERE material_id=? AND scope_key=?",
+                           (now, descriptor["material_id"], descriptor["scope_key"]))
+                db.execute("DELETE FROM evidence_derivation_queue WHERE material_id=? AND scope_key=?",
+                           (descriptor["material_id"], descriptor["scope_key"]))
+                db.commit()
+                return False
+            db.execute("""INSERT INTO evidence_materials(
+                material_id,scope_key,material_kind,role,conversation_id,snapshot_fingerprint,
+                source_position,source_family_id,text_hash,projection_key,card_version,status,diagnostics_code,created_at,updated_at
+            ) VALUES (?,?,?,?,?,?,?,?,?,?,?,'ready','',?,?)
+            ON CONFLICT(material_id) DO UPDATE SET status='ready',diagnostics_code='',
+                attempt_count=0,next_attempt_at=0,outcome_code='',updated_at=excluded.updated_at""",
+                (descriptor["material_id"], descriptor["scope_key"], descriptor["material_kind"],
+                 descriptor["role"], descriptor["conversation_id"], descriptor["snapshot_fingerprint"],
+                 int(descriptor["position"]), descriptor.get("source_family_id", ""), descriptor["text_hash"], descriptor["projection_key"],
+                 descriptor["card_version"], now, now),
+            )
+            corrected = db.execute("SELECT a.root_ids_json,a.atom_json,a.root_material_ids_json FROM evidence_atoms a "
+                                   "JOIN evidence_corrections c ON c.target_id=a.atom_id "
+                                   "WHERE a.scope_key=? AND c.action IN ('withdraw','dispute','supersede')",
+                                   (descriptor["scope_key"],)).fetchall()
+            correction_blocklist = []
+            for old in corrected:
+                old_atom = json.loads(old[1])
+                correction_blocklist.append((
+                    str(old_atom.get("kind", "")),
+                    " ".join(str(old_atom.get("claim", "")).casefold().split()),
+                    set(json.loads(old[0])) | set(json.loads(old[2])),
+                ))
+            for atom in atoms:
+                atom_id = atom["atom_id"]
+                root_ids = sorted({str(x) for x in atom.get("root_evidence_ids", [])
+                                   if str(x).startswith("ev1:")})
+                root_material_ids = sorted({str(x) for x in atom.get("root_material_ids", [])
+                                            if str(x).startswith(("mat1:", "leg1:"))})
+                identity_refs = set(root_ids) | set(root_material_ids)
+                claim_key = " ".join(str(atom.get("claim", "")).casefold().split())
+                if any(kind == str(atom.get("kind", "")) and old_claim == claim_key and old_roots == identity_refs
+                       for kind, old_claim, old_roots in correction_blocklist):
+                    atom = dict(atom)
+                    atom["status"] = "invalidated"
+                db.execute("""INSERT INTO evidence_atoms(
+                    atom_id,scope_key,material_id,kind,status,root_ids_json,root_material_ids_json,atom_json,revision,created_at,updated_at
+                ) VALUES (?,?,?,?,?,?,?,?,?,?,?)
+                ON CONFLICT(atom_id) DO UPDATE SET
+                    root_ids_json=excluded.root_ids_json,atom_json=excluded.atom_json,
+                    root_material_ids_json=excluded.root_material_ids_json,
+                    status=CASE WHEN evidence_atoms.status IN ('withdrawn','disputed','superseded','invalidated')
+                                THEN evidence_atoms.status ELSE excluded.status END,
+                    revision=excluded.revision,updated_at=excluded.updated_at""",
+                    (atom_id, descriptor["scope_key"], descriptor["material_id"], atom["kind"],
+                     atom.get("status", "reported_unverified"), _json(root_ids), _json(root_material_ids), _json(atom),
+                     current_revision, now, now),
+                )
+            db.execute("UPDATE evidence_materials SET status='ready',diagnostics_code='',updated_at=? WHERE material_id=?",
+                       (now, descriptor["material_id"]))
+            db.execute("DELETE FROM evidence_derivation_queue WHERE material_id=? AND scope_key=?",
+                       (descriptor["material_id"], descriptor["scope_key"]))
+            db.commit()
+            return True
+
+    async def get_atoms_by_ids(self, scope_key: str, atom_ids: list[str]) -> dict[str, dict]:
+        """Load exact, scope-bound atom rows for the typed evidence-view adapter."""
+        return await self._read(self._get_atoms_by_ids_sync, scope_key, atom_ids)
+
+    def _get_atoms_by_ids_sync(self, scope_key: str, atom_ids: list[str]) -> dict[str, dict]:
+        ids = list(dict.fromkeys(str(value) for value in atom_ids if isinstance(value, str) and value))[:128]
+        if not ids:
+            return {}
+        placeholders = ",".join("?" for _ in ids)
+        with self._read_session() as db:
+            rows = self._read_rows(db, 
+                "SELECT atom_id,material_id,kind,status,root_ids_json,root_material_ids_json,atom_json,revision "
+                f"FROM evidence_atoms WHERE scope_key=? AND atom_id IN ({placeholders})",
+                (scope_key, *ids),
+            )
+        return {
+            str(row[0]): {
+                "atom_id": str(row[0]), "material_id": str(row[1]), "kind": str(row[2]),
+                "status": str(row[3]), "root_evidence_ids": self._read_json(row[4]),
+                "root_material_ids": self._read_json(row[5]), "atom": self._read_json(row[6]),
+                "revision": int(row[7]),
+            }
+            for row in rows
+        }
