+    async def record_material_failure(self, material_id: str, scope_key: str, outcome_code: str,
+                                     lease_id: str | None = None, now: float | None = None,
+                                     admission_spent: bool = False) -> None:
+        await asyncio.to_thread(self._record_material_failure_sync, material_id, scope_key, outcome_code,
+                                 lease_id, now, admission_spent)
+
+    def _record_material_failure_sync(self, material_id: str, scope_key: str, outcome_code: str,
+                                      lease_id: str | None = None, now: float | None = None,
+                                      admission_spent: bool = False) -> None:
+        allowed = {"timeout", "policy_refusal", "policy_unavailable", "transport_failure", "invalid_schema", "cancelled", "provider_unavailable", "source_unavailable"}
+        code = outcome_code if outcome_code in allowed else "transport_failure"
+        now = time.time() if now is None else float(now)
+        with self._lock, self._session() as db:
+            db.execute("BEGIN IMMEDIATE")
+            if lease_id is not None:
+                lease = db.execute("SELECT 1 FROM evidence_derivation_queue WHERE material_id=? AND scope_key=? "
+                                   "AND status='leased' AND lease_id=? AND lease_until>?",
+                                   (material_id, scope_key, lease_id, now)).fetchone()
+                if not lease:
+                    db.rollback()
+                    return
+            row = db.execute("SELECT attempt_count FROM evidence_materials WHERE material_id=? AND scope_key=?",
+                             (material_id, scope_key)).fetchone()
+            if not row:
+                db.commit()
+                return
+            attempts = int(row[0]) + (0 if code in {"cancelled", "provider_unavailable", "policy_unavailable", "source_unavailable"} else 1)
+            if code in {"policy_refusal", "source_unavailable"}:
+                retry_at = 0.0
+            elif code == "cancelled":
+                retry_at = now
+            elif code == "provider_unavailable":
+                retry_at = now + RETRY_DELAYS_SECONDS[0]
+            elif code == "policy_unavailable":
+                retry_at = now + RETRY_DELAYS_SECONDS[0]
+            elif code == "invalid_schema" and attempts >= MAX_INVALID_SCHEMA_ATTEMPTS:
+                retry_at = 0.0
+            else:
+                retry_at = now + RETRY_DELAYS_SECONDS[min(max(attempts - 1, 0), len(RETRY_DELAYS_SECONDS) - 1)]
+            next_status = "deferred" if code in {"cancelled", "provider_unavailable", "policy_unavailable"} else "failed"
+            db.execute("UPDATE evidence_materials SET status=?,attempt_count=?,next_attempt_at=?,"
+                       "outcome_code=?,diagnostics_code=?,updated_at=? WHERE material_id=? AND scope_key=?",
+                       (next_status, attempts, retry_at, code, code, now, material_id, scope_key))
+            terminal = code in {"policy_refusal", "source_unavailable"} or (
+                code == "invalid_schema" and attempts >= MAX_INVALID_SCHEMA_ATTEMPTS
+            )
+            if code == "policy_unavailable" and not admission_spent:
+                db.execute("DELETE FROM evidence_queue_admissions WHERE admission_id=("
+                           "SELECT MAX(admission_id) FROM evidence_queue_admissions "
+                           "WHERE scope_key=? AND material_id=?)", (scope_key, material_id))
+            if terminal:
+                db.execute("DELETE FROM evidence_derivation_queue WHERE material_id=? AND scope_key=?",
+                           (material_id, scope_key))
+            else:
+                db.execute("UPDATE evidence_derivation_queue SET status=?,available_at=?,lease_id='',lease_until=0,updated_at=? "
+                           "WHERE material_id=? AND scope_key=?",
+                           ("queued" if code == "cancelled" else "owner_wait" if code == "policy_unavailable" else "deferred",
+                            retry_at, now, material_id, scope_key))
+            db.commit()
+
+    async def get_materials(self, scope_key: str, material_ids: list[str],
