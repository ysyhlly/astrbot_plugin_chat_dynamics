+
+    async def plan_graph_vector_prune(self):
+        """Build a read-only, exact-ID graph vector prune plan; never apply on startup."""
+        if self._terminating or not self.initializer.is_initialized:
+            raise RuntimeError("LivingMemory is not ready")
+        engine = getattr(self.initializer, "memory_engine", None)
+        planner = getattr(engine, "plan_graph_vector_prune", None) if engine else None
+        if not callable(planner):
+            raise RuntimeError("graph_vector_prune_unavailable")
+        return await planner()
+
+    async def apply_graph_vector_prune(self, plan):
+        """Apply only an explicit plan returned by plan_graph_vector_prune."""
+        if self._terminating or not self.initializer.is_initialized:
+            raise RuntimeError("LivingMemory is not ready")
+        if plan is None:
+            raise ValueError("an explicit graph vector prune plan is required")
+        engine = getattr(self.initializer, "memory_engine", None)
+        apply_plan = getattr(engine, "apply_graph_vector_prune", None) if engine else None
+        if not callable(apply_plan):
+            raise RuntimeError("graph_vector_prune_unavailable")
+        return await apply_plan(plan)
+
+    async def _ready_narrative_baseline(self, scope, query, purpose, card_version,
+                                        correction_revision, *, max_candidates=8):
+        """Collect a bounded set of READY canonical event atoms with fresh archive proof."""
+        scope_keys = ("platform", "umo", "persona_id", "instance_id")
+        expected_scope = {key: scope.get(key) for key in scope_keys} if isinstance(scope, dict) else {}
+        if any(not isinstance(value, str) or not value.strip()
+               for value in expected_scope.values()) or len(expected_scope) != len(scope_keys):
+            return {"source_refs": [], "typed_items": [], "diagnostic": "invalid_scope"}
+        service = getattr(self, "evidence_service", None)
+        if not service:
+            return {"source_refs": [], "typed_items": [], "diagnostic": "unavailable"}
+        revision = service.peek_evidence_revision(scope)
+        if (not isinstance(correction_revision, int) or isinstance(correction_revision, bool) or
+                not revision.get("available") or
+                revision.get("correction_revision") != correction_revision):
+            return {"source_refs": [], "typed_items": [], "diagnostic": "revision_unavailable"}
+        try:
+            entries = await service.list_ready_atoms(scope, limit=100)
+        except asyncio.CancelledError:
+            raise
+        except Exception:
+            return {"source_refs": [], "typed_items": [], "diagnostic": "list_failed"}
+
+        candidates = []
+        material_ids = set()
+        for entry in entries if isinstance(entries, list) else []:
+            atom = entry.get("atom") if isinstance(entry, dict) else None
