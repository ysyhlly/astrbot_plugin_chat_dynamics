+                            job["lease_id"], now=self.clock(),
+                        )
+                        continue
+                    locator = job.get("source_locator", {})
+                    scope = locator.get("scope") if isinstance(locator, dict) else None
+                    revision = self.peek_evidence_revision(scope) if isinstance(scope, dict) else {"available": False}
+                    if (not revision.get("available") or
+                            revision.get("correction_revision") != job.get("correction_revision")):
+                        await self.sidecar.record_material_failure(
+                            job["material_id"], job["scope_key"], "source_unavailable",
+                            job["lease_id"], now=self.clock(),
+                        )
+                        continue
+                    checked = self._normalize(
+                        material, scope, job.get("card_version", ""),
+                        str(locator.get("purpose", "reply")), int(job.get("correction_revision", 0)),
+                    )
+                    if not checked or any(checked[0].get(key) != job.get(key) for key in
+                                          ("material_id", "scope_key", "material_kind", "text_hash", "projection_key")):
+                        await self.sidecar.record_material_failure(
+                            job["material_id"], job["scope_key"], "source_unavailable",
+                            job["lease_id"], now=self.clock(),
+                        )
+                        continue
+                    policy_allowed = await self._material_allowed(job, checked[1])
+                    if policy_allowed is None:
+                        await self.sidecar.record_material_failure(
+                            job["material_id"], job["scope_key"], "policy_unavailable",
+                            job["lease_id"], now=self.clock(),
+                        )
+                        continue
+                    if not policy_allowed:
+                        await self.sidecar.record_material_failure(
+                            job["material_id"], job["scope_key"], "policy_refusal",
+                            job["lease_id"], now=self.clock(),
+                        )
+                        continue
+                    renewed = await self.sidecar.renew_material_lease(
+                        job["material_id"], job["scope_key"], job["lease_id"],
+                        self.clock(), self.lease_seconds,
+                    )
+                    if not renewed:
+                        continue
+                    batch.append((job, checked[1]))
+                if not batch:
+                    continue
+                if not self.derive_callback:
+                    for descriptor, _ in batch:
+                        await self.sidecar.record_material_failure(
+                            descriptor["material_id"], descriptor["scope_key"],
+                            "provider_unavailable", descriptor["lease_id"], now=self.clock(),
+                        )
+                    continue
+                materials = [material for _, material in batch]
+                results = await self._derive_under_leases(batch, materials)
+                if results is None:
+                    # A lease was lost; the new owner will load and process the
+                    # durable source locator. Do not persist stale derivation.
+                    continue
+                if not isinstance(results, dict):
+                    results = {}
+                for descriptor, material in batch:
+                    material_id = descriptor["material_id"]
+                    if material_id not in results:
+                        await self.sidecar.record_material_failure(
+                            material_id, descriptor["scope_key"], "invalid_schema",
+                            descriptor["lease_id"], now=self.clock(),
+                        )
+                        continue
+                    values = results[material_id]
+                    if not isinstance(values, list):
+                        await self.sidecar.record_material_failure(
+                            material_id, descriptor["scope_key"], "invalid_schema",
+                            descriptor["lease_id"], now=self.clock(),
+                        )
+                        continue
+                    commit_material = material
+                    if self.material_loader:
+                        try:
+                            latest = await self.material_loader(descriptor)
+                        except asyncio.CancelledError:
+                            raise
+                        except Exception:
+                            latest = None
+                        locator = descriptor.get("source_locator", {})
+                        scope = locator.get("scope") if isinstance(locator, dict) else None
+                        checked_latest = self._normalize(
+                            latest, scope, descriptor.get("card_version", ""),
+                            str(locator.get("purpose", "reply")),
+                            int(descriptor.get("correction_revision", 0)),
+                        ) if isinstance(latest, dict) else None
+                        if not checked_latest or any(checked_latest[0].get(key) != descriptor.get(key) for key in
+                                                     ("material_id", "scope_key", "material_kind", "text_hash", "projection_key")):
+                            await self.sidecar.record_material_failure(
+                                material_id, descriptor["scope_key"], "source_unavailable",
+                                descriptor["lease_id"], now=self.clock(),
+                            )
+                            continue
+                        commit_material = checked_latest[1]
+                    valid = self._validated_atoms(descriptor, commit_material, values)
+                    candidate_values = values[:12]
+                    if candidate_values and len(valid) != len(candidate_values):
+                        await self.sidecar.record_material_failure(
+                            material_id, descriptor["scope_key"], "invalid_schema",
+                            descriptor["lease_id"], now=self.clock(),
+                        )
+                        continue
+                    policy_allowed = await self._material_allowed(descriptor, commit_material)
+                    if policy_allowed is None:
+                        await self.sidecar.record_material_failure(
+                            material_id, descriptor["scope_key"], "policy_unavailable",
+                            descriptor["lease_id"], now=self.clock(), admission_spent=True,
+                        )
+                        continue
+                    if not policy_allowed:
+                        await self.sidecar.record_material_failure(
+                            material_id, descriptor["scope_key"], "policy_refusal",
+                            descriptor["lease_id"], now=self.clock(),
+                        )
+                        continue
+                    await self.sidecar.store_atoms(descriptor, valid, descriptor["lease_id"], now=self.clock())
+            except asyncio.CancelledError:
+                releases = [asyncio.create_task(self.sidecar.release_material_lease(
+                    descriptor["material_id"], descriptor["scope_key"],
+                    descriptor["lease_id"], self.clock(),
+                )) for descriptor in jobs]
+                if releases:
+                    release_group = asyncio.gather(*releases, return_exceptions=True)
+                    while not release_group.done():
+                        try:
+                            await asyncio.shield(release_group)
+                        except asyncio.CancelledError:
+                            continue
+                raise
+            except Exception as exc:
+                outcome = self._failure_outcome(exc)
+                for descriptor in jobs:
+                    await self.sidecar.record_material_failure(
+                        descriptor["material_id"], descriptor["scope_key"], outcome,
+                        descriptor["lease_id"], now=self.clock(),
+                    )
+            finally:
+                self._wakeup.set()
