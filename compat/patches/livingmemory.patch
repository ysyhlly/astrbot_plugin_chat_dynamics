+                       "purpose": "reply", "card_version": str(receipt.get("card_version", ""))[:256],
+                       "source_views": [], "diagnostics": {"source_text_logged": False}}
+            setattr(req, NATIVE_MEMORY_REQUEST_KEY, request)
+        if request.get("request_scope") != request_scope:
+            return False
