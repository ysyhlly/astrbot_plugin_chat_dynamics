+            locator = descriptor.get("source_locator")
+            if isinstance(locator, dict):
+                if locator.get("scope_key") != scope_id or locator.get("kind") != "event":
+                    descriptor["source_locator"] = None
+                else:
+                    descriptor["source_locator"] = {**locator, "scope": dict(current_scope)}
+            result[material_id] = descriptor
+        return result
+
+    def peek_evidence_revision(self, scope: dict) -> dict:
+        if self._stopping or not self.sidecar._ready:
+            return {"schema_version": 1, "available": False, "scope_key": "",
+                    "correction_revision": None, "revocations": []}
+        try:
+            key = self.scope_key_fn(scope)
+        except Exception:
+            return {"schema_version": 1, "available": False, "scope_key": "",
+                    "correction_revision": None, "revocations": []}
+        return self.sidecar.peek_evidence_revision(key)
+
+    async def queue_material_derivation(self, materials: list[dict], *, scope: dict | None = None,
+                                        purpose: str = "reply", card_version: str = "") -> dict:
+        if purpose not in PURPOSES or not isinstance(materials, list):
+            return {"schema_version": 1, "accepted": False, "queued": 0,
+                    "deferred": 0, "duplicates": 0, "skipped": 0, "material_ids": []}
+        if not materials:
+            return {"schema_version": 1, "accepted": False, "queued": 0,
+                    "deferred": 0, "duplicates": 0, "skipped": 0,
+                    "available": True, "material_ids": []}
+        if not self.derive_callback or self._stopping or not self._worker or self._worker.done():
+            return {"schema_version": 1, "accepted": False, "queued": 0,
+                    "deferred": 0, "duplicates": 0, "skipped": 0,
+                    "available": False, "material_ids": []}
+        accepted = 0
+        deferred = 0
+        duplicates = 0
+        terminal = 0
+        skipped = 0
+        ids: list[str] = []
+        revision = self.peek_evidence_revision(scope) if isinstance(scope, dict) else {"available": False}
+        if not revision.get("available") or not isinstance(revision.get("correction_revision"), int):
+            return {"schema_version": 1, "accepted": False, "queued": 0, "deferred": 0,
+                    "duplicates": 0, "skipped": min(len(materials), MAX_MATERIALS),
+                    "material_ids": [], "available": False}
+        correction_revision = revision["correction_revision"]
+        for raw in materials[:MAX_MATERIALS]:
+            prepared = self._normalize(raw, scope, card_version, purpose, correction_revision)
+            if not prepared:
+                skipped += 1
+                continue
+            descriptor, material = prepared
+            material_id = descriptor["material_id"]
+            ids.append(material_id)
+            if await self.sidecar.has_ready_family(descriptor):
+                duplicates += 1
+                continue
+            try:
+                cache_status = await self.sidecar.upsert_material(descriptor)
+            except Exception:
+                skipped += 1
+                continue
+            if cache_status == "ready":
+                duplicates += 1
+                continue
+            owner_ready = True
+            if self.owner_readiness:
+                source_scope = descriptor.get("source_locator", {}).get("scope", {})
+                try:
+                    owner_ready = await self.owner_readiness(str(source_scope.get("umo", ""))) is True
+                except asyncio.CancelledError:
+                    raise
+                except Exception:
+                    owner_ready = False
+            outcome = await self.sidecar.admit_material_job(
+                descriptor, now=self.clock(), queue_size=self.queue_size,
+                owner_ready=owner_ready,
+            )
+            if outcome == "queued":
+                accepted += 1
+                self._volatile_materials[material_id] = material
+            elif outcome == "deferred":
+                deferred += 1
+            elif outcome == "owner_wait":
+                deferred += 1
+                self._volatile_materials[material_id] = material
+            elif outcome == "duplicate":
+                duplicates += 1
+            elif outcome == "terminal":
+                terminal += 1
+            else:
+                skipped += 1
+        if accepted or deferred:
+            self._wakeup.set()
+        return {"schema_version": 1, "accepted": accepted + deferred > 0,
+                "queued": accepted, "deferred": deferred,
+                "duplicates": duplicates, "terminal": terminal,
+                "skipped": skipped, "material_ids": ids}
+
+    async def get_evidence_view(self, scope: dict, source_refs: list[dict] | None = None,
+                                purpose: str = "reply", card_version: str = "",
+                                conversation_id: str | None = None,
+                                snapshot_fingerprint: str | None = None,
+                                materials: list[dict] | None = None,
+                                typed_items: list[dict] | None = None,
+                                allow_derivation: bool = True) -> dict:
+        """Read only ready cache, enqueue misses, and return a bounded immutable projection."""
+        if purpose not in PURPOSES:
+            return self._empty_view("invalid_purpose", purpose, card_version)
+        try:
+            scope_id = self.scope_key_fn(scope)
+        except Exception:
+            return self._empty_view("invalid_scope", purpose)
+        revision = self.sidecar.peek_evidence_revision(scope_id)
+        if not revision.get("available"):
+            return self._empty_view("revision_unavailable", purpose)
+        rows = []
+        for row in (source_refs or [])[:MAX_MATERIALS]:
+            if isinstance(row, dict):
+                copy_row = dict(row)
+                if conversation_id and not copy_row.get("conversation_id"):
+                    copy_row["conversation_id"] = conversation_id
+                if snapshot_fingerprint and not copy_row.get("snapshot_fingerprint"):
+                    copy_row["snapshot_fingerprint"] = snapshot_fingerprint
+                rows.append(copy_row)
+        if materials:
+            rows.extend(dict(row) for row in materials[:max(0, MAX_MATERIALS - len(rows))] if isinstance(row, dict))
+        prepared = []
+        missing_identity = 0
+        invalid_refs = 0
+        for raw in rows[:MAX_MATERIALS]:
+            item = self._normalize(raw, scope, card_version, purpose, revision["correction_revision"])
+            if item is None:
+                if raw.get("source_kind", raw.get("material_kind", "host_history")) == "host_history" and (
+                    not raw.get("conversation_id", conversation_id) or
+                    not raw.get("snapshot_fingerprint", snapshot_fingerprint)
+                ):
+                    missing_identity += 1
+                else:
+                    invalid_refs += 1
+                continue
+            prepared.append(item)
+        material_ids = [desc["material_id"] for desc, _ in prepared]
+        revoked_ids = {str(row.get("target_id")) for row in revision["revocations"]}
+        invalidated_atom_ids = set()
+        for row in revision["revocations"]:
+            revoked_ids.update(str(value) for value in row.get("affected_ids", []))
+            affected = {str(value) for value in row.get("affected_ids", [])}
+            replacement_id = str(row.get("replacement_atom_id") or "")
+            affected.discard(replacement_id)
+            invalidated_atom_ids.update(affected)
+            if row.get("action") in {"withdraw", "dispute", "supersede"}:
+                invalidated_atom_ids.add(str(row.get("target_id")))
+        typed_rows = [row for row in (typed_items or [])[:MAX_MATERIALS] if isinstance(row, dict)]
+        typed_ids = [row.get("source_id") for row in typed_rows
+                     if row.get("item_kind") == "evidence_atom" and isinstance(row.get("source_id"), str)]
+        stored_typed = await self.sidecar.get_atoms_by_ids(scope_id, typed_ids)
+        typed_atoms = []
+        typed_atom_ids: set[str] = set()
+        atom_revisions: dict[str, int] = {}
+        typed_rejected = 0
+        typed_seen = set()
+        for raw in typed_rows:
+            atom_id_value = raw.get("source_id")
+            valid = (
+                raw.get("item_kind") == "evidence_atom" and
+                raw.get("evidence_schema_version") == 1 and
+                isinstance(atom_id_value, str) and atom_id_value.startswith("atm1:") and
+                atom_id_value not in typed_seen and
+                isinstance(raw.get("scope"), dict) and
+                isinstance(raw.get("correction_revision"), int) and
+                not isinstance(raw.get("correction_revision"), bool) and
+                raw.get("correction_revision") == revision["correction_revision"] and
+                raw.get("scope_key") == scope_id
+            )
+            if valid:
+                try:
+                    valid = self.scope_key_fn(raw["scope"]) == scope_id
+                except Exception:
+                    valid = False
+            stored = stored_typed.get(atom_id_value) if valid else None
+            if not stored or stored.get("status") not in PUBLIC_ATOM_STATUSES:
+                valid = False
+            if valid:
+                atom = stored.get("atom", {})
+                canonical_roots = sorted({str(value) for value in stored.get("root_evidence_ids", [])})
+                canonical_material_roots = sorted({str(value) for value in stored.get("root_material_ids", [])})
+                raw_roots = raw.get("root_evidence_ids")
+                raw_material_roots = raw.get("root_material_ids")
+                valid = (
+                    atom_id_value not in invalidated_atom_ids and
+                    bool(canonical_roots or canonical_material_roots) and
+                    isinstance(raw_roots, list) and
+                    sorted({str(value) for value in raw_roots}) == canonical_roots and
+                    isinstance(raw_material_roots, list) and
+                    sorted({str(value) for value in raw_material_roots}) == canonical_material_roots and
+                    not (set(canonical_roots) & revoked_ids) and
+                    not (set(canonical_material_roots) & revoked_ids) and
+                    (not isinstance(atom, dict) or atom.get("atom_id", atom_id_value) == atom_id_value)
+                )
+                if valid:
+                    typed_atoms.append(self._public_atom(atom, stored["status"]))
+                    atom_revisions[atom_id_value] = int(stored.get("revision", 0))
+                    if atom.get("source_status") == "exact_event" or any(
+                        isinstance(ref, dict) and ref.get("source_event_id")
+                        for ref in atom.get("source_refs", [])
+                    ):
+                        typed_atom_ids.add(atom_id_value)
+                    typed_seen.add(atom_id_value)
+            if not valid:
+                typed_rejected += 1
+        family_ids = [desc.get("source_family_id", "") for desc, _ in prepared if desc.get("source_family_id")]
+        cache_rows = await self.sidecar.get_materials(scope_id, material_ids, family_ids)
+        cache = {}
+        for descriptor, _ in prepared:
+            material_id = descriptor["material_id"]
+            direct = cache_rows.get(material_id)
+            if direct and direct.get("text_hash") == descriptor["text_hash"] and direct.get("projection_key") == descriptor["projection_key"]:
+                cache[material_id] = direct
+                continue
+            family_id = descriptor.get("source_family_id", "")
+            if family_id:
+                candidates = [row for row in cache_rows.values()
+                              if row.get("source_family_id") == family_id and
+                              row.get("text_hash") == descriptor["text_hash"] and
+                              row.get("projection_key") == descriptor["projection_key"] and
+                              row.get("status") == "ready"]
+                if candidates:
+                    cache[material_id] = max(candidates, key=lambda row: row.get("material_id", ""))
+        # 先查缓存、再只对「未 ready」的 material 排队派生。
+        # 原实现先对全部 prepared 排队、之后才读缓存：每个 material 会依次走
+        # has_ready_family + upsert_material + admit_material_job，而每次 sidecar 调用
+        # 都要等锁并新建一个 sqlite 连接；已 ready 的 material 本会被判为 duplicates。
+        # 生产实测该循环主导了 get_evidence_view 的 4~9s（最多 64 个 material × 3 次调用）。
+        # 返回值原本未被任何调用方使用，故此处无需保留计数结果。
+        queueable = [(desc, material) for desc, material in prepared
+                     if desc["material_id"] not in revoked_ids
+                     and desc.get("source_family_id", "") not in revoked_ids
+                     and desc["material_id"] not in cache]
+        queued = (
+            self._defer_admissions(queueable, scope, purpose, card_version)
+            if allow_derivation and queueable
+            else {"queued": 0, "deferred": 0, "skipped": 0,
+                  "accepted": False, "available": True}
+        )
+        atoms = list(typed_atoms)
+        history_projection = {}
+        pending_count = 0
+        omitted_count = 0
+        cached_count = 0
+        for descriptor, material in prepared:
+            material_id = descriptor["material_id"]
+            cached = cache.get(material_id, {"status": "queued", "atoms": []})
+            role = descriptor["role"]
+            active_for_material = []
+            for entry in cached.get("atoms", []):
+                atom = entry["atom"]
+                if entry["atom_id"] in invalidated_atom_ids:
+                    continue
+                if entry["status"] not in PUBLIC_ATOM_STATUSES:
+                    continue
+                roots = sorted({str(x) for x in atom.get("root_evidence_ids", [])})
+                material_roots = sorted({str(x) for x in atom.get("root_material_ids", [])})
+                if not roots and not material_roots:
+                    continue
+                if any(root in {r.get("target_id") for r in revision["revocations"]}
+                       for root in roots):
+                    continue
+                # This record is deliberately bounded and source-attributed.
+                public_atom = self._public_atom(atom, entry["status"])
+                atoms.append(public_atom)
+                atom_revisions[public_atom["atom_id"]] = int(entry.get("revision", 0))
+                active_for_material.append(public_atom["atom_id"])
+            if descriptor["material_kind"] != "host_record_only":
+                if cached.get("status") == "ready":
+                    cached_count += 1
+                elif descriptor["material_kind"] == "legacy_summary":
+                    omitted_count += 1
+                else:
+                    pending_count += 1
+                continue
+            if role == "assistant" and (material_id in revoked_ids or descriptor.get("source_family_id", "") in revoked_ids):
+                omitted_count += 1
+                history_projection[material_id] = {
+                    "material_id": material_id, "source_position": descriptor["position"],
+                    "source_role": role, "text_hash": descriptor["text_hash"],
+                    "projection_status": "admin_corrected_omitted",
+                    "preserve_as_historical_data": False, "spans": [], "atom_ids": [],
+                    "source_status": descriptor["material_kind"],
+                }
+                continue
+            if cached.get("status") == "ready":
+                cached_count += 1
+                projection = {
+                    "material_id": material_id, "source_position": descriptor["position"],
+                    "source_role": role, "text_hash": descriptor["text_hash"],
+                    "projection_status": "historical_data_preserved" if role == "user" else
+                                         "historical_claims_only" if role == "summary" and active_for_material else
+                                         "derived_no_claim" if role == "summary" else
+                                         "atoms_only" if active_for_material else "derived_no_continuity",
+                    "preserve_as_historical_data": role == "user", "spans": [],
+                    "atom_ids": sorted(set(active_for_material)),
+                    "source_status": descriptor["material_kind"],
+                }
+            elif role == "user":
+                pending_count += 1
+                projection = {
+                    "material_id": material_id, "source_position": descriptor["position"],
+                    "source_role": role, "text_hash": descriptor["text_hash"],
+                    "projection_status": "historical_data_preserved_pending_derivation",
+                    "preserve_as_historical_data": True, "spans": [], "atom_ids": [],
+                    "source_status": descriptor["material_kind"],
+                }
+            elif role == "summary":
+                omitted_count += 1
+                projection = {
+                    "material_id": material_id, "source_position": descriptor["position"],
+                    "source_role": role, "text_hash": descriptor["text_hash"],
+                    "projection_status": "legacy_summary_unparsed",
+                    "preserve_as_historical_data": False, "spans": [], "atom_ids": [],
+                    "source_status": "legacy_summary",
+                }
+            else:
+                spans = pending_continuity_spans(material["text"])
+                if spans:
+                    pending_count += 1
+                    projection_status = "degraded_pending_continuity"
+                else:
+                    omitted_count += 1
+                    projection_status = "omitted_unclassified"
+                projection = {
+                    "material_id": material_id, "source_position": descriptor["position"],
+                    "source_role": role, "text_hash": descriptor["text_hash"],
+                    "projection_status": projection_status,
+                    "preserve_as_historical_data": False, "spans": spans, "atom_ids": [],
+                    "source_status": descriptor["material_kind"],
+                }
+            history_projection[material_id] = projection
+        restored, invalid_event_atoms = await self._restore_event_provenance(
+            atoms, atom_revisions, scope, scope_id, revision["correction_revision"],
+            revoked_ids, invalidated_atom_ids, prepared,
+        )
+        if invalid_event_atoms:
+            typed_rejected += len(invalid_event_atoms & typed_atom_ids)
+            atoms = [atom for atom in atoms if atom.get("atom_id") not in invalid_event_atoms]
+            typed_atoms = [atom for atom in typed_atoms if atom.get("atom_id") not in invalid_event_atoms]
+        deduped_atoms = self._dedupe_atoms(atoms)
+        slots = self._slots(deduped_atoms)
+        fallback_span_count = sum(len(row.get("spans", [])) for row in history_projection.values())
+        policy_unavailable_count = sum(
+            1 for row in cache_rows.values()
+            if row.get("diagnostics_code") == "policy_unavailable"
+        )
+        diagnostics = {
+            "materials_total": len(prepared), "materials_cached": cached_count,
+            "materials_queued": int(queued.get("queued", 0)), "materials_pending": pending_count,
+            "materials_admission_pending": int(queued.get('admission_pending', 0)),
+            "materials_terminal": int(queued.get("terminal", 0)),
+            "materials_skipped": int(queued.get("skipped", 0)),
+            "derivation_available": queued.get("available", True) is not False,
+            "materials_omitted_unclassified": omitted_count,
+            "materials_missing_snapshot_identity": missing_identity,
+            "source_refs_rejected": invalid_refs,
+            "typed_items_total": len(typed_rows),
+            "typed_items_accepted": len(typed_atoms),
+            "source_authors_restored": restored,
+            "typed_items_rejected": typed_rejected,
+            "materials_deferred": int(queued.get("deferred", 0)),
+            "policy_unavailable": policy_unavailable_count,
+            "fallback_spans_returned": fallback_span_count,
+            "source_text_logged": False, "raw_source_returned": False,
+            "projection_version": "evidence-view-v1", "purpose": purpose,
+        }
+        view = {"schema_version": 1, "available": True, "scope_key": scope_id,
+                "correction_revision": revision["correction_revision"],
+                "revocations": revision["revocations"], "purpose": purpose,
+                "card_version": str(card_version)[:256], "slots": slots,
+                "atoms": deduped_atoms, "history_projection": history_projection,
+                "diagnostics": diagnostics}
+        view["evidence_status"] = self._evidence_status(view)
+        return view
+
+    async def correct_insight(self, target_id: str, expected_revision: int, action: str,
+                              replacement: str = "", reason: str = "", action_id: str = "") -> dict:
+        return await self.sidecar.correct(target_id, expected_revision, action,
+                                          replacement, reason, action_id)
+
+    async def list_admin_insights(self, scope: dict, limit: int = 100) -> dict:
+        try:
+            scope_id = self.scope_key_fn(scope)
+        except Exception:
+            return {"schema_version": 1, "available": False, "items": []}
+        rows = await self.sidecar.list_atoms(scope_id, limit)
+        # Admin diagnostics expose identifiers and provenance labels, never source text.
+        items = [{"atom_id": row["atom_id"], "kind": row["kind"], "status": row["status"],
+                  "revision": row["revision"], "source_count": len(row["atom"].get("root_evidence_ids", [])),
+                  "material_count": len(row["atom"].get("root_material_ids", [])),
+                  "source_kinds": sorted({ref.get("source_status", "unknown")
+                                           for ref in row["atom"].get("source_refs", []) if isinstance(ref, dict)})}
+                 for row in rows]
+        rev = self.sidecar.peek_evidence_revision(scope_id)
+        return {"schema_version": 1, "available": True, "scope_key": scope_id,
+                "correction_revision": rev["correction_revision"], "items": items}
+
+    async def list_admin_insights_global(self, limit: int = 100) -> dict:
+        rows = await self.sidecar.list_admin_atoms(limit)
+        materials = await self.sidecar.list_admin_materials(limit)
+        # Do not expose claim text, original source text, reasons, or provider data.
+        return {"schema_version": 1, "available": True,
+                "items": [
+                    *[{"atom_id": row["atom_id"], "scope_key": row["scope_key"],
+                       "kind": row["kind"], "status": row["status"],
+                       "source_count": row["source_count"], "revision": row["revision"],
+                       "correction_revision": row["correction_revision"],
+                       "updated_at": row["updated_at"]} for row in rows],
+                    *[{"atom_id": row["material_id"], "scope_key": row["scope_key"],
+                       "kind": "material:" + row["material_kind"], "status": row["status"],
+                       "attempt_count": row["attempt_count"],
+                       "next_attempt_at": row["next_attempt_at"],
+                       "outcome_code": row["outcome_code"],
+                       "source_count": 0, "revision": 0,
+                       "correction_revision": row["correction_revision"],
+                       "updated_at": row["updated_at"]} for row in materials],
+                ]}
+
+    def _normalize(self, raw: dict, scope: dict | None, card_version: str, purpose: str,
+                   revision: int = 0):
+        if not isinstance(scope, dict):
+            return None
+        try:
+            scope_id = self.scope_key_fn(scope)
+        except Exception:
+            return None
+        prepared = normalize_host_material(scope_id, raw, conversation_id=str(raw.get("conversation_id", "")),
+                                           snapshot_fingerprint=str(raw.get("snapshot_fingerprint", "")),
+                                           card_version=card_version, correction_revision=revision, purpose=purpose)
+        if not prepared:
+            prepared = normalize_event_material(scope_id, scope, raw, card_version=card_version,
+                                                correction_revision=revision, purpose=purpose)
+        if not prepared:
+            prepared = normalize_legacy_summary(scope_id, raw, card_version=card_version,
+                                                correction_revision=revision, purpose=purpose)
+        if not prepared and raw.get("source_kind") == "conversation_row":
+            prepared = normalize_conversation_row(
+                scope_id, scope, raw, source_memory_id=raw.get("source_memory_id"),
+                card_version=card_version, correction_revision=revision, purpose=purpose,
+            )
+        if prepared:
+            descriptor, material = prepared
+            locator = dict(descriptor.get("source_locator", {}))
+            locator["scope"] = {key: str(scope.get(key, "")) for key in
+                                 ("platform", "umo", "persona_id", "instance_id")}
+            descriptor["source_locator"] = locator
+            material["source_locator"] = locator
+        return prepared
+
+    async def _worker_loop(self):
+        while not self._stopping:
+            if self.owner_readiness:
+                try:
+                    umos = await self.sidecar.due_policy_umos(self.clock())
+                except Exception:
+                    umos = []
+                for umo in umos:
+                    try:
+                        owner_ready = await self.owner_readiness(umo)
+                    except asyncio.CancelledError:
+                        raise
+                    except Exception:
+                        owner_ready = None
+                    if owner_ready is not True:
+                        await self.sidecar.pause_policy_jobs(umo, self.clock())
+            jobs = await self.sidecar.claim_due_materials(
+                now=self.clock(), queue_size=self.queue_size,
+                per_scope_hourly_limit=self.per_scope_hourly_limit,
+                lease_seconds=self.lease_seconds, batch_size=4,
+            )
+            if not jobs:
+                self._wakeup.clear()
+                try:
+                    await asyncio.wait_for(self._wakeup.wait(), timeout=self.scheduler_poll_seconds)
+                except asyncio.TimeoutError:
+                    pass
+                continue
+            try:
+                batch = []
+                for job in jobs:
+                    volatile_material = self._volatile_materials.pop(job["material_id"], None)
+                    try:
+                        # Re-read authoritative source state even for jobs first
+                        # admitted in this process; volatile payloads are only a
+                        # fallback for isolated users without a loader.
+                        locator = job.get("source_locator", {})
+                        if locator.get("kind") == "conversation_row":
+                            material = (await self.conversation_row_loader(job)
+                                        if self.conversation_row_loader else None)
+                        elif self.material_loader:
+                            material = await self.material_loader(job)
+                        else:
+                            material = volatile_material
+                    except asyncio.CancelledError:
+                        raise
+                    except Exception as exc:
+                        await self.sidecar.record_material_failure(
+                            job["material_id"], job["scope_key"], self._failure_outcome(exc),
+                            job["lease_id"], now=self.clock(),
+                        )
+                        continue
+                    if not isinstance(material, dict):
+                        await self.sidecar.record_material_failure(
