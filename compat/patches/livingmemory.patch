+    async def material_retry_state(self, material_id: str, scope_key: str) -> dict:
+        return await asyncio.to_thread(self._material_retry_state_sync, material_id, scope_key)
+
+    def _material_retry_state_sync(self, material_id: str, scope_key: str) -> dict:
+        with self._lock, self._session() as db:
+            row = db.execute(
+                "SELECT status,attempt_count,next_attempt_at,outcome_code FROM evidence_materials "
+                "WHERE material_id=? AND scope_key=?", (material_id, scope_key)
+            ).fetchone()
+        if not row:
+            return {"status": "missing", "attempt_count": 0, "next_attempt_at": 0.0,
+                    "outcome_code": ""}
+        return {"status": str(row[0]), "attempt_count": int(row[1]),
+                "next_attempt_at": float(row[2]), "outcome_code": str(row[3])}
+
+    async def material_retry_due(self, material_id: str, scope_key: str, now: float | None = None) -> bool:
+        state = await self.material_retry_state(material_id, scope_key)
+        status, outcome = state["status"], state["outcome_code"]
+        if status in {"ready", "invalidated", "terminal"} or outcome in {"policy_refusal", "source_unavailable"}:
+            return False
+        if outcome == "invalid_schema" and state["attempt_count"] >= MAX_INVALID_SCHEMA_ATTEMPTS:
+            return False
+        if status == "deferred" and outcome == "bounded_queue":
+            return True
+        now_value = time.time() if now is None else now
+        return status in {"queued", "failed", "deferred"} and state["next_attempt_at"] <= now_value
