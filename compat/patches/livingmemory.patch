+    def _backup_before_schema_upgrade(self) -> None:
+        if not self.path.is_file() or self.path.stat().st_size == 0:
+            return
+        uri = self.path.resolve().as_uri() + "?mode=ro"
+        try:
+            with sqlite3.connect(uri, uri=True, timeout=2) as source:
+                tables = {row[0] for row in source.execute(
+                    "SELECT name FROM sqlite_master WHERE type='table'").fetchall()}
+                current = None
+                if "evidence_schema" in tables:
+                    row = source.execute("SELECT schema_version FROM evidence_schema WHERE singleton=1").fetchone()
+                    current = int(row[0]) if row else 0
+                material_columns = set()
+                if "evidence_materials" in tables:
+                    material_columns = {str(row[1]) for row in source.execute(
+                        "PRAGMA table_info(evidence_materials)").fetchall()}
+                marker_columns = set()
+                marker_version = 0
+                if "evidence_schema" in tables:
+                    marker_columns = {str(row[1]) for row in source.execute(
+                        "PRAGMA table_info(evidence_schema)").fetchall()}
+                    if "retry_extension_version" in marker_columns:
+                        marker = source.execute(
+                            "SELECT retry_extension_version FROM evidence_schema WHERE singleton=1"
+                        ).fetchone()
+                        marker_version = int(marker[0]) if marker else 0
+                columns_valid = self._retry_extension_contract_from_columns(source, material_columns)
+                if (current is not None and current >= SCHEMA_VERSION and columns_valid and
+                        "retry_extension_version" in marker_columns and
+                        marker_version >= RETRY_EXTENSION_VERSION):
+                    return
+                suffix = "none" if current is None else str(current)
+                stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
+                backup_path = self.path.with_name(f"{self.path.name}.schema-v{suffix}-{stamp}.bak")
+                if backup_path.exists():
+                    raise RuntimeError("Evidence sidecar migration backup already exists")
+                with sqlite3.connect(str(backup_path), timeout=2) as backup:
+                    source.backup(backup)
+                    if backup.execute("PRAGMA quick_check").fetchone()[0] != "ok":
+                        backup.close()
+                        backup_path.unlink(missing_ok=True)
+                        raise RuntimeError("Evidence sidecar migration backup failed validation")
+        except sqlite3.DatabaseError:
+            raise RuntimeError("Existing evidence sidecar is not a readable SQLite database") from None
+
+    @staticmethod
+    def _retry_extension_contract_from_columns(connection, material_columns: set[str]) -> bool:
+        expected = {
+            "attempt_count": ("INTEGER", 1, "0"),
+            "next_attempt_at": ("REAL", 1, "0"),
+            "outcome_code": ("TEXT", 1, "''"),
+        }
+        info = {str(row[1]): row for row in connection.execute("PRAGMA table_info(evidence_materials)")}
+        if not set(expected) <= material_columns:
+            return False
+        for name, (column_type, not_null, default) in expected.items():
+            row = info.get(name)
+            if (row is None or str(row[2]).upper() != column_type or int(row[3]) != not_null or
+                    str(row[4]) != default):
+                return False
+        schema_info = {str(row[1]): row for row in connection.execute("PRAGMA table_info(evidence_schema)")}
+        marker = schema_info.get("retry_extension_version")
+        return bool(marker and str(marker[2]).upper() == "INTEGER" and int(marker[3]) == 1 and str(marker[4]) == "0")
+
+    @classmethod
+    def _retry_extension_columns_valid(cls, db) -> bool:
+        columns = {str(row[1]) for row in db.execute("PRAGMA table_info(evidence_materials)")}
+        return cls._retry_extension_contract_from_columns(db, columns)
+
+    def _load_revision_cache(self, db) -> None:
+        values: dict[str, dict] = {}
+        for row in db.execute("SELECT scope_key,correction_revision FROM evidence_scope_revisions"):
+            scope_key = str(row[0])
+            values[scope_key] = self._revision_projection(db, scope_key, int(row[1]))
+        with self._revision_lock:
+            self._revision_cache = values
+
+    def _revision_projection(self, db, scope_key: str, revision: int) -> dict:
+        rows = db.execute(
+            "SELECT correction_revision,target_id,action,replacement_atom_id,affected_ids_json "
+            "FROM evidence_corrections WHERE scope_key=? ORDER BY correction_revision DESC",
+            (scope_key,),
+        ).fetchall()
+        revocations = []
+        for row in rows:
+            revocations.append({
+                "revision": int(row[0]), "target_id": str(row[1]), "action": str(row[2]),
+                "replacement_atom_id": row[3], "affected_ids": json.loads(row[4]),
+            })
+        return {"schema_version": 1, "available": True, "scope_key": scope_key,
+                "correction_revision": revision, "revocations": revocations}
+
+    def peek_evidence_revision(self, scope_key: str) -> dict:
+        unavailable = {"schema_version": 1, "available": False, "scope_key": scope_key,
+                       "correction_revision": None, "revocations": []}
+        # A correction commit and cache publication form one critical section.
+        # Fail closed during it instead of blocking the event loop or exposing
+        # the pre-correction revision after a durable correction has committed.
+        if not self._revision_lock.acquire(blocking=False):
+            return unavailable
+        try:
+            if not self._ready:
+                return unavailable
+            value = self._revision_cache.get(scope_key, {
+                "schema_version": 1, "available": True, "scope_key": scope_key,
+                "correction_revision": 0, "revocations": [],
+            })
+            return copy.deepcopy(value)
+        finally:
+            self._revision_lock.release()
+
