+    @staticmethod
+    def _native_receipt_identity(receipt):
+        if not isinstance(receipt, dict):
+            return None
+        return {
+            key: request_identity(receipt.get(key))
+            for key in ("schema_version", "provider", "scope", "purpose", "card_version",
+                        "conversation_id", "snapshot_fingerprint")
+        }
