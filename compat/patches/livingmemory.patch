+    async def claim_due_materials(self, now: float, queue_size: int = 128,
+                                  per_scope_hourly_limit: int = 24, lease_seconds: float = 120,
+                                  batch_size: int = 4) -> list[dict]:
+        return await asyncio.to_thread(
+            self._claim_due_materials_sync, now, queue_size, per_scope_hourly_limit, lease_seconds, batch_size
+        )
