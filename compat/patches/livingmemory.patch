+    async def _run_scope_searches(self,jobs,deadline,query,k,context,req,session_id):
+        """Bound pure reads separately from the leaf pool; preserve scope order."""
+        outcomes=[{'state':'timeout','value':[]} for _ in jobs]
+        pending=iter(enumerate(jobs))
+        async def worker():
+            for index,(scope,scope_session_id,scope_persona_id,interaction_type) in pending:
+                if deadline.search_remaining()<=0:
+                    return
+                identity=self._search_scope_identity(req,session_id,scope_session_id,scope_persona_id,scope.source_session_id)
+                try:
+                    value=await self._search_scope_with_deadline(deadline,
+                        query=query,k=k,session_id=scope_session_id,persona_id=scope_persona_id,
+                        interaction_type=interaction_type,source_platform=scope.source_platform,
+                        source_session_id=scope.source_session_id,touch_access=False,cache_results=False,
+                        allow_legacy_session_migration=False,
+                        execution_context=context.for_scope(identity,self._scope_revision(identity)) if context else None)
+                    outcomes[index]={'state':'completed','value':value}
+                except asyncio.CancelledError:
+                    raise
+                except asyncio.TimeoutError:
+                    outcomes[index]={'state':'timeout','value':[]}
+                except Exception as exc:
+                    outcomes[index]={'state':'error','value':[]}
+                    logger.debug('[LMRecall] route=memory_scope outcome=error exception_type=%s',type(exc).__name__)
+        tasks=[asyncio.create_task(worker()) for _ in range(min(3,len(jobs)))]
+        try:
+            if tasks:await asyncio.gather(*tasks)
+        finally:
+            for task in tasks:
+                if not task.done():task.cancel()
+            if tasks:await asyncio.gather(*tasks,return_exceptions=True)
+        return outcomes
+
