+                               (scope_key, max(1, min(int(limit), 200))))
+            return [{"atom_id": r[0], "kind": r[1], "status": r[2], "atom": self._read_json(r[3]), "revision": int(r[4])} for r in rows]
+
+    async def list_admin_atoms(self, limit: int = 100) -> list[dict]:
+        return await asyncio.to_thread(self._list_admin_atoms_sync, limit)
+
+    def _list_admin_atoms_sync(self, limit: int) -> list[dict]:
+        with self._lock, self._session() as db:
+            correction_rows = db.execute("SELECT scope_key,target_id,action,replacement_atom_id,affected_ids_json "
+                                         "FROM evidence_corrections ORDER BY correction_revision").fetchall()
+            effective_status = {}
+            for correction in correction_rows:
+                scope = str(correction[0])
+                target_id = str(correction[1])
+                action = str(correction[2])
+                replacement_id = str(correction[3] or "")
+                target_status = {"withdraw": "withdrawn", "dispute": "disputed", "supersede": "superseded"}[action]
+                effective_status[(scope, target_id)] = target_status
+                for affected_id in json.loads(correction[4]):
