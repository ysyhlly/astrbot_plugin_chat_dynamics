+    def _admit_material_job_sync(self, descriptor: dict, now: float, queue_size: int,
+                                 owner_ready: bool = True) -> str:
+        material_id = str(descriptor.get("material_id", ""))
+        scope_key = str(descriptor.get("scope_key", ""))
+        locator = descriptor.get("source_locator")
+        if not material_id or not scope_key or not isinstance(locator, dict) or not locator.get("kind"):
+            return "invalid_locator"
+        source_scope = locator.get("scope") if isinstance(locator.get("scope"), dict) else {}
+        umo = str(source_scope.get("umo") or "")
+        locator_json = _json(locator)
+        capacity = max(1, int(queue_size))
+        with self._lock, self._session() as db:
+            db.execute("BEGIN IMMEDIATE")
+            material = db.execute(
+                "SELECT status,attempt_count,next_attempt_at,outcome_code,text_hash,projection_key "
+                "FROM evidence_materials WHERE material_id=? AND scope_key=?",
+                (material_id, scope_key),
+            ).fetchone()
+            if not material:
+                db.rollback()
+                return "missing_material"
+            status, attempts, retry_at, outcome = str(material[0]), int(material[1]), float(material[2]), str(material[3])
+            if (status in {"ready", "invalidated", "terminal"} or outcome in {"policy_refusal", "source_unavailable"} or
+                    (outcome == "invalid_schema" and attempts >= MAX_INVALID_SCHEMA_ATTEMPTS)):
+                db.execute("DELETE FROM evidence_derivation_queue WHERE material_id=? AND scope_key=?", (material_id, scope_key))
+                db.commit()
+                return "terminal"
+            existing = db.execute(
+                "SELECT status,available_at,lease_id,lease_until,source_locator_json,correction_revision,projection_key,text_hash "
+                "FROM evidence_derivation_queue WHERE material_id=? AND scope_key=?",
+                (material_id, scope_key),
+            ).fetchone()
+            if existing:
+                old_status, old_available, old_lease, old_lease_until = str(existing[0]), float(existing[1]), str(existing[2]), float(existing[3])
+                same_source = (str(existing[6]) == str(descriptor.get("projection_key", "")) and
+                               str(existing[7]) == str(descriptor.get("text_hash", "")) and
+                               int(existing[5]) == int(descriptor.get("correction_revision", 0)))
+                if same_source and old_status == "leased" and old_lease and old_lease_until > now:
+                    db.commit()
+                    return "duplicate"
+                if same_source and not owner_ready and old_status in {"queued", "deferred", "owner_wait"}:
+                    db.execute("UPDATE evidence_derivation_queue SET status='owner_wait',lease_id='',lease_until=0,updated_at=? "
+                               "WHERE material_id=? AND scope_key=?",
+                               (now, material_id, scope_key))
+                    db.execute("UPDATE evidence_materials SET status='deferred',diagnostics_code='policy_unavailable',updated_at=? "
+                               "WHERE material_id=? AND scope_key=? AND status NOT IN ('ready','invalidated','terminal')",
+                               (now, material_id, scope_key))
+                    db.commit()
+                    return "owner_wait"
+                if same_source and old_status == "queued":
+                    db.commit()
+                    return "duplicate"
+                if same_source and old_status == "owner_wait":
+                    db.commit()
+                    return "deferred"
+                if same_source and old_status == "deferred" and old_available > now:
+                    db.commit()
+                    return "deferred"
+            if status == "failed" and retry_at > now:
+                db.execute("""INSERT INTO evidence_derivation_queue(
+                    material_id,scope_key,umo,source_locator_json,correction_revision,projection_key,text_hash,status,available_at,lease_id,lease_until,created_at,updated_at
+                ) VALUES (?,?,?,?,?,?,?,'deferred',?,'',0,?,?)
+                ON CONFLICT(material_id) DO UPDATE SET status='deferred',available_at=excluded.available_at,
+                    umo=excluded.umo,source_locator_json=excluded.source_locator_json,correction_revision=excluded.correction_revision,
+                    projection_key=excluded.projection_key,text_hash=excluded.text_hash,
+                    lease_id='',lease_until=0,updated_at=excluded.updated_at""",
+                    (material_id, scope_key, umo, locator_json, int(descriptor.get("correction_revision", 0)),
+                     str(descriptor.get("projection_key", "")), str(descriptor.get("text_hash", "")), retry_at, now, now))
+                db.commit()
+                return "deferred"
+            active = db.execute(
+                "SELECT COUNT(*) FROM evidence_derivation_queue WHERE status IN ('queued','leased')"
+            ).fetchone()[0]
+            next_status = ("owner_wait" if not owner_ready else
+                           "queued" if int(active) < capacity else "deferred")
+            available_at = now if next_status == "queued" else max(now, retry_at)
+            db.execute("""INSERT INTO evidence_derivation_queue(
+                material_id,scope_key,umo,source_locator_json,correction_revision,projection_key,text_hash,status,available_at,lease_id,lease_until,created_at,updated_at
+            ) VALUES (?,?,?,?,?,?,?,?,?,'',0,?,?)
+            ON CONFLICT(material_id) DO UPDATE SET scope_key=excluded.scope_key,
+                umo=excluded.umo,source_locator_json=excluded.source_locator_json,correction_revision=excluded.correction_revision,
+                projection_key=excluded.projection_key,text_hash=excluded.text_hash,
+                status=excluded.status,available_at=excluded.available_at,lease_id='',lease_until=0,updated_at=excluded.updated_at""",
+                (material_id, scope_key, umo, locator_json, int(descriptor.get("correction_revision", 0)),
+                 str(descriptor.get("projection_key", "")), str(descriptor.get("text_hash", "")), next_status, available_at, now, now))
+            db.execute("UPDATE evidence_materials SET status=?,diagnostics_code=?,updated_at=? WHERE material_id=? AND scope_key=?",
+                       ("queued" if next_status == "queued" else "deferred",
+                        "" if next_status == "queued" else "policy_unavailable" if next_status == "owner_wait" else "bounded_queue",
+                        now, material_id, scope_key))
+            db.commit()
+            return next_status
