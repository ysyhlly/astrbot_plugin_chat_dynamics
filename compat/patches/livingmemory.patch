+                or not isinstance(persona_id, str) or not persona_id
+                or request_scope.get("umo") != str(getattr(event, "unified_msg_origin", "") or "").strip()
+                or request_scope.get("persona_id") != persona_id
+                or classify_umo(str(request_scope.get("umo") or "")) != "private"):
+            return
