+    async def _material_allowed(self, descriptor: dict, material: dict) -> bool | None:
+        if self.material_policy is None:
+            return True
+        try:
+            result = await self.material_policy(descriptor, material)
+            return result if isinstance(result, bool) else None
+        except asyncio.CancelledError:
+            raise
+        except Exception:
+            return None
+
+    async def _check_material_policy(self, descriptor: dict, material: dict,
+                                     policy_check: Callable[[dict, dict], Awaitable[bool | None]] | None) -> bool | None:
+        if policy_check is None:
+            return await self._material_allowed(descriptor, material)
+        try:
+            result = await policy_check(descriptor, material)
+            return result if isinstance(result, bool) else None
+        except asyncio.CancelledError:
+            raise
+        except Exception:
+            return None
+
+    async def _derive_under_leases(self, batch: list[tuple[dict, dict]], materials: list[dict]):
+        lost = asyncio.Event()
+
+        async def renew_loop():
+            interval = max(1.0, self.lease_seconds / 3.0)
+            while not self._stopping:
+                await asyncio.sleep(interval)
+                for descriptor, _ in batch:
+                    renewed = await self.sidecar.renew_material_lease(
+                        descriptor["material_id"], descriptor["scope_key"],
+                        descriptor["lease_id"], self.clock(), self.lease_seconds,
+                    )
+                    if not renewed:
+                        lost.set()
+                        return
+
+        callback_task = asyncio.create_task(self.derive_callback(materials))
+        renew_task = asyncio.create_task(renew_loop())
+        lost_task = asyncio.create_task(lost.wait())
+        try:
+            done, _ = await asyncio.wait(
+                (callback_task, lost_task), return_when=asyncio.FIRST_COMPLETED
+            )
+            if lost_task in done and lost.is_set() and not callback_task.done():
+                callback_task.cancel()
+                await asyncio.gather(callback_task, return_exceptions=True)
+                return None
+            return await callback_task
+        finally:
+            if not callback_task.done():
+                callback_task.cancel()
+            for task in (renew_task, lost_task):
+                task.cancel()
+            await asyncio.gather(callback_task, renew_task, lost_task, return_exceptions=True)
+
+    @staticmethod
+    def _failure_outcome(error: Exception) -> str:
+        from .utils.api_failure import terminal_provider_failure
+        if terminal_provider_failure(error):
+            return "policy_refusal"
+        if isinstance(error, (TimeoutError, asyncio.TimeoutError)):
+            return "timeout"
+        message = str(error)
+        if message in {"summarizer_unavailable", "summarizer_changed", "LLM Provider 不可用"}:
+            return "provider_unavailable"
+        if message.startswith("invalid_derivation_"):
+            return "invalid_schema"
+        return "transport_failure"
+
+    def _validated_atoms(self, descriptor: dict, material: dict, candidates: list[dict]) -> list[dict]:
+        if not isinstance(candidates, list):
+            return []
+        result = []
+        role = descriptor["role"]
+        exact_event = material.get("source_status") == "exact_event"
+        exact_conversation_row = (
+            material.get("source_status") == "conversation_row" and
+            descriptor.get("source_kind") == "conversation_row" and
+            role == "user" and
+            isinstance(material.get("row_hash"), str) and bool(material.get("row_hash")) and
+            isinstance(material.get("source_memory_id"), int) and
+            not isinstance(material.get("source_memory_id"), bool)
+        )
+        event_type = material.get("event_type", "")
+        roots = [str(x) for x in material.get("root_evidence_ids", []) if str(x).startswith("ev1:")]
+        material_roots = list(material.get("root_material_ids", []))
+        for candidate in candidates[:12]:
+            if not isinstance(candidate, dict):
+                continue
+            kind = str(candidate.get("kind", "reported_claim"))
+            allowed = {"utterance_fact", "reported_claim", "commitment", "boundary", "refusal", "execution_claim", "execution_receipt"}
+            if kind not in allowed:
+                continue
+            try:
+                start, end = int(candidate.get("span_start", -1)), int(candidate.get("span_end", -1))
+            except (TypeError, ValueError):
+                continue
+            if start < 0 or end <= start or end > len(material["text"]):
+                continue
+            source_span = material["text"][start:end]
+            if not source_span.strip() or len(source_span) > 1000:
+                continue
+            claim = str(candidate.get("claim", "")).strip()
+            if not claim or len(claim) > 800:
+                continue
+            if role == "assistant":
+                if kind not in {"utterance_fact", "commitment", "boundary", "refusal", "execution_claim", "execution_receipt"}:
+                    continue
+                if kind == "utterance_fact" and not exact_event:
+                    continue
+            if exact_conversation_row and kind != "utterance_fact":
+                # The deterministic adapter only records the exact user
+                # utterance; it does not infer claims, commitments, or actors.
+                continue
+            if role == "user" and kind == "refusal":
+                kind = "boundary"
+            elif role == "user" and kind in {"commitment", "execution_claim", "execution_receipt"}:
+                kind = "reported_claim"
+            if role == "summary":
+                kind = "reported_claim"
+            if kind == "execution_receipt" and not (
+                exact_event and event_type == "tool.execution_receipt" and
+                isinstance(material.get("receipt"), dict) and
+                material["receipt"].get("schema_version") == 1 and
+                material["receipt"].get("source") == "astrbot_runtime" and
+                material["receipt"].get("status") == "success" and
+                bool(material["receipt"].get("operation_id"))
+            ):
+                # Text claiming something was done is never a program receipt.
+                kind = "execution_claim"
+            if kind == "execution_receipt":
+                status = "verified"
+            elif kind == "utterance_fact":
+                status = "verified_utterance" if exact_event or exact_conversation_row else "reported_unverified"
+            elif role == "summary":
+                status = "reported_unverified"
+            elif role == "assistant" and not (exact_event and event_type == "delivery.success"):
+                status = "pending_continuity"
+            elif role == "user" and kind == "boundary" and not exact_event:
+                status = "observed_user_boundary"
+            elif role == "user" and kind == "boundary" and exact_event:
+                status = "active"
+            elif kind == "execution_claim":
+                status = "reported_unverified"
+            elif kind in {"commitment", "boundary", "refusal"}:
+                status = "active" if exact_event else "reported_unverified"
+            else:
+                status = "reported_unverified"
+            evidence_ref = {
+                "material_id": descriptor["material_id"],
+                "source_event_id": material.get("source_event_id") if exact_event else None,
+                "source_kind": "conversation_row" if exact_conversation_row else material.get("source_kind", ""),
+                "source_memory_id": material.get("source_memory_id") if exact_conversation_row else None,
+                "session_id": material.get("session_id") if exact_conversation_row else None,
+                "row_id": material.get("id") if exact_conversation_row else None,
+                "row_hash": material.get("row_hash") if exact_conversation_row else None,
+                "author_id": material.get("author_id") if exact_event or exact_conversation_row else None,
+                "author_kind": "bot" if role == "assistant" else "user" if exact_event or exact_conversation_row else "unknown",
+                "occurred_at": material.get("occurred_at") if exact_event or exact_conversation_row else None,
+                "delivery_status": material.get("delivery_status", "unknown"),
+                "text_hash": descriptor["text_hash"], "exact_span": [start, end],
+                "source_status": material["source_status"],
+            }
+            identity_refs = sorted(set(roots) | set(material_roots))
+            atom_key = atom_id(descriptor["scope_key"], kind, claim, identity_refs,
+                               int(descriptor.get("correction_revision", 0)))
+            conditions = candidate.get("conditions", "")
+            if not isinstance(conditions, str):
+                conditions = ""
+            atom = {
+                "atom_id": atom_key, "kind": kind, "status": status,
+                "scope": {"scope_key": descriptor["scope_key"]},
+                "subject_ids": [material["author_id"]] if (exact_event or exact_conversation_row) and material.get("author_id") else [],
+                "source_refs": [evidence_ref], "root_evidence_ids": roots,
+                "root_material_ids": material_roots,
+                "derived_from": [], "valid_from": material.get("occurred_at") if exact_event or exact_conversation_row else None,
+                "valid_until": None, "conditions": conditions[:400],
+                "polarity": str(candidate.get("polarity", "unknown"))[:24],
+                "claim": claim, "source_status": material["source_status"],
+                "delivery_status": material.get("delivery_status", "unknown"),
+                "confidence": self._atom_confidence(kind, material, exact_event or exact_conversation_row),
+                "extractor_version": "evidence-extract-v1", "revision": 0,
+                "supersedes": None,
+            }
+            result.append({"atom_id": atom_key, "kind": kind, "status": status,
+                           "root_evidence_ids": roots, "root_material_ids": material_roots, **atom})
+        return result
+
+    @staticmethod
+    def _atom_confidence(kind: str, material: dict, exact_event: bool) -> float:
+        if kind == "execution_receipt":
+            return 1.0
+        base = 0.85 if exact_event else 0.55
+        # Only reported claims soften over time. Explicit boundaries/commitments
+        # remain available until their own validity conditions or corrections change.
+        if kind != "reported_claim" or not exact_event:
+            return base
+        value = material.get("occurred_at")
+        try:
+            if isinstance(value, (int, float)):
+                timestamp = float(value)
+                if timestamp > 100_000_000_000:
+                    timestamp /= 1000.0
+            elif isinstance(value, str):
+                timestamp = datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
+            else:
+                return base
+        except (TypeError, ValueError, OverflowError):
+            return base
+        age_days = max(0.0, (time.time() - timestamp) / 86400.0)
+        return max(0.15, base * math.exp(-age_days / 365.0))
+
+    @staticmethod
+    def _public_atom(atom: dict, status: str) -> dict:
+        output = dict(atom)
+        output["status"] = status
+        output["root_evidence_ids"] = sorted({str(x) for x in atom.get("root_evidence_ids", [])})
+        output["root_material_ids"] = sorted({str(x) for x in atom.get("root_material_ids", [])})
+        output["source_refs"] = [dict(ref) for ref in atom.get("source_refs", []) if isinstance(ref, dict)]
+        return output
+
+    @staticmethod
+    def _dedupe_atoms(atoms: list[dict]) -> list[dict]:
+        by_id = {}
+        for atom in atoms:
+            current = by_id.get(atom["atom_id"])
+            if current is None:
+                by_id[atom["atom_id"]] = atom
+                continue
+            roots = sorted(set(current.get("root_evidence_ids", [])) | set(atom.get("root_evidence_ids", [])))
+            material_roots = sorted(set(current.get("root_material_ids", [])) | set(atom.get("root_material_ids", [])))
+            sources = {json.dumps(ref, sort_keys=True, ensure_ascii=False): ref
+                       for ref in [*current.get("source_refs", []), *atom.get("source_refs", [])]}
+            current["root_evidence_ids"] = roots
+            current["root_material_ids"] = material_roots
+            current["source_refs"] = list(sources.values())[:20]
+            # A repeated quotation changes provenance coverage, never confidence.
+            current["confidence"] = min(float(current.get("confidence", 0.55)), float(atom.get("confidence", 0.55)))
+        return sorted(by_id.values(), key=lambda row: (row.get("kind", ""), row.get("atom_id", "")))
+
+    @staticmethod
+    def _slots(atoms: list[dict]) -> dict[str, list[dict]]:
+        slots = {name: [] for name in ("current_evidence", "commitments_and_boundaries", "recent", "historical_claims")}
+        for atom in atoms:
+            kind = atom.get("kind")
+            status = atom.get("status")
+            if status not in {"active", "verified", "verified_utterance", "observed_user_boundary", "reported_unverified", "pending_continuity"}:
+                continue
+            if atom.get("source_status") == "legacy_summary":
+                slots["historical_claims"].append(atom)
+            elif kind in {"commitment", "boundary", "refusal", "execution_receipt"}:
+                slots["commitments_and_boundaries"].append(atom)
+            elif status in {"reported_unverified", "pending_continuity"} or kind in {"reported_claim", "execution_claim"}:
+                slots["historical_claims"].append(atom)
+            elif kind in {"utterance_fact", "observation"} and status == "verified_utterance":
+                slots["recent"].append(atom)
+            else:
+                slots["current_evidence"].append(atom)
+        return {key: value[:40] for key, value in slots.items()}
+
+    async def _restore_event_provenance(self, atoms: list[dict], atom_revisions: dict[str, int],
+                                        scope: dict, scope_id: str, current_revision: int,
+                                        revoked_ids: set[str], invalidated_atom_ids: set[str],
+                                        prepared: list[tuple[dict, dict]]) -> tuple[int, set[str]]:
+        """Repair response-only author fields from exact archived event sources."""
+        if not atoms:
+            return 0, set()
+        prepared_by_id = {
+            descriptor["material_id"]: (descriptor, material)
+            for descriptor, material in prepared
+            if descriptor.get("material_kind") in {"source_event", "program_receipt"}
+        }
+        material_ids = []
+        for atom in atoms:
+            refs = atom.get("source_refs", [])
+            for ref in refs if isinstance(refs, list) else []:
+                if isinstance(ref, dict) and isinstance(ref.get("material_id"), str):
+                    material_ids.append(ref["material_id"])
+        meta_rows = await self.get_material_descriptors(scope, list(dict.fromkeys(material_ids)))
+        event_cache: dict[str, dict | None] = {}
+        restored = 0
+        invalid_event_atoms: set[str] = set()
+        for atom in atoms[:MAX_MATERIALS * 12]:
+            atom_id_value = str(atom.get("atom_id") or "")
+            atom_refs = atom.get("source_refs", [])
+            is_event_atom = (atom.get("source_status") == "exact_event" or
+                             isinstance(atom_refs, list) and any(
+                                 isinstance(ref, dict) and ref.get("source_status") == "exact_event"
+                                 for ref in atom_refs
+                             ))
+            if (atom_id_value in invalidated_atom_ids or atom_id_value in revoked_ids or not is_event_atom):
+                continue
+            refs = atom_refs
+            if not isinstance(refs, list) or not refs:
+                invalid_event_atoms.add(atom_id_value)
+                continue
+            material_id = str(refs[0].get("material_id") or "") if isinstance(refs[0], dict) else ""
+            event_id_presence = [bool(isinstance(ref, dict) and ref.get("source_event_id")) for ref in refs]
+            if any(event_id_presence) and not all(event_id_presence):
+                invalid_event_atoms.add(atom_id_value)
+                continue
+            event_ids = {str(ref.get("source_event_id")) for ref in refs
+                         if isinstance(ref, dict) and isinstance(ref.get("source_event_id"), str)
+                         and ref.get("source_event_id")}
+            if len(event_ids) > 1 or not material_id or material_id in revoked_ids:
+                invalid_event_atoms.add(atom_id_value)
+                continue
+            row = meta_rows.get(material_id)
+            locator = row.get("source_locator") if isinstance(row, dict) else None
+            canonical_event_id = locator.get("event_id") if isinstance(locator, dict) else None
+            event_id = next(iter(event_ids), canonical_event_id)
+            recovering_missing_event_id = not event_ids
+            if (not isinstance(event_id, str) or not event_id or event_id != canonical_event_id or
+                    not isinstance(locator, dict) or locator.get("kind") != "event" or
+                    locator.get("scope_key") != scope_id or locator.get("scope") != {
+                        key: str(scope.get(key, "")).strip()
+                        for key in ("platform", "umo", "persona_id", "instance_id")
+                    } or event_evidence_id(scope_id, event_id) != material_id):
+                invalid_event_atoms.add(atom_id_value)
+                continue
+            if any(not isinstance(ref, dict) or str(ref.get("material_id") or "") != material_id or
+                   (ref.get("source_event_id") and str(ref.get("source_event_id")) != event_id) or
+                   ref.get("source_status") != "exact_event"
+                   for ref in refs):
+                invalid_event_atoms.add(atom_id_value)
+                continue
+            roots = {str(value) for value in atom.get("root_evidence_ids", [])}
+            material_roots = {str(value) for value in atom.get("root_material_ids", [])}
+            if roots != {material_id} or material_roots:
+                invalid_event_atoms.add(atom_id_value)
+                continue
+            correction_revision = atom_revisions.get(atom_id_value)
+            if (not isinstance(correction_revision, int) or isinstance(correction_revision, bool) or
+                    correction_revision < 0 or correction_revision > current_revision):
+                invalid_event_atoms.add(atom_id_value)
+                continue
+            if not row or row.get("status") != "ready" or row.get("material_kind") not in {"source_event", "program_receipt"}:
+                invalid_event_atoms.add(atom_id_value)
+                continue
+            if (row.get("scope_key") != scope_id or
+                    row.get("correction_revision") != current_revision or
+                    any(ref.get("text_hash") != row.get("text_hash") for ref in refs)):
+                invalid_event_atoms.add(atom_id_value)
+                continue
+            # Normalize the archive with this atom's persisted derivation
+            # revision. The scope's current revision is checked above and all
+            # current revocations/invalidations were checked before this path;
+            # an unrelated later correction must not invalidate this atom.
+            if material_id in prepared_by_id and not recovering_missing_event_id:
