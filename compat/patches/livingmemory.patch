+            node_map.values(),
+            key=lambda item: (
+                -safe_float(item.get("weight"), 0.0),
+                -int(item.get("degree", 0)),
+                str(item.get("label", "")),
+            ),
+        )
+        return {
+            "nodes": nodes,
+            "edges": edges,
+            "entries": [],
+            "memories": memories,
+        }
