+"""Persistent narrative state and scoped events, independent of AstrBot runtime.
+
+Only this module writes narrative data. Public methods accept schema-v1 plain
+dictionaries; every SQLite operation closes its connection before returning.
+"""
+from __future__ import annotations
+
+import asyncio
+import copy
+import datetime as dt
+import hashlib
+import json
+import math
+import re
+import shutil
+import sqlite3
+import time
+import uuid
+import threading
+from contextlib import closing, contextmanager
+from pathlib import Path
+from typing import Any, Awaitable, Callable
+from zoneinfo import ZoneInfo
+
+CHINA = ZoneInfo("Asia/Shanghai")
+FACT_KINDS = {"observation", "user_claim", "fiction", "subjective", "plan", "receipt"}
+AVAILABILITIES = {"available", "busy", "asleep", "unknown"}
+ACTIVITIES = {
+    "writing": "独自写作", "gaming": "独自玩游戏", "resting": "休息",
+    "sleeping": "睡觉", "eating": "用餐", "reading": "独自阅读",
+    "walking": "散步", "chores": "处理日常事务", "unknown": "未知",
+}
+COMMITMENT_STATUSES = {"proposed", "committed", "conditional", "completed", "cancelled", "expired"}
+INTENT_STATUSES = {"pending", "claimed", "sent", "cancelled", "expired", "uncertain", "failed"}
+TERMINAL_INTENTS = {"sent", "cancelled", "expired", "uncertain"}
+
+
+class NarrativeValidationError(ValueError):
+    """Carry a fixed body-free code, never interpolated model/user content."""
+
+    def __init__(self, code: str, message: str):
+        super().__init__(message)
+        self.code = code
+
+
+def _json(value: Any) -> str:
+    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)
+
+
+def _text(value: Any, maximum: int, field: str = "text") -> str:
+    if not isinstance(value, str):
+        raise NarrativeValidationError("text_type", f"{field} must be a string")
+    value = value.strip()
+    if len(value) > maximum:
+        raise NarrativeValidationError("text_length", f"{field} exceeds its length limit")
+    return value
+
+
+def _timestamp(value: Any, field: str = "timestamp") -> float:
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
+        raise NarrativeValidationError("timestamp_type", f"{field} must be a finite epoch timestamp")
+    if value < 0:
+        raise NarrativeValidationError("timestamp_negative", f"{field} cannot be negative")
+    return float(value)
+
+
+def normalize_scope(scope: dict) -> dict:
+    """Validate scope identifiers without reducing full UMO to a group number."""
+    if not isinstance(scope, dict) or scope.get("schema_version", 1) != 1:
+        raise NarrativeValidationError("unsupported_scope_schema", "Unsupported scope schema")
+    result = {name: _text(scope.get(name, ""), 300, name) for name in ("platform", "umo", "persona_id")}
+    result["instance_id"] = _text(scope.get("instance_id") or result["persona_id"], 300, "instance_id")
+    if not result["persona_id"] or not result["instance_id"]:
+        raise NarrativeValidationError("a_concrete_persona_is_required", "A concrete persona is required")
+    result["schema_version"] = 1
+    return result
+
+
+def _identity(scope: dict) -> str:
+    return _json([scope["persona_id"], scope["instance_id"]])
+
+
+class NarrativeEngine:
+    """Own durable life, revisions, budgets and intents for one configured persona.
+
+    Args:
+        path: Narrative database file.
+        config: Live plugin config, including explicit narrative session allowlist.
+        model: Async callback receiving the isolated narrative input dictionary.
+        clock: Injectable epoch clock for deterministic simulation.
+    """
+
+    def __init__(self, path: Path, config: Any, model: Callable[[dict], Awaitable[dict]],
+                 clock: Callable[[], float] = time.time):
+        self.path, self.config, self.model, self.clock = Path(path), config, model, clock
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        self._locks: dict[str, asyncio.Lock] = {}
+        self._closed = False
+        self._context_generation = 0
+        self._generation_lock = threading.Lock()
+        self._backup_before_retry_extension()
+        self._initialize()
+
+    def _backup_before_retry_extension(self) -> None:
+        """Take an SQLite-consistent scoped backup before adding retry columns."""
+        if not self.path.is_file():
+            return
+        uri = self.path.resolve().as_uri() + "?mode=ro"
+        with closing(sqlite3.connect(uri, uri=True, timeout=5)) as source:
+            table = source.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='events'").fetchone()
+            if table is None:
+                return
+            version = source.execute("SELECT value FROM metadata WHERE key='schema_version'").fetchone()
+            if version is None or version[0] != "1":
+                return
+            columns = {row[1] for row in source.execute("PRAGMA table_info(events)")}
+            if {"retry_attempt", "next_retry"} <= columns:
+                return
+            backup = self.path.with_name(
+                f"{self.path.name}.pre-retry-{int(self.clock())}-{uuid.uuid4().hex[:8]}.bak")
+            with closing(sqlite3.connect(backup, timeout=5)) as destination:
+                source.backup(destination)
+                check = destination.execute("PRAGMA quick_check").fetchone()
+                if not check or check[0] != "ok":
+                    raise sqlite3.DatabaseError("Retry migration backup failed quick_check")
+
+    @contextmanager
+    def _db(self):
+        conn = sqlite3.connect(self.path, timeout=5)
+        conn.row_factory = sqlite3.Row
+        conn.execute("PRAGMA foreign_keys=ON")
+        conn.execute("PRAGMA busy_timeout=5000")
+        wrote = False
+
+        def authorize(action, _first, _second, _database, _trigger):
+            nonlocal wrote
+            if not wrote and action in {sqlite3.SQLITE_INSERT, sqlite3.SQLITE_UPDATE, sqlite3.SQLITE_DELETE,
+                                        sqlite3.SQLITE_CREATE_TABLE, sqlite3.SQLITE_ALTER_TABLE, sqlite3.SQLITE_DROP_TABLE}:
+                wrote = True
+                with self._generation_lock:
+                    self._context_generation += 1
+            return sqlite3.SQLITE_OK
+
+        conn.set_authorizer(authorize)
+        try:
+            with conn:
+                yield conn
+        finally:
+            conn.close()
+            if wrote:
+                with self._generation_lock:
+                    self._context_generation += 1
+
+    def peek_context_revision(self, scope):
+        """Return an in-memory epoch before/after writes without touching SQLite."""
+        scope = normalize_scope(scope)
+        if not self._allowed(scope):
+            return {"schema_version": 1, "available": False}
+        with self._generation_lock:
+            return {"schema_version": 1, "available": True, "generation": self._context_generation}
+
+    def _initialize(self) -> None:
+        with self._db() as db:
+            db.execute("PRAGMA journal_mode=WAL")
+            db.executescript("""
+                CREATE TABLE IF NOT EXISTS metadata(key TEXT PRIMARY KEY,value TEXT NOT NULL);
+                CREATE TABLE IF NOT EXISTS lives(identity TEXT PRIMARY KEY,scope TEXT NOT NULL,
+                    revision INTEGER NOT NULL DEFAULT 0,state TEXT NOT NULL,updated REAL NOT NULL);
+                CREATE TABLE IF NOT EXISTS scopes(identity TEXT NOT NULL,umo TEXT NOT NULL,
+                    revision INTEGER NOT NULL DEFAULT 0,state TEXT NOT NULL,
+                    PRIMARY KEY(identity,umo));
+                CREATE TABLE IF NOT EXISTS events(event_id TEXT PRIMARY KEY,identity TEXT NOT NULL,
+                    umo TEXT NOT NULL,occurred REAL NOT NULL,received REAL NOT NULL,
+                    payload TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'pending',
+                    error TEXT NOT NULL DEFAULT '',created REAL NOT NULL,
+                    retry_attempt INTEGER NOT NULL DEFAULT 0,
+                    next_retry REAL NOT NULL DEFAULT 0);
+                CREATE INDEX IF NOT EXISTS event_queue ON events(identity,umo,status,received);
+                CREATE INDEX IF NOT EXISTS event_fifo ON events(identity,umo,status,occurred,received,event_id);
+                CREATE TABLE IF NOT EXISTS validation_failures(
+                    failure_id TEXT PRIMARY KEY, event_ids TEXT NOT NULL,
+                    reason_code TEXT NOT NULL, occurred REAL NOT NULL);
+                CREATE INDEX IF NOT EXISTS validation_failure_time ON validation_failures(occurred DESC);
+                CREATE TABLE IF NOT EXISTS diary(entry_id TEXT PRIMARY KEY,identity TEXT NOT NULL,
+                    umo TEXT NOT NULL,occurred REAL NOT NULL,text TEXT NOT NULL,
+                    fact_kind TEXT NOT NULL,source_ids TEXT NOT NULL,revision INTEGER NOT NULL);
+                CREATE TABLE IF NOT EXISTS commitments(commitment_id TEXT PRIMARY KEY,
+                    identity TEXT NOT NULL,umo TEXT NOT NULL,payload TEXT NOT NULL,status TEXT NOT NULL);
+                CREATE TABLE IF NOT EXISTS intents(intent_id TEXT PRIMARY KEY,identity TEXT NOT NULL,
+                    umo TEXT NOT NULL,payload TEXT NOT NULL,status TEXT NOT NULL,
+                    not_before REAL NOT NULL,expires REAL NOT NULL,updated REAL NOT NULL);
+                CREATE INDEX IF NOT EXISTS intent_due ON intents(status,not_before,expires);
+                CREATE TABLE IF NOT EXISTS budgets(identity TEXT NOT NULL,hour INTEGER NOT NULL,
+                    kind TEXT NOT NULL,used INTEGER NOT NULL,PRIMARY KEY(identity,hour,kind));
+                CREATE TABLE IF NOT EXISTS maintenance(identity TEXT NOT NULL,kind TEXT NOT NULL,
+                    last REAL NOT NULL,PRIMARY KEY(identity,kind));
+                CREATE TABLE IF NOT EXISTS calls(call_id TEXT PRIMARY KEY,identity TEXT NOT NULL,
+                    umo TEXT NOT NULL,started REAL NOT NULL,duration REAL NOT NULL,
+                    status TEXT NOT NULL,kind TEXT NOT NULL);
+                CREATE TABLE IF NOT EXISTS legacy_imports(source_hash TEXT PRIMARY KEY,
+                    source_path TEXT NOT NULL,payload TEXT NOT NULL,fact_kind TEXT NOT NULL,
+                    imported REAL NOT NULL);
+            """)
+            db.execute("INSERT OR IGNORE INTO metadata VALUES('schema_version','1')")
+            version = db.execute("SELECT value FROM metadata WHERE key='schema_version'").fetchone()[0]
+            if version != "1":
+                raise NarrativeValidationError("unsupported_narrative_database_schema", "Unsupported narrative database schema")
+            # Optional queue metadata is tracked independently from the base
+            # schema version so source-only rollback to older readers stays safe.
+            event_columns = {row[1] for row in db.execute("PRAGMA table_info(events)")}
+            if "retry_attempt" not in event_columns:
+                db.execute("ALTER TABLE events ADD COLUMN retry_attempt INTEGER NOT NULL DEFAULT 0")
+            if "next_retry" not in event_columns:
+                db.execute("ALTER TABLE events ADD COLUMN next_retry REAL NOT NULL DEFAULT 0")
+            event_info = {row[1]: row for row in db.execute("PRAGMA table_info(events)")}
+            for name, expected_type in (("retry_attempt", "INTEGER"), ("next_retry", "REAL")):
+                column = event_info[name]
+                if column[2].upper() != expected_type or int(column[3]) != 1 or str(column[4]) != "0":
+                    raise ValueError(f"Invalid retry column definition: {name}")
+            extension = db.execute("SELECT value FROM metadata WHERE key='retry_extension_version'").fetchone()
+            if extension is None:
+                db.execute("INSERT INTO metadata(key,value) VALUES('retry_extension_version','1')")
+            elif extension[0] != "1":
+                raise NarrativeValidationError("unsupported_narrative_retry_extension", "Unsupported narrative retry extension")
+            # A process can die after claiming but before a platform acknowledges.
+            # Claimed sends become uncertain, never pending, on restart.
+            db.execute("UPDATE intents SET status='uncertain' WHERE status='claimed'")
+            self._migrate_clock(db)
+            if not db.execute("SELECT 1 FROM metadata WHERE key='structured_contract_version'").fetchone():
+                # Give the corrected contract one immediate attempt; do not
+                # resolve evidence, reset counters or lift provider backoff.
+                db.execute("UPDATE events SET next_retry=0 WHERE status='pending' AND error='ValueError'")
+                db.execute("INSERT INTO metadata VALUES('structured_contract_version','1')")
+
+    def _migrate_clock(self, db):
+        """Invalidate legacy group-refreshed deadlines once, with a durable receipt."""
+        now = self.clock()
+        for row in db.execute('SELECT identity,scope,state FROM lives').fetchall():
+            state = json.loads(row['state'])
+            if state.get('clock_schema_version') == 2:
+                continue
+            state['clock_schema_version'] = 2
+            if 'narrated_until' not in state:
+                last = db.execute("SELECT MAX(started) FROM calls WHERE identity=? AND umo='' "
+                                  "AND kind='hourly' AND status IN ('advanced','no_change')", (row['identity'],)).fetchone()[0]
+                state['narrated_until'] = min(now, last) if last is not None else now
+                state['valid_until'] = min(now, state['valid_until'])
+                state['next_check'] = now
+                # No inferred sleep start: validity timestamps previously moved
+                # on group chatter, so they cannot establish duration of rest.
+                state.pop('activity_started_at', None)
+                event_id = 'clock.migration.v2:' + row['identity']
+                event = dict(schema_version=1,event_id=event_id,type='clock.migration',
+                             scope=json.loads(row['scope']),occurred_at=now,received_at=now,
+                             actor_id='system',text='旧版时钟有效期作废，等待重新检查；历史记录保留。',
+                             source_ids=[event_id],fact_kind='receipt',data={'effect_confirmed':True})
+                db.execute("INSERT OR IGNORE INTO events(event_id,identity,umo,occurred,received,payload,status,created) VALUES(?,?,'',?,?,?,'observed_only',?)",
+                           (event_id,row['identity'],now,now,_json(event),now))
+            db.execute('UPDATE lives SET state=?,revision=revision+1 WHERE identity=?', (_json(state),row['identity']))
+
+    def is_managed(self, scope: dict) -> bool:
+        """Return whether the concrete persona and full UMO are explicitly enabled."""
+        try:
+            scope = normalize_scope(scope)
+        except ValueError:
+            return False
+        return (not self._closed and self.config.get("mode", "legacy") == "narrative"
+                and bool(self.config.get("persona_id"))
+                and scope["persona_id"] == str(self.config.get("persona_id"))
+                and self._group_scope(scope["umo"])
+                and (self.config.get("narrative_all_groups", False) is True
+                     or scope["umo"] in (self.config.get("narrative_sessions", []) or [])))
+
+    @staticmethod
+    def _group_scope(umo: str) -> bool:
+        parts = umo.rsplit(":", 2)
+        return len(parts) == 3 and bool(parts[0]) and parts[1].lower() == "groupmessage" and bool(parts[2])
+
+    def _has_targets(self) -> bool:
+        return self.config.get("narrative_all_groups", False) is True or any(
+            isinstance(item, str) and self._group_scope(item) for item in (self.config.get("narrative_sessions", []) or []))
+
+    def _global_scope(self) -> dict:
+        return normalize_scope({"platform": "", "umo": "", "persona_id": str(self.config.get("persona_id", ""))})
+
+    def _allowed(self, scope: dict) -> bool:
+        return self.is_managed(scope) or (not scope["umo"]
+            and self.config.get("mode", "legacy") == "narrative"
+            and scope["persona_id"] == str(self.config.get("persona_id", ""))
+            and self._has_targets() and not self._closed)
+
+    def _ensure(self, db, scope: dict, now: float) -> None:
+        identity = _identity(scope)
+        if (db.execute("SELECT 1 FROM lives WHERE identity=?", (identity,)).fetchone()
+                and db.execute("SELECT 1 FROM scopes WHERE identity=? AND umo=?", (identity, scope["umo"])).fetchone()):
+            return
+        global_scope = dict(scope, umo="", platform="")
+        state = {"activity": "未知", "activity_code": "unknown", "availability": "unknown",
+                 "subjective_state": "", "summary": "", "source_ids": [],
+                 "valid_from": now, "valid_until": now, "next_check": now,
+                 "plan": [], "plan_date": "", "clock_schema_version": 2}
+        db.execute("INSERT OR IGNORE INTO lives(identity,scope,state,updated) VALUES(?,?,?,?)",
+                   (identity, _json(global_scope), _json(state), now))
+        db.execute("INSERT OR IGNORE INTO scopes(identity,umo,state) VALUES(?,?,?)",
+                   (identity, scope["umo"], _json({"subjective_state": "", "summary": "", "source_ids": []})))
+
+    def _snapshot(self, db, scope: dict, now: float) -> dict:
+        self._ensure(db, scope, now)
+        identity = _identity(scope)
+        row = db.execute("SELECT * FROM lives WHERE identity=?", (identity,)).fetchone()
+        local = db.execute("SELECT * FROM scopes WHERE identity=? AND umo=?", (identity, scope["umo"])).fetchone()
+        state, scoped = json.loads(row["state"]), json.loads(local["state"])
+        activity_revision = state.get("activity_revision", row["revision"])
+        scoped_current = (scoped.get("activity_revision") == activity_revision
+                          and float(scoped.get("valid_until", 0)) > now)
+        commitments = [json.loads(item[0]) for item in db.execute(
+            "SELECT payload FROM commitments WHERE identity=? AND umo=? ORDER BY commitment_id", (identity, scope["umo"]))]
+        for commitment in commitments:
+            if commitment.get('status') not in {'committed','conditional','proposed'}:
+                continue
+            participants = set(commitment.get('participant_ids') or [])
+            for source in commitment.get('source_ids', [])[:50]:
+                evidence = db.execute('SELECT payload FROM events WHERE event_id=? AND identity=? AND umo=?',
+                                      (source, identity, scope['umo'])).fetchone()
+                if evidence:
+                    item = json.loads(evidence[0])
+                    if item.get('type') in {'message.received', 'chat.message'} and item.get('actor_id') not in {'', 'bot', 'system', None}:
+                        participants.add(item['actor_id'])
+                    if item.get('type') == 'delivery.success' and item.get('data', {}).get('recipient_user_id'):
+                        participants.add(item['data']['recipient_user_id'])
+            commitment['participant_ids'] = sorted(participants)
+        expired = float(state["valid_until"]) <= now
+        # Personal interests can outlive an activity. Conversation-derived
+        # material remains local; no participant text enters shared life.
+        humanlike = {key: [] for key in ("preferences", "goals", "moods", "nicknames")}
+        for owner, saved in (("personal", state), ("conversation", scoped)):
+            if owner == "conversation" and not scope["umo"]:
+                continue
+            for key in humanlike:
+                for item in saved.get("humanlike", {}).get(key, {}).values():
+                    if key in {"goals", "moods"} and item.get("expires_at", 0) <= now:
+                        continue
+                    presentation = dict(item, origin=owner)
+                    if key == "moods":
+                        presentation["strength"] = round(
+                            2 ** (-max(0, now - item["updated_at"]) / 600), 3
+                        )
+                    humanlike[key].append(presentation)
+        return {
+            "schema_version": 1,
+            "managed": self._allowed(scope),
+            "scope": copy.deepcopy(scope),
+            "revision": row["revision"],
+            "scope_revision": local["revision"],
+            "activity": state["activity"] if not expired else "未知",
+            "availability": state["availability"] if not expired else "unknown",
+            "subjective_state": (scoped["subjective_state"] if scoped_current else "")
+            or (state["subjective_state"] if not expired else ""),
+            "summary": (scoped["summary"] if scoped_current else "")
+            or (state["summary"] if not expired else ""),
+            "commitments": commitments,
+            "global_presentation": {
+                k: state.get(k, "") if not expired else ""
+                for k in ("subjective_state", "summary")
+            },
+            "scoped_presentation": (
+                {
+                    **{
+                        k: scoped.get(k)
+                        for k in (
+                            "subjective_state",
+                            "summary",
+                            "source_ids",
+                            "participant_ids",
+                            "occurred_at",
+                        )
+                    },
+                    "valid_until": scoped.get("valid_until", 0),
+                }
+                if scoped_current
+                else {}
+            ),
+            "source_ids": list(
+                dict.fromkeys(
+                    state["source_ids"]
+                    + (scoped["source_ids"] if scoped_current else [])
+                )
+            ),
+            "scoped_presentation_stale": bool(
+                scoped["summary"] or scoped["subjective_state"]
+            )
+            and not scoped_current,
+            "valid_from": state["valid_from"],
+            "valid_until": state["valid_until"],
+            "activity_started_at": state.get("activity_started_at"),
+            "narrated_until": state.get("narrated_until", state["valid_from"]),
+            "energy": self._energy(state, now),
+            "humanlike": humanlike,
+            "stale": expired,
+            "paused": self._paused(db, scope),
+            "outreach_paused": self._outreach_paused(db, scope),
+        }
+
+    @staticmethod
+    def _energy(state, now):
+        # Only the confirmed interval counts. Legacy refreshed valid_from is not
+        # evidence of when rest started, and expired time is never inferred.
+        start = state.get("activity_started_at")
+        if start is None:
+            return {"level": "unknown", "fact_kind": "subjective", "basis": "activity_start_unknown"}
+        elapsed = max(0, min(now, state["valid_until"]) - start)
+        resting = state.get("activity_code") in {"sleeping", "resting"} or state.get("availability") == "asleep"
+        threshold = 4 * 3600 if state.get("availability") == "asleep" else 1800
+        level = ("recovered" if elapsed >= threshold else "recovering") if resting else "normal"
+        return {"level": level, "confirmed_activity_seconds": round(elapsed),
+                "fact_kind": "subjective", "basis": "confirmed_activity_interval",
+                "previous_rest_seconds": state.get("previous_rest_seconds", 0)}
+
+    async def get_snapshot(self, scope: dict) -> dict:
+        """Return scoped state without making a model call or inventing a life."""
+        scope = normalize_scope(scope)
+        if not self._allowed(scope):
+            return {"schema_version": 1, "managed": False, "scope": scope}
+        return await asyncio.to_thread(self._read_snapshot, scope)
+
+    def _read_snapshot(self, scope: dict) -> dict:
+        with self._db() as db:
+            self._ensure(db, scope, self.clock())
+        with self._db() as db:
+            db.execute("BEGIN")
+            return self._snapshot(db, scope, self.clock())
+
+    def _paused(self, db, scope: dict) -> bool:
+        keys = ["paused", "paused:" + _identity(scope), "paused:" + _identity(scope) + ":" + scope["umo"]]
+        return any(db.execute("SELECT value FROM metadata WHERE key=?", (key,)).fetchone()
+                   and db.execute("SELECT value FROM metadata WHERE key=?", (key,)).fetchone()[0] == "true" for key in keys)
+
+    def _outreach_paused(self, db, scope: dict) -> bool:
+        keys = ["proactive_paused", "proactive_paused:" + _identity(scope) + ":" + scope["umo"]]
+        for key in keys:
+            row = db.execute("SELECT value FROM metadata WHERE key=?", (key,)).fetchone()
+            if row and row[0] == "true":
+                return True
+        return False
+
+    def _event(self, event: dict, now: float) -> dict:
+        if not isinstance(event, dict) or event.get("schema_version", 1) != 1:
+            raise NarrativeValidationError("unsupported_event_schema", "Unsupported event schema")
+        scope = normalize_scope(event.get("scope", {}))
+        event_id = _text(event.get("event_id", ""), 300, "event_id")
+        kind = _text(event.get("type", ""), 100, "type")
+        if not event_id or not kind:
+            raise NarrativeValidationError("event_id_and_type_are_required", "Event ID and type are required")
+        occurred = _timestamp(event.get("occurred_at", now), "occurred_at")
+        received = _timestamp(event.get("received_at", now), "received_at")
+        fact_kind = event.get("fact_kind", "observation")
+        if fact_kind not in FACT_KINDS:
+            raise NarrativeValidationError("unknown_fact_kind", "Unknown fact kind")
+        if kind.startswith("delivery."):
+            fact_kind = "receipt"
+        data = event.get("data", {})
+        if not isinstance(data, dict) or len(_json(data)) > 24000:
+            raise NarrativeValidationError("invalid_event_data", "Invalid event data")
+        source_ids = event.get("source_ids", [event_id])
+        if not isinstance(source_ids, list) or len(source_ids) > 50 or not all(isinstance(item, str) for item in source_ids):
+            raise NarrativeValidationError("invalid_event_sources", "Invalid event sources")
+        return {"schema_version": 1, "event_id": event_id, "type": kind,
+            "occurred_at": occurred, "received_at": received, "scope": scope,
+            "actor_id": _text(event.get("actor_id", ""), 300, "actor_id"),
+            "text": _text(event.get("text", ""), 12000), "source_ids": source_ids,
+            "fact_kind": fact_kind, "data": copy.deepcopy(data)}
+
+    async def ingest_events(self, events: list[dict]) -> dict:
+        """Persist observed input and delivery receipts idempotently before inference."""
+        now = self.clock()
+        validated = [self._event(event, now) for event in events]
+        accepted, duplicate, ignored = [], [], []
+        with self._db() as db:
+            for event in validated:
+                scope, event_id = event["scope"], event["event_id"]
+                if not self._allowed(scope):
+                    ignored.append(event_id)
+                    continue
+                payload = _json(event)
+                old = db.execute("SELECT payload FROM events WHERE event_id=?", (event_id,)).fetchone()
+                if old:
+                    if old[0] != payload:
+                        raise NarrativeValidationError("an_event_id_cannot_be_reused_with_different_content", "An event ID cannot be reused with different content")
+                    duplicate.append(event_id)
+                    continue
+                self._ensure(db, scope, now)
+                db.execute("INSERT INTO events(event_id,identity,umo,occurred,received,payload,created) VALUES(?,?,?,?,?,?,?)",
+                    (event_id, _identity(scope), scope["umo"], event["occurred_at"], event["received_at"], payload, now))
+                accepted.append(event_id)
+                self._cancel_care_on_input(db, event, now)
+                # Explicit self-address objections take effect on ingestion,
+                # even when narrative inference is paused or out of budget.
+                if (
+                    scope["umo"]
+                    and event["type"] in {"message.received", "chat.message"}
+                    and event["actor_id"] not in {"", "bot", "system"}
+                ):
+                    local = json.loads(
+                        db.execute(
+                            "SELECT state FROM scopes WHERE identity=? AND umo=?",
+                            (_identity(scope), scope["umo"]),
+                        ).fetchone()[0]
+                    )
+                    names = local.get("humanlike", {}).get("nicknames", {})
+                    previous_name = names.get(event["actor_id"], {})
+                    spoken = event["text"].strip().rstrip("。.!！,，~～")
+                    explicit = bool(
+                        previous_name.get("nickname")
+                        and re.fullmatch(
+                            r"(?:别|不要|别再|不要再)叫我"
+                            + re.escape(previous_name["nickname"]),
+                            spoken,
+                        )
+                    )
+                    addressed = event["data"].get(
+                        "directed_to_bot"
+                    ) is True and spoken in {
+                        "别这么叫我",
+                        "别再这么叫我",
+                        "不要这么叫我",
+                        "别这样叫我",
+                        "不要这样叫我",
+                        "别给我起外号",
+                        "不要给我起外号",
+                    }
+                    if (explicit or addressed) and event[
+                        "occurred_at"
+                    ] >= previous_name.get("updated_at", 0):
+                        names = local.setdefault("humanlike", {}).setdefault(
+                            "nicknames", {}
+                        )
+                        if event["actor_id"] in names or len(names) < 1024:
+                            names[event["actor_id"]] = {
+                                "subject_id": event["actor_id"],
+                                "nickname": previous_name.get("nickname", ""),
+                                "status": "rejected",
+                                "evidence_quote": spoken,
+                                "source_ids": [event_id],
+                                "participant_ids": [event["actor_id"]],
+                                "updated_at": now,
+                                "fact_kind": "observation",
+                            }
+                            db.execute(
+                                "UPDATE scopes SET state=?,revision=revision+1 WHERE identity=? AND umo=?",
+                                (_json(local), _identity(scope), scope["umo"]),
+                            )
+                            db.execute(
+                                "UPDATE lives SET revision=revision+1 WHERE identity=?",
+                                (_identity(scope),),
+                            )
+                if event["type"] in {"delivery.success", "delivery.failure", "delivery.uncertain"}:
+                    self._delivery_intent(db, event, now)
+                if event["type"] == "delivery.success":
+                    self._confirm_delivery(db, event, now)
+                if event['type'] == 'execution.success' and event['data'].get('effect_confirmed') is True:
+                    self._apply_reminder_effect(db, event)
+                if self._record_only(event):
+                    db.execute("UPDATE events SET status='observed_only' WHERE event_id=?", (event_id,))
+        return {"schema_version": 1, "accepted": accepted, "duplicate": duplicate, "ignored": ignored}
+
+    @staticmethod
+    def _record_only(event):
+        """Evidence stays stored even if no narrative inference is warranted."""
+        data = event.get("data", {})
+        if event["type"] in {"delivery.failure", "delivery.uncertain", "tool.receipt"}:
+            return True
+        if event["type"] != "message.received":
+            return False
+        if data.get("event_impact") in {"activity", "commitment", "relationship"} or data.get("directed_to_bot"):
+            return False
+        # For old queues without classifier metadata, keep potential commitments
+        # and boundaries. Do not claim the narrator processed discarded chatter.
+        text = event.get("text", "")
+        signals = ("答应", "约定", "取消", "提醒", "别再", "不要再", "不喜欢", "承诺", "说好了", "安安")
+        return not any(word in text for word in signals)
+
+    def _apply_reminder_effect(self, db, event):
+        data, scope = event['data'], event['scope']
+        action = data.get('effect_kind')
+        if action not in {'reminder.sent', 'reminder.cancelled'} or not data.get('reminder_id'):
+            return
+        changed = False
+        for row in db.execute('SELECT payload FROM commitments WHERE identity=? AND umo=?',
+                              (_identity(scope), scope['umo'])).fetchall():
+            item = json.loads(row[0])
+            if item.get('reminder_id') != data['reminder_id'] or item['status'] in {'completed', 'cancelled', 'expired'}:
+                continue
+            item['status'] = 'completed' if action == 'reminder.sent' else 'cancelled'
+            item['source_ids'] = list(dict.fromkeys(item['source_ids'] + [event['event_id']]))
+            self._store_commitment(db, scope, item)
+            changed = True
+        if changed:
+            db.execute('UPDATE lives SET revision=revision+1 WHERE identity=?', (_identity(scope),))
+            db.execute('UPDATE scopes SET revision=revision+1 WHERE identity=? AND umo=?', (_identity(scope), scope['umo']))
+
+    def _compact_old_queue(self, db, identity, limit=500):
+        for row in db.execute("SELECT event_id,payload FROM events WHERE identity=? AND status='pending' LIMIT ?", (identity, limit)).fetchall():
+            if self._record_only(json.loads(row["payload"])):
+                db.execute("UPDATE events SET status='observed_only',error='routing:no_significant_impact' WHERE event_id=?", (row["event_id"],))
+
+    def _delivery_intent(self, db, event: dict, now: float) -> None:
+        """Recover an interrupted final status update from the durable receipt."""
+        intent_id = event["data"].get("intent_id")
+        if not isinstance(intent_id, str) or not intent_id:
+            return
+        row = db.execute("SELECT * FROM intents WHERE intent_id=?", (intent_id,)).fetchone()
+        if row is None or row["identity"] != _identity(event["scope"]) or row["umo"] != event["scope"]["umo"]:
+            return
+        status = {"delivery.success": "sent", "delivery.failure": "failed", "delivery.uncertain": "uncertain"}[event["type"]]
+        item = json.loads(row["payload"])
+        if row['status'] not in {'claimed', 'uncertain'} and not (
+                row['status'] == 'cancelled' and item.get('kind') == 'care_wait' and item.get('claimed_at')):
+            return
+        # An actual receipt may resolve crash uncertainty without ever reopening
+        # the intention for another send. Public status updates alone cannot.
+        previous_attempt = item.get("receipt", {}).get("attempt_id")
+        incoming_attempt = event["data"].get("attempt_id")
+        if previous_attempt and incoming_attempt != previous_attempt:
+            return
+        item.update(status=status, receipt={"event_id": event["event_id"], "attempt_id": event["data"].get("attempt_id"),
+            "message_id": event["data"].get("message_id"), "type": event["type"]})
+        db.execute("UPDATE intents SET status=?,payload=?,updated=? WHERE intent_id=?", (status, _json(item), now, intent_id))
+
+    def _confirm_delivery(self, db, event: dict, now: float) -> None:
+        """Confirm proposed commitments only from a matched actual sent segment."""
+        scope, data = event["scope"], event["data"]
+        candidates = data.get("commitments", [])
+        if not isinstance(candidates, list):
+            return
+        changed = False
+        for candidate in candidates[:10]:
+            if not isinstance(candidate, dict):
+                continue
+            quote = candidate.get("evidence_quote", "")
+            if not quote or quote not in event["text"]:
+                continue
+            candidate = dict(candidate, source_ids=[event["event_id"]], status="committed")
+            try:
+                item = self._commitment(candidate, scope, {event["event_id"]: event}, now)
+                self._store_commitment(db, scope, item)
+                changed = True
+            except ValueError:
+                # Invalid extracted promises do not erase the actual receipt.
+                continue
+        if changed:
+            db.execute("UPDATE lives SET revision=revision+1 WHERE identity=?", (_identity(scope),))
+            db.execute("UPDATE scopes SET revision=revision+1 WHERE identity=? AND umo=?", (_identity(scope), scope["umo"]))
+
+    def _reserve(self, db, identity: str, kind: str, now: float) -> bool:
+        hour = int(now // 3600)
+        maximum = 1 if kind == "hourly" else 6
+        row = db.execute("SELECT used FROM budgets WHERE identity=? AND hour=? AND kind=?", (identity, hour, kind)).fetchone()
+        if row and row[0] >= maximum:
+            return False
+        db.execute("INSERT INTO budgets VALUES(?,?,?,1) ON CONFLICT(identity,hour,kind) DO UPDATE SET used=used+1",
+                   (identity, hour, kind))
+        return True
+
+    @staticmethod
+    def _retry_delay(attempt: int) -> float:
+        """Return the durable backoff for the just-failed attempt."""
+        return (600, 1200, 2400, 3600)[min(max(int(attempt), 1), 4) - 1]
+
+    def _pending_state(self, db, scope: dict, now: float) -> tuple[list[dict], str]:
+        """Read one complete FIFO batch; a deferred/blocked head stops this scope."""
+        rows = db.execute("SELECT event_id,payload,occurred,received,retry_attempt,next_retry,error,LENGTH(CAST(payload AS BLOB)) payload_bytes "
+            "FROM events WHERE identity=? AND umo=? AND status='pending' "
+            "ORDER BY occurred,received,event_id LIMIT 17",
+            (_identity(scope), scope["umo"])).fetchall()
+        if not rows:
+            return [], "no_change"
+        head = rows[0]
+        if float(head["occurred"]) > now or float(head["received"]) > now:
+            return [], "not_due"
+        if float(head["next_retry"]) > now:
+            return [], "retry_deferred"
+        if str(head["error"]).startswith("oversized_payload_bytes:"):
+            return [], "oversized_blocked"
+        if int(head["payload_bytes"]) > 60000:
+            db.execute("UPDATE events SET error=? WHERE event_id=? AND status='pending'",
+                       (f"oversized_payload_bytes:{int(head['payload_bytes'])}", head["event_id"]))
+            return [], "oversized_blocked"
+
+        isolate = False
+        if str(head["error"]).startswith("validation."):
+            previous = db.execute("SELECT event_ids FROM validation_failures WHERE EXISTS "
+                "(SELECT 1 FROM json_each(event_ids) WHERE value=?) ORDER BY occurred DESC LIMIT 1",
+                (head["event_id"],)).fetchone()
+            failed_ids = set(json.loads(previous[0])) if previous else set()
+            # New evidence may supply the missing execution receipt or a
+            # correction. Keep that dependency closure in the next FIFO batch.
+            isolate = bool(failed_ids and all(row["event_id"] in failed_ids for row in rows))
+        result, size = [], 0
+        for row in rows:
+            if (float(row["occurred"]) > now or float(row["received"]) > now
+                    or float(row["next_retry"]) > now):
+                break
+            if str(row["error"]).startswith("oversized_payload_bytes:"):
+                break
+            payload_bytes = int(row["payload_bytes"])
+            if payload_bytes > 60000:
+                db.execute("UPDATE events SET error=? WHERE event_id=? AND status='pending'",
+                           (f"oversized_payload_bytes:{payload_bytes}", row["event_id"]))
+                break
+            if result and (len(result) >= 16 or size + payload_bytes > 12000):
+                break
+            if not result and payload_bytes > 12000:
+                # Complete oversized-to-target events go alone, never truncated.
+                result.append(json.loads(row["payload"]))
+                break
+            result.append(json.loads(row["payload"]))
+            size += payload_bytes
+            if isolate:
+                # Isolate invalid batches while preserving FIFO and all source
+                # dependencies. A bad model output is not a bad source event.
+                break
+        return result, "ready" if result else "oversized_blocked"
+
+    def _pending(self, db, scope: dict, now: float) -> list[dict]:
+        """Compatibility helper for callers that only need eligible events."""
+        return self._pending_state(db, scope, now)[0]
+
+    def _record_failure(self, events: list[dict], now: float, error: str) -> None:
+        """Persist a bounded retry deadline without resolving any queue item."""
+        if not events:
+            return
+        with self._db() as db:
+            db.execute("INSERT INTO validation_failures VALUES(?,?,?,?)",
+                       (str(uuid.uuid4()), _json([e["event_id"] for e in events]), error[:100], now))
+            for event in events:
+                row = db.execute("SELECT retry_attempt FROM events WHERE event_id=? AND status='pending'",
+                                 (event["event_id"],)).fetchone()
+                if row is None:
+                    continue
+                attempt = int(row[0]) + 1
+                retry_at = now + self._retry_delay(attempt)
+                db.execute("UPDATE events SET retry_attempt=?,next_retry=?,error=? WHERE event_id=? AND status='pending'",
+                           (attempt, retry_at, error[:80], event["event_id"]))
+
+    def _block_policy_refusal(self, events: list[dict]) -> None:
+        """Retain policy-refused evidence outside the automatic inference queue."""
+        if not events:
+            return
+        with self._db() as db:
+            for event in events:
+                db.execute("UPDATE events SET status='blocked_policy',error='policy_refusal' "
+                    "WHERE event_id=? AND status='pending'", (event["event_id"],))
+
+    @staticmethod
+    def _is_policy_refusal(exc: Exception) -> bool:
+        """Match only the provider's explicit PROHIBITED_CONTENT refusal marker."""
+        values = [getattr(exc, name, None) for name in
+                  ("code", "status", "reason", "finish_reason", "block_reason")]
+        for value in values:
+            if value is None:
+                continue
+            name = getattr(value, "name", None)
+            candidates = (str(value), str(name) if name is not None else "")
+            if any(candidate.strip().upper() == "PROHIBITED_CONTENT" for candidate in candidates):
+                return True
+        error_text = str(exc).strip()
+        return (error_text.upper() == "PROHIBITED_CONTENT" or bool(re.search(
+            r"(?:reason|finish_reason|block_reason|code|status)\s*['\"]?\s*[=:]\s*['\"]?PROHIBITED_CONTENT\b",
+            error_text, re.IGNORECASE)))
+
+    def _hourly_event(self, scope: dict, when: float) -> dict:
+        """Reuse the exact first tick bytes for a persona/hour on retries."""
+        event_id = f"life.tick:{_identity(scope)}:{int(when // 3600)}"
+        with self._db() as db:
+            row = db.execute("SELECT payload FROM events WHERE event_id=?", (event_id,)).fetchone()
+            if row:
+                return json.loads(row[0])
+        return {"event_id": event_id, "type": "life.tick", "occurred_at": when, "received_at": when,
+                "scope": scope, "text": "Advance life only until this time, without conversation data.", "fact_kind": "fiction"}
+
+    async def advance(self, events: list[dict], expected_revision: int | None = None, *, _as_of: float | None = None) -> dict:
+        """Advance one scope; inference never holds a database transaction open.
+
+        Cancellation or timeout leaves the queue durable. A concurrent correction
+        invalidates the model result by a final optimistic revision check.
+        """
+        if not events:
+            return {"schema_version": 1, "status": "no_events", "event_impact": "none"}
+        scope = normalize_scope(events[0]["scope"])
+        if any(normalize_scope(event["scope"]) != scope for event in events):
+            raise NarrativeValidationError("a_narrative_batch_must_have_exactly_one_scope", "A narrative batch must have exactly one scope")
+        await self.ingest_events(events)
+        if not self._allowed(scope):
+            return {"schema_version": 1, "status": "unmanaged", "snapshot": {"managed": False}, "event_impact": "none"}
+        identity = _identity(scope)
+        if scope["umo"]:
+            # Advance overdue private-free life to the incoming event boundary
+            # first. Inference below still processes only this conversation.
+            boundary = min(self.clock(), min(_timestamp(event.get("occurred_at", self.clock())) for event in events))
+            with self._db() as db:
+                before = self._snapshot(db, scope, self.clock())
+                life = json.loads(db.execute("SELECT state FROM lives WHERE identity=?", (identity,)).fetchone()[0])
+                due = (before["revision"] > 0 and life["valid_from"] <= boundary
+                       and min(life["valid_until"], life["next_check"]) <= boundary
+                       and not self._paused(db, scope))
+                if expected_revision is not None and expected_revision != before["revision"]:
+                    return self._result("stale", before)
+            if due:
+                global_scope = dict(scope, umo="", platform="")
+                tick = self._hourly_event(global_scope, boundary)
+                result = await self.advance([tick], expected_revision=before["revision"], _as_of=boundary)
+                if result["status"] in {"advanced", "no_change"}:
+                    with self._db() as db:
+                        db.execute("INSERT INTO maintenance VALUES(?,'hourly',?) ON CONFLICT(identity,kind) DO UPDATE SET last=MAX(last,excluded.last)", (identity, boundary))
+                    if expected_revision is not None:
+                        expected_revision = result["snapshot"]["revision"]
+        async with self._locks.setdefault(identity, asyncio.Lock()):
+            now = self.clock() if _as_of is None else min(self.clock(), _as_of)
+            with self._db() as db:
+                snapshot = self._snapshot(db, scope, now)
+                if self._paused(db, scope):
+                    return self._result("paused", snapshot)
+                if expected_revision is not None and expected_revision != snapshot["revision"]:
+                    return self._result("stale", snapshot)
+                pending, queue_status = self._pending_state(db, scope, now)
+                if not pending:
+                    if queue_status == "no_change" and any(db.execute(
+                            "SELECT 1 FROM events WHERE event_id=? AND identity=? AND umo=? AND status='blocked_policy'",
+                            (event["event_id"], identity, scope["umo"])).fetchone() for event in events):
+                        return self._result("policy_refusal", snapshot)
+                    return self._result(queue_status, snapshot)
+                kind = "hourly" if all(event["type"] == "life.tick" for event in pending) else "extra"
+                if not self._reserve(db, identity, kind, now):
+                    return self._result("budget_exhausted", snapshot)
+                life = json.loads(db.execute("SELECT state FROM lives WHERE identity=?", (identity,)).fetchone()[0])
+                diary = [dict(row) for row in db.execute(
+                    "SELECT occurred,text,fact_kind,source_ids FROM diary WHERE identity=? AND umo=? ORDER BY occurred DESC LIMIT 8",
+                    (identity, scope["umo"]))]
+                care_waits = [dict(json.loads(r['payload']), status=r['status']) for r in db.execute(
+                    "SELECT payload,status FROM intents WHERE identity=? AND umo=? ORDER BY updated DESC LIMIT 100",
+                    (identity, scope['umo'])) if json.loads(r['payload']).get('kind') == 'care_wait']
+            china_date = dt.datetime.fromtimestamp(now, CHINA).date()
+            day_end = dt.datetime.combine(china_date + dt.timedelta(days=1), dt.time(), CHINA).timestamp()
+            request = {"schema_version": 1, "scope": scope, "now": now, "day_end": day_end,
+                "local_datetime": dt.datetime.fromtimestamp(now, CHINA).isoformat(),
+                "timezone": "Asia/Shanghai", "local_date": china_date.isoformat(),
+                "plan_window": {"start": now, "end": day_end}, "snapshot": snapshot,
+                "events": pending, "recent_diary": diary, "plan": life["plan"],
+                "needs_daily_plan": life["plan_date"] != china_date.isoformat(),
+                "offline_catchup": bool(life["valid_from"] < now - 7200 and life["valid_from"] > 0)}
+            # Keep earlier scoped affect as attributed evidence, not the next
+            # turn's assumed starting mood. Global life remains authoritative.
+            request["snapshot"] = dict(snapshot, **snapshot.get("global_presentation", {}))
+            participants = {
+                str(e.get("actor_id", ""))
+                for e in pending
+                if e["type"] in {"message.received", "chat.message"}
+            }
+            participants.update(
+                str(e.get("data", {}).get("recipient_user_id", ""))
+                for e in pending
+                if e["type"] == "delivery.success"
+            )
+            request["snapshot"]["humanlike"] = copy.deepcopy(snapshot["humanlike"])
+            request['care_policy'] = {
+                'enabled': scope['umo'] in (self.config.get('contextual_care_sessions', []) or []),
+                'min_wait_seconds': 1800,
+            }
+            request['snapshot']['care_waits'] = [r for r in care_waits
+                                                if r.get('recipient_user_id') in participants]
+            with self._db() as db:
+                failed = db.execute("SELECT error,retry_attempt FROM events WHERE event_id=?",
+                                    (pending[0]["event_id"],)).fetchone()
+            if failed and failed["error"].startswith("validation."):
+                request["previous_validation_failure"] = {
+                    "reason_code": failed["error"], "attempt": failed["retry_attempt"],
+                    "instruction": "Correct this field using only current evidence; omit unsupported effects. no_change is valid."}
+            for key in ("moods", "nicknames"):
+                request["snapshot"]["humanlike"][key] = [
+                    r
+                    for r in snapshot["humanlike"][key]
+                    if r["subject_id"] in participants
+                ]
+            started = time.monotonic()
+            call_id = str(uuid.uuid4())
+            request["inference_call_id"] = call_id
+            try:
+                timeout = max(1.0, min(float(self.config.get("narrative_timeout_seconds", 90)), 90.0))
+                raw = await asyncio.wait_for(self.model(copy.deepcopy(request)), timeout)
+                change = self._validate_change(raw, request)
+            except asyncio.CancelledError:
+                self._call(call_id, identity, scope["umo"], now, started, "cancelled", kind)
+                raise
+            except Exception as exc:
+                if self._is_policy_refusal(exc):
+                    self._call(call_id, identity, scope["umo"], now, started, "policy_refusal", kind)
+                    self._block_policy_refusal(pending)
+                    return self._result("policy_refusal", await self.get_snapshot(scope))
+                requested_status = getattr(exc, "status_code", "")
+                status = requested_status if requested_status == "provider_unavailable" else (
+                    "timeout" if isinstance(exc, TimeoutError) else "invalid")
+                self._call(call_id, identity, scope["umo"], now, started, status, kind)
+                code = "validation." + exc.code if isinstance(exc, NarrativeValidationError) else type(exc).__name__
+                http_status = getattr(exc, "code", None)
+                if type(http_status) is int and 400 <= http_status <= 599:
+                    # Preserve actionable status without logging request bodies,
+                    # provider URLs, credentials or arbitrary error messages.
+                    code = f"provider.http_{http_status}.{type(exc).__name__}"
+                self._record_failure(pending, self.clock(), code)
+                return self._result(status, await self.get_snapshot(scope))
+            # A config switch or unload revokes permission before commit.
+            if not self._allowed(scope):
+                self._call(call_id, identity, scope["umo"], now, started, "unmanaged", kind)
+                return self._result("unmanaged", {"managed": False})
+            try:
+                with self._db() as db:
+                    db.execute("BEGIN IMMEDIATE")
+                    current = self._snapshot(db, scope, self.clock())
+                    if current["revision"] != snapshot["revision"] or self._paused(db, scope):
+                        status = "stale"
+                    else:
+                        self._commit(db, scope, change, pending, now, snapshot["revision"] + 1)
+                        status = "no_change" if change["no_change"] else "advanced"
+                    result = self._snapshot(db, scope, self.clock())
+            except (ValueError, sqlite3.Error) as exc:
+                # A late invalid ownership/transition must roll back the whole
+                # update, leave events queued, and preserve usable prior state.
+                status = "invalid"
+                code = "validation." + exc.code if isinstance(exc, NarrativeValidationError) else type(exc).__name__
+                self._record_failure(pending, self.clock(), code)
+                result = await self.get_snapshot(scope)
+            self._call(call_id, identity, scope["umo"], now, started, status, kind)
+            return self._result(status, result, change["event_impact"] if status != "stale" else "none")
+
+    @staticmethod
+    def _result(status: str, snapshot: dict, impact: str = "none") -> dict:
+        return {"schema_version": 1, "status": status, "snapshot": snapshot, "event_impact": impact}
+
+    def _call(self, call_id: str, identity: str, umo: str, now: float, started: float, status: str, kind: str) -> None:
+        with self._db() as db:
+            db.execute("INSERT INTO calls VALUES(?,?,?,?,?,?,?)", (call_id, identity, umo, now,
+                max(0.0, time.monotonic() - started), status, kind))
+
+    def _sources(self, value: Any, source_map: dict) -> list[str]:
+        if not isinstance(value, list) or not value or len(value) > 50:
+            raise NarrativeValidationError("a_change_requires_source_event_ids", "A change requires source event IDs")
+        if not all(isinstance(item, str) and item in source_map for item in value):
+            raise NarrativeValidationError("changes_may_only_reference_events_in_this_scope", "Changes may only reference events in this scope")
+        return list(dict.fromkeys(value))
+
+    def _validate_change(self, raw: dict, request: dict) -> dict:
+        if not isinstance(raw, dict) or raw.get("schema_version", 1) != 1:
+            raise NarrativeValidationError("unsupported_narrative_response", "Unsupported narrative response")
+        scope, now = request["scope"], request["now"]
+        sources = {event["event_id"]: event for event in request["events"]}
+        no_change = raw.get("no_change", False)
+        if not isinstance(no_change, bool):
+            raise NarrativeValidationError("no_change_must_be_boolean", "no_change must be boolean")
+        impact = raw.get("event_impact", "none")
+        if impact not in {"none", "activity", "commitment", "relationship"}:
+            raise NarrativeValidationError("unsupported_impact", "Unsupported impact")
+        state = raw.get("state", {})
+        if not isinstance(state, dict) or set(state) - {"activity_code", "activity", "availability", "subjective_state", "summary", "valid_until"}:
+            raise NarrativeValidationError("unsupported_state_changes", "Unsupported state changes")
+        clean = {}
+        if "activity_code" in state:
+            if state["activity_code"] not in ACTIVITIES:
+                raise NarrativeValidationError("unknown_activity_code", "Unknown activity code")
+            clean["activity_code"] = state["activity_code"]
+            # Scoped events can project only finite generic activity names, so
+            # private participant names and conversation text cannot leak.
+            clean["activity"] = ACTIVITIES[state["activity_code"]]
+        if "activity" in state and not scope["umo"]:
+            clean["activity"] = _text(state["activity"], 80, "activity")
+        if "availability" in state:
+            if state["availability"] not in AVAILABILITIES:
+                raise NarrativeValidationError("unknown_availability", "Unknown availability")
+            clean["availability"] = state["availability"]
+        for key in ("subjective_state", "summary"):
+            if key in state:
+                clean[key] = _text(state[key], 300, key)
+        valid_until = _timestamp(state.get("valid_until", now + 3600), "valid_until")
+        if not now < valid_until <= now + 86400:
+            raise NarrativeValidationError("state_horizon_must_be_within_the_next_day", "State horizon must be within the next day")
+        clean["valid_until"] = valid_until
+        next_check = _timestamp(raw.get("next_check", now + 3600), "next_check")
+        if not now < next_check <= now + 86400:
+            raise NarrativeValidationError("invalid_next_check_time", "Invalid next check time")
+        diary = []
+        for row in raw.get("diary", []):
+            if not isinstance(row, dict):
+                raise NarrativeValidationError("invalid_diary_entry", "Invalid diary entry")
+            occurred = _timestamp(row.get("occurred_at", now), "diary.occurred_at")
+            if occurred > now or occurred < request["snapshot"].get("narrated_until", request["snapshot"]["valid_from"]):
+                raise NarrativeValidationError("diary_cannot_rewrite_the_past_or_prewrite_the_future", "Diary cannot rewrite the past or prewrite the future")
+            fact_kind = row.get("fact_kind", "fiction" if not scope["umo"] else "subjective")
+            if fact_kind not in FACT_KINDS:
+                raise NarrativeValidationError("invalid_diary_fact_kind", "Invalid diary fact kind")
+            source_ids = self._sources(row.get("source_ids"), sources)
+            if scope["umo"] and fact_kind == "fiction":
+                raise NarrativeValidationError("chat_participants_cannot_be_used_as_fictional_life_actors", "Chat participants cannot be used as fictional life actors")
+            diary_text = _text(row.get("text", ""), 300)
+            # An observed chat event proves its utterance, not the described
+            # world. Verified diary categories accept only exact source quotes,
+            # and the program itself supplies attribution and event type.
+            if fact_kind in {"observation", "receipt"}:
+                if any(sources[source]["fact_kind"] != fact_kind for source in source_ids):
+                    raise NarrativeValidationError("a_diary_cannot_promote_the_evidence_category", "A diary cannot promote the evidence category")
+                if len(source_ids) != 1 or diary_text != sources[source_ids[0]]["text"] or not diary_text:
+                    raise NarrativeValidationError("observed_diary_text_must_be_an_exact_source_quotation", "Observed diary text must be an exact source quotation")
+                event = sources[source_ids[0]]
+                label = "发言记录" if fact_kind == "observation" else "执行回执"
+                diary_text = f"{label}（{event['actor_id'] or event['type']}）：{diary_text}"
+                if len(diary_text) > 300:
+                    raise NarrativeValidationError("attributed_diary_entry_exceeds_its_length_limit", "Attributed diary entry exceeds its length limit")
+            if not scope["umo"] and fact_kind != "fiction" and not all(sources[source]["type"] == "admin.correction" for source in source_ids):
+                raise NarrativeValidationError("global_hourly_diaries_are_explicitly_fictional", "Global hourly diaries are explicitly fictional")
+            diary.append({"occurred_at": occurred, "text": diary_text,
+                          "fact_kind": fact_kind, "source_ids": source_ids})
+        if len(diary) > 4:
+            raise NarrativeValidationError("too_many_diary_entries", "Too many diary entries")
+        commitments = [self._commitment(row, scope, sources, now) for row in raw.get("commitments", [])]
+        intents = [self._intent(row, scope, sources, now) for row in raw.get("contact_intents", [])]
+        for care in raw.get('care_waits', []):
+            intents.append(self._care_wait(care, scope, sources, now))
+        if len(commitments) > 10 or len(intents) > 4:
+            raise NarrativeValidationError("too_many_planned_actions", "Too many planned actions")
+        plan = []
+        if "daily_plan" in raw:
+            if scope["umo"] or not request["needs_daily_plan"]:
+                raise NarrativeValidationError("daily_plans_may_be_created_once_per_day_by_global_life", "Daily plans may be created once per day by global life")
+            for row in raw["daily_plan"]:
+                if not isinstance(row, dict):
+                    raise NarrativeValidationError("invalid_plan", "Invalid plan")
+                start, end = _timestamp(row.get("start")), _timestamp(row.get("end"))
+                day = dt.datetime.fromtimestamp(now, CHINA).date()
+                day_end = dt.datetime.combine(day + dt.timedelta(days=1), dt.time(), CHINA).timestamp()
+                if not now <= start < end <= day_end:
+                    raise NarrativeValidationError("a_daily_plan_must_be_future_only_in_today_s_china_date", "A daily plan must be future-only in today's China date")
+                plan.append({"start": start, "end": end, "activity": _text(row.get("activity", ""), 120), "fact_kind": "plan"})
+            if len(plan) > 12:
+                raise NarrativeValidationError("too_many_daily_plan_entries", "Too many daily plan entries")
+        if no_change and (diary or commitments or intents or any(key != "valid_until" for key in clean)):
+            raise NarrativeValidationError("no_change_cannot_also_declare_effects", "no_change cannot also declare effects")
+        humanlike = self._humanlike_change(raw.get("humanlike", {}), request, sources)
+        if no_change and any(humanlike.values()):
+            raise NarrativeValidationError("no_change_cannot_update_humanlike_state", "no_change cannot update humanlike state")
+        return {
+            "no_change": no_change,
+            "event_impact": impact,
+            "state": clean,
+            "diary": diary,
+            "commitments": commitments,
+            "contact_intents": intents,
+            "next_check": next_check,
+            "daily_plan": plan if "daily_plan" in raw else None,
+            "humanlike": humanlike,
+        }
+
+    def _humanlike_change(self, raw: dict, request: dict, sources: dict) -> dict:
+        """Validate sourced interests, plans, affect and member-bound nicknames.
+
+        Args:
+            raw: Optional incremental model output, never a full replacement.
+            request: Authoritative scope, clock and preceding snapshot.
+            sources: Current batch of attributed events.
+
+        Returns:
+            Validated incremental updates with program-owned timestamps.
+
+        Raises:
+            ValueError: An update lacks evidence, ownership or a bounded horizon.
+        """
+        limits = {"preferences": 8, "goals": 4, "moods": 8, "nicknames": 8}
+        if not isinstance(raw, dict) or set(raw) - set(limits):
+            raise NarrativeValidationError("invalid_humanlike_fields", "Invalid humanlike fields")
+        now, scope = request["now"], request["scope"]
+        result = {}
+        for kind, rows in raw.items():
+            if not isinstance(rows, list) or len(rows) > limits[kind]:
+                raise NarrativeValidationError("humanlike_batch_limit_exceeded", "Humanlike batch limit exceeded")
+            result[kind] = []
+            seen = set()
+            for row in rows:
+                if not isinstance(row, dict):
+                    raise NarrativeValidationError("invalid_humanlike_entry", "Invalid humanlike entry")
+                source_ids = self._sources(row.get("source_ids"), sources)
+                evidence = [sources[sid] for sid in source_ids]
+                allowed_types = {
+                    "message.received",
+                    "chat.message",
+                    "delivery.success",
+                    "life.tick",
+                    "tool.success",
+                    "execution.success",
+                }
+                if any(
+                    e["type"] not in allowed_types
+                    or e.get("data", {}).get("message_origin") == "system_fallback"
+                    for e in evidence
+                ):
+                    raise NarrativeValidationError("humanlike_changes_require_substantive_evidence", "Humanlike changes require substantive evidence")
+                key = "subject_id" if kind in {"moods", "nicknames"} else "id"
+                item_id = _text(row.get(key, ""), 100, key)
+                if not item_id or item_id in seen or item_id in {"bot", "system"}:
+                    raise NarrativeValidationError("invalid_or_duplicate_humanlike_identity", "Invalid or duplicate humanlike identity")
+                seen.add(item_id)
+                item = {key: item_id, "source_ids": source_ids, "updated_at": now}
+                observed_at = min(now, max(e.get("occurred_at", now) for e in evidence))
+                if kind in {"moods", "nicknames"}:
+                    previous = next(
+                        (
+                            p
+                            for p in request["snapshot"]
+                            .get("humanlike", {})
+                            .get(kind, [])
+                            if p.get(key) == item_id
+                        ),
+                        {},
+                    )
+                    if previous.get("updated_at", 0) > observed_at:
+                        continue
+                    item["updated_at"] = observed_at
+                if scope["umo"]:
+                    item["participant_ids"] = sorted(
+                        {
+                            str(e.get("actor_id", ""))
+                            for e in evidence
+                            if e["type"] in {"message.received", "chat.message"}
+                            and e.get("actor_id") not in {None, "", "bot", "system"}
+                        }
+                        | {
+                            str(e["data"]["recipient_user_id"])
+                            for e in evidence
+                            if e["type"] == "delivery.success"
+                            and e.get("data", {}).get("recipient_user_id")
+                        }
+                    )
+                if kind in {"moods", "nicknames"}:
+                    if not scope["umo"]:
+                        raise NarrativeValidationError("member_state_cannot_enter_global_life", "Member state cannot enter global life")
+                    own_messages = [
+                        e
+                        for e in evidence
+                        if e["type"] in {"message.received", "chat.message"}
+                        and e.get("actor_id") == item_id
+                    ]
+                    deliveries = [
+                        e
+                        for e in evidence
+                        if e["type"] == "delivery.success"
+                        and e.get("actor_id") == "bot"
+                        and e.get("data", {}).get("recipient_user_id") == item_id
+                    ]
+                    if len(own_messages) + len(deliveries) != len(evidence):
+                        raise NarrativeValidationError("member_state_requires_exactly_attributed_sources", "Member state requires exactly attributed sources")
+                if kind == "nicknames":
+                    status = row.get("status", "active")
+                    if status not in {"active", "rejected"}:
+                        raise NarrativeValidationError("invalid_nickname_status", "Invalid nickname status")
+                    nickname = _text(row.get("nickname", ""), 24, "nickname")
+                    quote = _text(row.get("evidence_quote", ""), 300, "nickname quote")
+                    if not quote or not any(quote in e["text"] for e in evidence):
+                        raise NarrativeValidationError("nickname_requires_an_exact_evidence_quote", "Nickname requires an exact evidence quote")
+                    if status == "rejected" and not any(
+                        quote in e["text"] for e in own_messages
+                    ):
+                        raise NarrativeValidationError("only_the_member_can_reject_their_nickname", "Only the member can reject their nickname")
+                    if status == "active" and (
+                        not nickname
+                        or nickname not in quote
+                        or any(c in nickname for c in "\n\r\t<>")
+                    ):
+                        raise NarrativeValidationError("nickname_must_occur_in_delivered_or_member_authored_evidence", "Nickname must occur in delivered or member-authored evidence")
+                    if status == "active" and any(
+                        re.fullmatch(
+                            r"(?:别|不要|别再|不要再)叫我"
+                            + re.escape(nickname)
+                            + r"[。.!！,，~～]*",
+                            e["text"].strip(),
+                        )
+                        for e in own_messages
+                    ):
+                        raise NarrativeValidationError("a_nickname_objection_cannot_activate_that_nickname", "A nickname objection cannot activate that nickname")
+                    previous = next(
+                        (
+                            p
+                            for p in request["snapshot"]
+                            .get("humanlike", {})
+                            .get(kind, [])
+                            if p.get(key) == item_id
+                        ),
+                        {},
+                    )
+                    if (
+                        previous.get("status") == "rejected"
+                        and status == "active"
+                        and not any(
+                            quote in e["text"] and nickname in e["text"]
+                            for e in own_messages
+                        )
+                    ):
+                        raise NarrativeValidationError("a_rejected_nickname_needs_a_new_member_request", "A rejected nickname needs a new member request")
+                    item.update(
+                        nickname=nickname,
+                        status=status,
+                        evidence_quote=quote,
+                        fact_kind="observation",
+                    )
+                else:
+                    item["text"] = _text(row.get("text", ""), 120, kind)
+                    if not item["text"]:
+                        raise NarrativeValidationError("humanlike_text_cannot_be_empty", "Humanlike text cannot be empty")
+                    item["fact_kind"] = "plan" if kind == "goals" else "subjective"
+                    if kind == "preferences":
+                        item["status"] = row.get("status", "active")
+                        if item["status"] not in {"active", "removed"}:
+                            raise NarrativeValidationError("invalid_preference_status", "Invalid preference status")
+                    else:
+                        horizon = 3600 if kind == "moods" else 7 * 86400
+                        item["expires_at"] = _timestamp(
+                            row.get(
+                                "expires_at", now + (1800 if kind == "moods" else 86400)
+                            )
+                        )
+                        if not now < item["expires_at"] <= now + horizon:
+                            raise NarrativeValidationError("invalid_humanlike_horizon", "Invalid humanlike horizon")
+                        if kind == "moods":
+                            item["expires_at"] = min(
+                                item["expires_at"], observed_at + 3600
+                            )
+                            if item["expires_at"] <= now:
+                                continue
+                        if kind == "goals":
+                            item["status"] = row.get("status", "planned")
+                            if item["status"] not in {"planned", "done", "dropped"}:
+                                raise NarrativeValidationError("invalid_goal_status", "Invalid goal status")
+                            if (
+                                scope["umo"]
+                                and item["status"] == "done"
+                                and not any(
+                                    e["type"] in {"tool.success", "execution.success"}
+                                    and e.get("data", {}).get("goal_id") == item_id
+                                    for e in evidence
+                                )
+                            ):
+                                raise NarrativeValidationError("a_scoped_goal_needs_its_own_execution_receipt", "A scoped goal needs its own execution receipt")
+                result[kind].append(item)
+        return result
+
+    def _commitment(self, raw: dict, scope: dict, sources: dict, now: float) -> dict:
+        if not scope["umo"] or not isinstance(raw, dict):
+            raise NarrativeValidationError("commitments_require_a_concrete_conversation", "Commitments require a concrete conversation")
+        status = raw.get("status", "proposed")
+        if status not in COMMITMENT_STATUSES:
+            raise NarrativeValidationError("invalid_commitment_status", "Invalid commitment status")
+        source_ids = self._sources(raw.get("source_ids"), sources)
+        kinds = {sources[source]["type"] for source in source_ids}
+        if status == "committed" and "delivery.success" not in kinds:
+            raise NarrativeValidationError("an_unsent_reply_cannot_create_a_committed_promise", "An unsent reply cannot create a committed promise")
+        if status == "completed":
+            item_id = raw.get("commitment_id")
+            matching = [sources[source] for source in source_ids if sources[source]["type"] in {"tool.success", "execution.success"}
+                        and sources[source]["data"].get("effect_confirmed") is True
+                        and (sources[source]["data"].get("commitment_id") == item_id
+                             or item_id in sources[source]["data"].get("completed_commitment_ids", []))]
+            if not item_id or not matching:
+                raise NarrativeValidationError("completed_work_requires_a_matching_confirmed_execution_result", "Completed work requires a matching confirmed execution result")
+        if status == "committed":
+            quote = raw.get("evidence_quote", "")
+            if not isinstance(quote, str) or not quote or not any(
+                sources[source]["type"] == "delivery.success" and quote in sources[source]["text"] for source in source_ids):
+                raise NarrativeValidationError("committed_promise_must_quote_its_actual_delivered_evidence", "Committed promise must quote its actual delivered evidence")
+        item_id = _text(raw.get("commitment_id") or str(uuid.uuid4()), 300, "commitment_id")
+        result = {"schema_version": 1, "commitment_id": item_id, "scope": scope,
+            "description": _text(raw.get("description", ""), 300, "description"), "status": status,
+            "source_ids": source_ids, "created_at": now, "fact_kind": "plan",
+            "participant_ids": sorted({sources[s]['actor_id'] for s in source_ids
+                if sources[s].get('type') in {'message.received','chat.message'} and sources[s].get('actor_id') not in {'','bot','system',None}}
+                | {sources[s]['data']['recipient_user_id'] for s in source_ids
+                   if sources[s].get('type') == 'delivery.success' and sources[s].get('data',{}).get('recipient_user_id')})}
+        for key in ("reminder_id", "evidence_quote"):
+            if raw.get(key):
+                result[key] = _text(raw[key], 300, key)
+        if result.get("reminder_id"):
+            rid = result["reminder_id"]
+            with self._db() as db:
+                verified = any(json.loads(r[0]).get('data', {}).get('reminder_id') == rid and
+                               json.loads(r[0]).get('data', {}).get('effect_kind') == 'reminder.created' and
+                               json.loads(r[0]).get('data', {}).get('effect_confirmed') is True
+                               for r in db.execute("SELECT payload FROM events WHERE identity=? AND umo=? AND json_extract(payload,'$.type')='execution.success'",
+                                                   (_identity(scope), scope['umo'])))
+            if not verified:
+                raise NarrativeValidationError("reminder_binding_requires_an_owned_creation_receipt", "Reminder binding requires an owned creation receipt")
+        if raw.get("due_at") is not None:
+            result["due_at"] = _timestamp(raw["due_at"], "due_at")
+        return result
+
+    def _intent(self, raw: dict, scope: dict, sources: dict, now: float) -> dict:
+        if not isinstance(raw, dict) or not self.is_managed(scope):
+            raise NarrativeValidationError("contact_intents_require_an_enabled_explicit_conversation", "Contact intents require an enabled explicit conversation")
+        if raw.get("target_umo", scope["umo"]) != scope["umo"]:
+            raise NarrativeValidationError("an_intent_cannot_target_another_conversation", "An intent cannot target another conversation")
+        source_ids = self._sources(raw.get("source_ids"), sources)
+        if all(sources[source]["type"] in {"life.tick", "delivery.failure", "delivery.uncertain"}
+               or (sources[source]["type"] == "delivery.success" and sources[source]["data"].get("intent_id"))
+               for source in source_ids):
+            raise NarrativeValidationError("time_or_failed_delivery_alone_is_not_a_contact_reason", "Time or failed delivery alone is not a contact reason")
+        not_before = _timestamp(raw.get("not_before", now), "not_before")
+        expires = _timestamp(raw.get("expires_at", now + 86400), "expires_at")
+        if not now <= not_before < expires <= now + 7 * 86400:
+            raise NarrativeValidationError("invalid_contact_intent_window", "Invalid contact intent window")
+        if raw.get("message") or raw.get("text"):
+            raise NarrativeValidationError("contact_intents_must_not_contain_prewritten_messages", "Contact intents must not contain prewritten messages")
+        result = {"schema_version": 1, "intent_id": _text(raw.get("intent_id") or str(uuid.uuid4()), 300),
+            "scope": copy.deepcopy(scope), "target_umo": scope["umo"],
+            "reason": _text(raw.get("reason", ""), 300, "reason"), "source_ids": source_ids,
+            "not_before": not_before, "expires_at": expires, "status": "pending", "created_at": now}
+        if not result["reason"]:
+            raise NarrativeValidationError("intent_reason_is_required", "Intent reason is required")
+        for key in ("commitment_id", "reminder_id"):
+            if raw.get(key):
+                result[key] = _text(raw[key], 300, key)
+        return result
+
+    def _care_wait(self, raw, scope, sources, now):
+        """A member's actual addressed statement authorizes one delayed check-in."""
+        if scope['umo'] not in (self.config.get('contextual_care_sessions', []) or []):
+            raise NarrativeValidationError("contextual_care_disabled_for_this_conversation", "Contextual care disabled for this conversation")
+        if not isinstance(raw, dict):
+            raise NarrativeValidationError("invalid_care_wait", "Invalid care wait")
+        uid = _text(raw.get('subject_id', ''), 300, 'subject_id')
+        if not uid or uid in {'bot', 'system'}:
+            raise NarrativeValidationError("care_needs_a_concrete_member", "Care needs a concrete member")
+        ids = self._sources(raw.get('source_ids'), sources)
+        quote = _text(raw.get('evidence_quote', ''), 600, 'evidence_quote')
+        evidence = [sources[s] for s in ids if sources[s]['type'] in {'message.received', 'chat.message'}
+                    and sources[s]['actor_id'] == uid and quote and quote in sources[s]['text']
+                    and sources[s].get('data', {}).get('directed_to_bot') is True]
+        if not evidence:
+            raise NarrativeValidationError("care_needs_an_exact_self_authored_addressed_source_quote", "Care needs an exact, self-authored, addressed source quote")
+        source = max(evidence, key=lambda e: (e['occurred_at'], e['received_at']))
+        if source['occurred_at'] < now - 86400:
+            raise NarrativeValidationError("old_queued_evidence_cannot_start_a_new_care_wait", "Old queued evidence cannot start a new care wait")
+        reason_kind = raw.get('reason_kind')
+        if reason_kind not in {'health_concern', 'travel_checkin', 'agreed_checkin'}:
+            raise NarrativeValidationError("ordinary_silence_is_not_a_care_reason", "Ordinary silence is not a care reason")
+        item = self._intent(raw, scope, sources, now)
+        if item['not_before'] < now + 1800:
+            raise NarrativeValidationError("care_must_allow_at_least_thirty_minutes", "Care must allow at least thirty minutes")
+        anchor = _json([_identity(scope), scope['umo'], uid, source['event_id']])
+        item.update(intent_id='care:' + hashlib.sha256(anchor.encode()).hexdigest()[:32],
+                    kind='care_wait', recipient_user_id=uid, reason_kind=reason_kind,
+                    evidence_quote=quote, source_event_id=source['event_id'],
+                    source_occurred_at=source['occurred_at'],
+                    source_message_id=str(source.get('data', {}).get('care_activity_id') or source['source_ids'][0]),
+                    waiting_for=_text(raw.get('waiting_for', ''), 300, 'waiting_for'))
+        return item
+
+    def _cancel_care_on_input(self, db, event, now):
+        if event['type'] not in {'message.received', 'chat.message'} or event['actor_id'] in {'', 'bot', 'system'}:
+            return
+        scope = event['scope']
+        changed = False
+        rows = db.execute("SELECT intent_id,payload FROM intents WHERE identity=? AND umo=? AND status IN ('pending','claimed')",
+                          (_identity(scope), scope['umo'])).fetchall()
+        for row in rows:
+            item = json.loads(row['payload'])
+            if (item.get('kind') != 'care_wait' or item.get('recipient_user_id') != event['actor_id']
+                    or event['event_id'] in item['source_ids']
+                    or event['occurred_at'] < item.get('source_occurred_at', 0)):
+                continue
+            item.update(status='cancelled', resolution='member_returned', resolved_by=event['event_id'])
+            db.execute("UPDATE intents SET status='cancelled',payload=?,updated=? WHERE intent_id=?",
+                       (_json(item), now, row['intent_id']))
+            changed = True
+        if changed:
+            db.execute('UPDATE lives SET revision=revision+1 WHERE identity=?', (_identity(scope),))
+            db.execute('UPDATE scopes SET revision=revision+1 WHERE identity=? AND umo=?', (_identity(scope), scope['umo']))
+
+    def _care_current(self, db, item):
+        if item.get('kind') != 'care_wait':
+            return True
+        scope = item['scope']
+        if scope['umo'] not in (self.config.get('contextual_care_sessions', []) or []):
+            return False
+        presence = db.execute('SELECT value FROM metadata WHERE key=?',
+                              ('care_presence:' + _json([scope['umo'], item['recipient_user_id']]),)).fetchone()
+        if presence:
+            value = json.loads(presence[0])
+            if (value['occurred_at'] >= item['source_occurred_at']
+                    and value['message_id'] != item.get('source_message_id')):
+                return False
+        anchor = db.execute('SELECT rowid FROM events WHERE event_id=?', (item['source_event_id'],)).fetchone()
+        if not anchor:
+            return False
+        for row in db.execute('SELECT payload FROM events WHERE identity=? AND umo=? AND rowid>?',
+                              (_identity(scope), scope['umo'], anchor[0])):
+            event = json.loads(row[0])
+            if (event['type'] in {'message.received', 'chat.message'}
+                    and event['actor_id'] == item['recipient_user_id']
+                    and event['event_id'] not in item['source_ids']
+                    and event['occurred_at'] >= item['source_occurred_at']):
+                return False
+        return True
+
+    def observe_member_activity(self, umo, uid, message_id, occurred_at):
+        """Content-free presence watermark, including inputs that never trigger a reply."""
+        if (umo not in (self.config.get('contextual_care_sessions', []) or [])
+                or not uid or uid in {'bot', 'system'} or not message_id):
+            return {'accepted': False}
+        stamp = min(_timestamp(occurred_at), self.clock())
+        key = 'care_presence:' + _json([umo, str(uid)])
+        with self._db() as db:
+            previous = db.execute('SELECT value FROM metadata WHERE key=?', (key,)).fetchone()
+            if previous and json.loads(previous[0])['occurred_at'] > stamp:
+                return {'accepted': False}
+            value = _json({'occurred_at': stamp, 'message_id': str(message_id)})
+            db.execute('INSERT INTO metadata VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value', (key, value))
+            for row in db.execute("SELECT intent_id,payload FROM intents WHERE umo=? AND status IN ('pending','claimed')", (umo,)).fetchall():
+                item = json.loads(row['payload'])
+                if (item.get('kind') == 'care_wait' and item.get('recipient_user_id') == str(uid)
+                        and not self._care_current(db, item)):
+                    item.update(status='cancelled', resolution='member_returned', resolved_by=str(message_id))
+                    db.execute("UPDATE intents SET status='cancelled',payload=?,updated=? WHERE intent_id=?",
+                               (_json(item), self.clock(), row['intent_id']))
+        return {'accepted': True}
+
+    def _store_commitment(self, db, scope: dict, item: dict) -> None:
+        old = db.execute("SELECT * FROM commitments WHERE commitment_id=?", (item["commitment_id"],)).fetchone()
+        if old and (old["identity"] != _identity(scope) or old["umo"] != scope["umo"]):
+            raise NarrativeValidationError("a_commitment_cannot_change_ownership", "A commitment cannot change ownership")
+        if old:
+            existing = json.loads(old["payload"])
+            if existing["status"] in {"completed", "cancelled", "expired"} and item["status"] != existing["status"]:
+                raise NarrativeValidationError("a_terminal_commitment_cannot_be_reopened", "A terminal commitment cannot be reopened")
+            if existing["status"] == "committed" and item["status"] in {"proposed", "conditional"}:
+                raise NarrativeValidationError("a_confirmed_promise_cannot_be_downgraded_to_an_unsent_proposal", "A confirmed promise cannot be downgraded to an unsent proposal")
+            item["created_at"] = existing["created_at"]
+            item["source_ids"] = list(dict.fromkeys(existing["source_ids"] + item["source_ids"]))
+        db.execute("INSERT INTO commitments VALUES(?,?,?,?,?) ON CONFLICT(commitment_id) DO UPDATE SET payload=excluded.payload,status=excluded.status",
+            (item["commitment_id"], _identity(scope), scope["umo"], _json(item), item["status"]))
+        if item["status"] in {"completed", "cancelled", "expired"}:
+            for row in db.execute("SELECT intent_id,payload,status FROM intents WHERE identity=? AND umo=?",
+                                  (_identity(scope), scope["umo"])):
+                intent = json.loads(row["payload"])
+                if intent.get("commitment_id") == item["commitment_id"] and row["status"] not in TERMINAL_INTENTS:
+                    db.execute("UPDATE intents SET status='cancelled' WHERE intent_id=?", (row["intent_id"],))
+
+    def _commit(self, db, scope: dict, change: dict, events: list[dict], now: float, revision: int) -> None:
+        identity = _identity(scope)
+        life = json.loads(db.execute("SELECT state FROM lives WHERE identity=?", (identity,)).fetchone()[0])
+        old_activity = (life.get("activity_code"), life.get("availability"))
+        old_valid_until = life["valid_until"]
+        previous_revision = db.execute("SELECT revision FROM lives WHERE identity=?", (identity,)).fetchone()[0]
+        life.setdefault("activity_revision", previous_revision)
+        local_row = db.execute("SELECT state,revision FROM scopes WHERE identity=? AND umo=?", (identity, scope["umo"])).fetchone()
+        local = json.loads(local_row[0])
+        source_ids = [event["event_id"] for event in events]
+        target = local if scope["umo"] else life
+        saved = target.setdefault("humanlike", {})
+        for kind, rows in change.get("humanlike", {}).items():
+            bucket = saved.setdefault(kind, {})
+            for item in rows:
+                item_id = item.get("subject_id", item.get("id"))
+                if item.get("status") in {"removed", "dropped"}:
+                    bucket.pop(item_id, None)
+                else:
+                    bucket[item_id] = item
+            if kind in {"goals", "moods"}:
+                saved[kind] = bucket = {
+                    k: v for k, v in bucket.items() if v["expires_at"] > now
+                }
+            # Never evict nickname objections to make room for another name.
+            capacity = {"preferences": 8, "goals": 4, "moods": 128, "nicknames": 1024}[
+                kind
+            ]
+            if len(bucket) > capacity:
+                raise NarrativeValidationError("humanlike_storage_capacity_reached", "Humanlike storage capacity reached")
+        for key, value in change["state"].items():
+            if change["no_change"] and key == 'valid_until' and old_valid_until <= now:
+                # The model saw an unknown/expired snapshot. An empty response
+                # cannot silently resurrect its historical activity or sleep.
+                continue
+            if scope["umo"] and key in {"summary", "subjective_state"}:
+                local[key] = value
+            elif not scope["umo"] or (not change["no_change"] and any(
+                    k in change["state"] for k in ("activity_code", "availability"))):
+                life[key] = value
+        projected = bool(scope["umo"] and not change["no_change"] and
+                         any(k in change["state"] for k in ("activity_code", "availability")))
+        if not scope["umo"] or projected:
+            life.update(valid_from=now, next_check=change["next_check"])
+        if not scope["umo"]:
+            life["narrated_until"] = now
+        else:
+            local["observed_until"] = now
+        if (life.get("activity_code"), life.get("availability")) != old_activity:
+            life["activity_revision"] = revision
+            if (old_activity[1] == "asleep" or old_activity[0] == 'resting') and life.get("activity_started_at") is not None:
+                life["previous_rest_seconds"] = max(0, min(now, old_valid_until) - life["activity_started_at"])
+            life["activity_started_at"] = now
+        elif not scope["umo"] and not change["no_change"] and "activity_code" in change["state"]:
+            life.setdefault("activity_started_at", now)
+        if scope["umo"]:
+            if any(key in change["state"] for key in ("summary", "subjective_state")):
+                # A partial new presentation must not inherit the old speaker's
+                # other field and relabel it with this batch's sources.
+                for key in ("summary", "subjective_state"):
+                    if key not in change["state"]:
+                        local[key] = ""
+                local["source_ids"] = source_ids
+                local["activity_revision"] = life["activity_revision"]
+                local["valid_until"] = min(float(life["valid_until"]), now + 600)
+                local["occurred_at"] = now
+                local["participant_ids"] = sorted({str(e.get("actor_id")) for e in events
+                    if e.get("type") in {"message.received", "chat.message"} and e.get("actor_id") not in {None,"","bot","system"}} |
+                    {str(e.get("data",{}).get("recipient_user_id")) for e in events if e.get("type") == "delivery.success"
+                     and e.get("data",{}).get("recipient_user_id")})
+            # Global state keeps no private source IDs, text, names or summaries.
+        else:
+            life["source_ids"] = source_ids
+        if change["daily_plan"] is not None:
+            life["plan"] = change["daily_plan"]
+            life["plan_date"] = dt.datetime.fromtimestamp(now, CHINA).date().isoformat()
+        db.execute("UPDATE lives SET revision=?,state=?,updated=? WHERE identity=?", (revision, _json(life), now, identity))
+        db.execute("UPDATE scopes SET revision=revision+1,state=? WHERE identity=? AND umo=?", (_json(local), identity, scope["umo"]))
+        for row in change["diary"]:
+            db.execute("INSERT INTO diary VALUES(?,?,?,?,?,?,?,?)", (str(uuid.uuid4()), identity, scope["umo"],
+                row["occurred_at"], row["text"], row["fact_kind"], _json(row["source_ids"]), revision))
+        for item in change["commitments"]:
+            self._store_commitment(db, scope, item)
+        for item in change["contact_intents"]:
+            if not self._care_current(db, item):
+                continue
+            item["revision"] = revision
+            old = db.execute("SELECT identity,umo FROM intents WHERE intent_id=?", (item["intent_id"],)).fetchone()
+            if old and (old[0] != identity or old[1] != scope["umo"]):
+                raise NarrativeValidationError("an_intent_cannot_change_ownership", "An intent cannot change ownership")
+            # Identical source motivation cannot create unlimited follow-ups.
+            duplicates = db.execute("SELECT payload FROM intents WHERE identity=? AND umo=?", (identity, scope["umo"]))
+            if any(json.loads(row[0])["source_ids"] == item["source_ids"] for row in duplicates):
+                continue
+            if item.get("reminder_id"):
+                item["status"] = "cancelled"
+            db.execute("INSERT OR IGNORE INTO intents VALUES(?,?,?,?,?,?,?,?)", (item["intent_id"], identity,
+                scope["umo"], _json(item), item["status"], item["not_before"], item["expires_at"], now))
+        for event in events:
+            db.execute("UPDATE events SET status='processed',error='',retry_attempt=0,next_retry=0 WHERE event_id=?",
+                       (event["event_id"],))
+
+    async def list_due_intents(self, now: float | None = None) -> list[dict]:
+        """Return current pending motivations; caller must claim before sending."""
+        now = self.clock() if now is None else _timestamp(now)
+        result = []
+        with self._db() as db:
+            db.execute("UPDATE intents SET status='expired',updated=? WHERE expires<=? AND status IN ('pending','failed')", (now, now))
+            for row in db.execute("SELECT * FROM intents WHERE status='pending' AND not_before<=? AND expires>? ORDER BY not_before LIMIT 100", (now, now)):
+                item = json.loads(row["payload"])
+                if not self.is_managed(item["scope"]) or self._paused(db, item["scope"]):
+                    continue
+                if self._outreach_paused(db, item["scope"]):
+                    continue
+                if not self._care_current(db, item):
+                    db.execute("UPDATE intents SET status='cancelled',updated=? WHERE intent_id=?", (now, item['intent_id']))
+                    continue
+                item.update(status=row["status"])
+                result.append(item)
+        return result
+
+    async def update_intent(self, intent_id: str, status: str, receipt: dict | None = None) -> dict:
+        """Perform durable intent lifecycle transitions without automatic resends."""
+        if status not in INTENT_STATUSES:
+            raise NarrativeValidationError("unsupported_intent_status", "Unsupported intent status")
+        now = self.clock()
+        with self._db() as db:
+            db.execute("BEGIN IMMEDIATE")
+            row = db.execute("SELECT * FROM intents WHERE intent_id=?", (intent_id,)).fetchone()
+            if not row:
+                return {"schema_version": 1, "status": "missing"}
+            item = json.loads(row["payload"])
+            if row["status"] in TERMINAL_INTENTS:
+                return {"schema_version": 1, "status": row["status"], "changed": False}
+            if status == "claimed":
+                if not self._care_current(db, item):
+                    db.execute("UPDATE intents SET status='cancelled',updated=? WHERE intent_id=?", (now, intent_id))
+                    return {'schema_version': 1, 'status': 'cancelled', 'changed': False}
+                if row["status"] != "pending" or row["not_before"] > now or row["expires"] <= now:
+                    return {"schema_version": 1, "status": row["status"], "changed": False}
+                if not self.is_managed(item["scope"]) or self._paused(db, item["scope"]) or self._outreach_paused(db, item["scope"]):
+                    return {"schema_version": 1, "status": "disabled", "changed": False}
+                if item.get('kind') == 'care_wait':
+                    item['claimed_at'] = now
+            if status == "pending" and row["status"] in {"claimed", "failed"}:
+                raise NarrativeValidationError("a_send_attempt_cannot_automatically_return_to_pending", "A send attempt cannot automatically return to pending")
+            if receipt is not None:
+                item["receipt"] = copy.deepcopy(receipt)
+            item["status"] = status
+            db.execute("UPDATE intents SET payload=?,status=?,updated=? WHERE intent_id=?", (_json(item), status, now, intent_id))
+            return {"schema_version": 1, "status": status, "changed": True, "intent": item}
+
+    async def get_intent(self, intent_id: str) -> dict:
+        """Read one authority record even while it is paused or not yet due."""
+        now = self.clock()
+        with self._db() as db:
+            row = db.execute("SELECT * FROM intents WHERE intent_id=?", (intent_id,)).fetchone()
+            if row is None:
+                return {"schema_version": 1, "available": False, "item": None}
+            status = row["status"]
+            item = json.loads(row['payload'])
+            if status in {'pending', 'claimed'} and not self._care_current(db, item):
+                status = 'cancelled'
+                db.execute("UPDATE intents SET status='cancelled',updated=? WHERE intent_id=?", (now, intent_id))
+            if status in {"pending", "failed"} and row["expires"] <= now:
+                status = "expired"
+                db.execute("UPDATE intents SET status='expired',updated=? WHERE intent_id=?", (now, intent_id))
+            item = json.loads(row["payload"])
+            item.update(status=status, managed=self.is_managed(item["scope"]),
+                        paused=self._paused(db, item["scope"]), outreach_paused=self._outreach_paused(db, item["scope"]))
+            return {"schema_version": 1, "available": True, "item": item}
+
+    async def cancel_intent(self, intent_id: str) -> dict:
+        """Cancel a motivation before sending, preserving its historical record."""
+        return await self.update_intent(intent_id, "cancelled")
+
+    async def set_paused(self, paused: bool, scope: dict | None = None, *, proactive_only: bool = False) -> dict:
+        """Persist global or scoped pause state across plugin reloads."""
+        key = "proactive_paused" if proactive_only else "paused"
+        if scope and not proactive_only:
+            scope = normalize_scope(scope)
+            key += ":" + _identity(scope) + ":" + scope["umo"]
+        with self._db() as db:
+            db.execute("INSERT INTO metadata VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value",
+                (key, "true" if paused else "false"))
+        return {"schema_version": 1, "paused": bool(paused), "proactive_only": proactive_only}
+
+    async def set_outreach_paused(self, paused: bool, scope: dict | None = None) -> dict:
+        """Persist per-UMO outreach pauses independently from narrative progression."""
+        key = "proactive_paused"
+        if scope:
+            scope = normalize_scope(scope)
+            key += ":" + _identity(scope) + ":" + scope["umo"]
+        with self._db() as db:
+            db.execute("INSERT INTO metadata VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value",
+                       (key, "true" if paused else "false"))
+        return {"schema_version": 1, "outreach_paused": bool(paused)}
+
+    async def correct_state(self, scope: dict, patch: dict) -> dict:
+        """Apply an administrator correction as a new, append-only event."""
+        scope, now = normalize_scope(scope), self.clock()
+        if not self._allowed(scope):
+            return self._result("unmanaged", {"managed": False})
+        if not isinstance(patch, dict) or set(patch) - {"activity_code", "activity", "availability", "subjective_state", "summary"}:
+            raise NarrativeValidationError("unsupported_correction_fields", "Unsupported correction fields")
+        manual_activity = _text(patch["activity"], 220, "activity") if "activity" in patch else None
+        patch = {key: value for key, value in patch.items() if key != "activity"}
+        correction_data = dict(patch)
+        if manual_activity is not None:
+            correction_data["activity"] = manual_activity
+        event = {"event_id": "correction:" + str(uuid.uuid4()), "scope": scope, "type": "admin.correction",
+                 "occurred_at": now, "received_at": now, "fact_kind": "observation", "text": "管理员纠正了当前状态。", "data": correction_data}
+        await self.ingest_events([event])
+        # Corrections intentionally do not acquire the model lock, so a stale
+        # in-flight result fails its revision comparison instead of blocking UI.
+        with self._db() as db:
+            db.execute("BEGIN IMMEDIATE")
+            snapshot = self._snapshot(db, scope, now)
+            request = {"scope": scope, "now": now, "snapshot": snapshot, "events": [self._event(event, now)], "needs_daily_plan": False}
+            change = self._validate_change({"state": patch, "diary": [{"text": "管理员纠正了当前状态。",
+                "source_ids": [event["event_id"]], "fact_kind": "observation"}]}, request)
+            self._commit(db, scope, change, request["events"], now, snapshot["revision"] + 1)
+            if manual_activity is not None:
+                identity = _identity(scope)
+                state = json.loads(db.execute("SELECT state FROM lives WHERE identity=?", (identity,)).fetchone()[0])
+                state["activity"] = manual_activity
+                db.execute("UPDATE lives SET state=? WHERE identity=?", (_json(state), identity))
+            return self._result("corrected", self._snapshot(db, scope, now))
+
+    async def get_narrative_admin(self, scope: dict) -> dict:
+        """Return administrator diagnostics for one explicit conversation only."""
+        scope, now = normalize_scope(scope), self.clock()
+        if not self._allowed(scope):
+            return {"schema_version": 1, "managed": False, "available": True, "reason": "not_enabled", "paused": False, "outreach_paused": False}
+        identity = _identity(scope)
+        with self._db() as db:
+            snapshot = self._snapshot(db, scope, now)
+            diary = [dict(row) for row in db.execute("SELECT * FROM diary WHERE identity=? AND umo IN (?, '') ORDER BY occurred DESC LIMIT 100", (identity, scope["umo"]))]
