+            routing = dict(db.execute("SELECT status,COUNT(*) FROM events WHERE identity=? AND umo=? GROUP BY status", (identity, scope['umo'])).fetchall())
+            oldest = db.execute("SELECT MIN(occurred) FROM events WHERE identity=? AND umo=? AND status='pending'", (identity, scope['umo'])).fetchone()[0]
+            retry_due = db.execute("SELECT COUNT(*) FROM events WHERE identity=? AND umo=? AND status='pending' AND next_retry>?",
+                                   (identity, scope['umo'], now)).fetchone()[0]
+            oversized = db.execute("SELECT COUNT(*) FROM events WHERE identity=? AND umo=? AND status='pending' AND error LIKE 'oversized_payload_bytes:%'",
+                                   (identity, scope['umo'])).fetchone()[0]
+            blocked_policy = db.execute("SELECT COUNT(*) FROM events WHERE identity=? AND umo=? AND status='blocked_policy'",
+                                        (identity, scope['umo'])).fetchone()[0]
+            queue_head = db.execute("SELECT retry_attempt,next_retry,error,LENGTH(CAST(payload AS BLOB)) payload_bytes "
+                "FROM events WHERE identity=? AND umo=? AND status='pending' ORDER BY occurred,received,event_id LIMIT 1",
+                (identity, scope['umo'])).fetchone()
