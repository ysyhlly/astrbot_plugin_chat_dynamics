+"""Back up and archive legacy life files without enabling narrative or sending.
+
+Run with explicit paths: python migrate_narrative.py --source /data/life_state.json
+--database /data/narrative.sqlite3. Repeated imports are hash-idempotent.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from core.narrative import NarrativeEngine
+
+
+async def _unused_model(request):
+    raise RuntimeError("Migration cannot invoke a provider")
+
+
+def main() -> None:
+    """Migrate exact source bytes into an independent narrative archive."""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, required=True)
+    parser.add_argument("--database", type=Path, required=True)
+    args = parser.parse_args()
+    engine = NarrativeEngine(args.database, {"mode": "legacy"}, _unused_model)
+    result = engine.migrate_legacy(args.source)
+    print(json.dumps(result, ensure_ascii=False, indent=2))
+
+
+if __name__ == "__main__":
+    main()
