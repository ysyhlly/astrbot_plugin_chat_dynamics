+"""Keep narrative characters' core personas outside automatic learning writes."""
+
+from .persona_selection import get_persona_identifier, resolve_target_persona
+
+
+def locked_persona_ids(config) -> set[str]:
+    """Combine explicit configuration and characters registered by the bridge."""
+    configured = getattr(config, "managed_persona_ids", [])
+    runtime = getattr(config, "_narrative_runtime_persona_ids", set())
+    return {str(value) for value in [*(configured if isinstance(configured, list) else []),
+                                    *(runtime if isinstance(runtime, set) else [])]}
+
+
+def register_managed_persona(config, persona_id: str, umo: str = "") -> None:
+    ids = locked_persona_ids(config)
+    ids.add(str(persona_id))
+    object.__setattr__(config, "_narrative_runtime_persona_ids", ids)
+    if umo:
+        origins = getattr(config, "_narrative_runtime_origins", set())
+        origins = set(origins) if isinstance(origins, set) else set()
+        origins.add(umo)
+        object.__setattr__(config, "_narrative_runtime_origins", origins)
+
+
+async def is_managed_target(config, context, umo: str, persona_id: str = "") -> bool:
+    """Resolve again at the writer boundary, including background work."""
+    locked = locked_persona_ids(config)
+    if not locked:
+        return False
+    if umo in getattr(config, "_narrative_runtime_origins", set()):
+        return True
+    if persona_id in locked:
+        return True
+    try:
+        persona = await resolve_target_persona(context.persona_manager, config, umo, require_existing=True)
+    except Exception:
+        # Do not alter a core persona when its identity cannot be determined.
+        return True
+    return not persona or get_persona_identifier(persona) in locked
