+    async def migrate_affection(self, config) -> None:
+        """Backfill legacy scores without changing their relationship value.
+
+        Args:
+            config: Current plugin configuration with the growth interval.
+
+        Raises:
+            ValueError: If a legacy score cannot fit persistent experience.
+        """
+        try:
+            from ...models.orm.affection import UserAffection
+            from ...utils.affection_math import AFFECTION_RULE_VERSION, affection_experience
+        except ImportError:
+            from models.orm.affection import UserAffection
+            from utils.affection_math import AFFECTION_RULE_VERSION, affection_experience
+        from sqlalchemy import select, update
+        from sqlalchemy.orm import noload
+
+        last_id = 0
+        migrated = 0
+        while True:
+            async with self.get_session() as session:
+                rows = (
+                    (
+                        await session.execute(
+                            select(UserAffection)
+                            .options(noload(UserAffection.interactions))
+                            .where(
+                                UserAffection.id > last_id, UserAffection.affection_exp.is_(None)
+                            )
+                            .order_by(UserAffection.id)
+                            .limit(200)
+                        )
+                    )
+                    .scalars()
+                    .all()
+                )
+                if not rows:
+                    break
+                for row in rows:
+                    xp = affection_experience(
+                        max(0, row.affection_level), config.affection_growth_interval
+                    )
+                    result = await session.execute(
+                        update(UserAffection)
+                        .where(UserAffection.id == row.id, UserAffection.affection_exp.is_(None))
+                        .values(
+                            affection_exp=str(xp),
+                            affection_growth_interval=str(config.affection_growth_interval),
+                            affection_rule_version=AFFECTION_RULE_VERSION,
+                        )
+                        .execution_options(synchronize_session=False)
+                    )
+                    migrated += result.rowcount
+                last_id = rows[-1].id
+                await session.commit()
+        if migrated:
+            logger.info(f"Migrated {migrated} legacy affection rows to uncapped experience")
+
