+"""Plugin-owned metadata for conservative expression-candidate review.
+
+The sidecar intentionally stores IDs and review state only. Candidate text stays
+in the existing expression table, and role-card text is never persisted here.
+"""
+
+import json
+import sqlite3
+import time
+from contextlib import closing
+from pathlib import Path
+
+
+_FIELDS = (
+    "candidate_kind", "source_kind", "source_event_refs", "source_evidence_ids",
+    "generated_against_card_version", "compatibility_status",
+    "compatibility_checked_version", "status", "revision",
+    "operator_approval_id",
+)
+
+
+class StyleCandidateReviewStore:
+    def __init__(self, path):
+        self.path = Path(path)
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        with closing(self._connect()) as db, db:
+            db.execute("""
+                CREATE TABLE IF NOT EXISTS style_candidate_review (
+                    scope_key TEXT NOT NULL,
+                    expression_id TEXT NOT NULL,
+                    candidate_kind TEXT NOT NULL DEFAULT 'unknown',
+                    source_kind TEXT NOT NULL DEFAULT 'unknown',
+                    source_event_refs TEXT NOT NULL DEFAULT '[]',
+                    source_evidence_ids TEXT NOT NULL DEFAULT '[]',
+                    generated_against_card_version TEXT NOT NULL DEFAULT '',
+                    compatibility_status TEXT NOT NULL DEFAULT 'unknown',
+                    compatibility_checked_version TEXT NOT NULL DEFAULT '',
+                    status TEXT NOT NULL DEFAULT 'pending_unknown',
+                    revision INTEGER NOT NULL DEFAULT 1,
+                    operator_approval_id TEXT NOT NULL DEFAULT '',
+                    updated_at REAL NOT NULL,
+                    PRIMARY KEY (scope_key, expression_id)
+                )
+            """)
+            columns = {row[1] for row in db.execute("PRAGMA table_info(style_candidate_review)")}
+            if "source_event_refs" not in columns:
+                db.execute("ALTER TABLE style_candidate_review ADD COLUMN source_event_refs TEXT NOT NULL DEFAULT '[]'")
+
+    def _connect(self):
+        db = sqlite3.connect(str(self.path), timeout=5.0)
+        db.row_factory = sqlite3.Row
+        return db
+
+    def ensure_pending_unknown(self, scope_key, expression_id):
+        with closing(self._connect()) as db, db:
+            db.execute("""
+                INSERT OR IGNORE INTO style_candidate_review
+                    (scope_key, expression_id, updated_at)
+                VALUES (?, ?, ?)
+            """, (str(scope_key), str(expression_id), time.time()))
+
+    def get(self, scope_key, expression_id):
+        with closing(self._connect()) as db, db:
+            row = db.execute("""
+                SELECT candidate_kind, source_kind, source_event_refs, source_evidence_ids,
+                       generated_against_card_version, compatibility_status,
+                       compatibility_checked_version, status, revision,
+                       operator_approval_id
+                FROM style_candidate_review
+                WHERE scope_key=? AND expression_id=?
+            """, (str(scope_key), str(expression_id))).fetchone()
+        if row is None:
+            return None
+        result = dict(row)
+        for field in ("source_event_refs", "source_evidence_ids"):
+            try:
+                result[field] = json.loads(result[field])
+            except (TypeError, ValueError):
+                result[field] = []
+        result["checked_version"] = result["compatibility_checked_version"]
+        return result
+
+    @staticmethod
+    def _valid_event_refs(scope_key, refs):
+        return bool(refs) and all(
+            isinstance(ref, dict)
+            and ref.get("event_type") == "message.received"
+            and ref.get("scope_key") == str(scope_key)
+            and bool(str(ref.get("source_event_id") or "").strip())
+            and bool(str(ref.get("actor_id") or "").strip())
+            and ref.get("actor_id") != "bot"
+            for ref in refs
+        )
+
+    def register_candidate(self, scope_key, expression_id, *, source_event_refs=(),
+                           generated_against_card_version=""):
+        refs_by_id = {
+            str(ref.get("source_event_id")): dict(ref)
+            for ref in (source_event_refs or []) if isinstance(ref, dict)
+        }
+        refs = list(refs_by_id.values())
+        if not self._valid_event_refs(scope_key, refs):
+            with closing(self._connect()) as db, db:
+                db.execute("""
+                    INSERT INTO style_candidate_review (
+                        scope_key, expression_id, updated_at
+                    ) VALUES (?, ?, ?)
+                    ON CONFLICT(scope_key, expression_id) DO UPDATE SET
+                        candidate_kind='unknown', source_kind='unknown',
+                        source_event_refs='[]', source_evidence_ids='[]',
+                        generated_against_card_version='', compatibility_status='unknown',
+                        compatibility_checked_version='', status='pending_unknown',
+                        revision=style_candidate_review.revision+1,
+                        operator_approval_id='', updated_at=excluded.updated_at
+                """, (str(scope_key), str(expression_id), time.time()))
+            return self.get(scope_key, expression_id)
+        with closing(self._connect()) as db, db:
+            db.execute("""
+                INSERT INTO style_candidate_review (
+                    scope_key, expression_id, candidate_kind, source_kind,
+                    source_event_refs, source_evidence_ids, generated_against_card_version,
+                    compatibility_status, compatibility_checked_version,
+                    status, revision, updated_at
+                ) VALUES (?, ?, 'unknown', 'user_evidence', ?, '[]', ?, 'pending', '',
