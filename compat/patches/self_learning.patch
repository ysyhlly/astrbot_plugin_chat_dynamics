+"""Ground positive experience in the currently bound character, not chat labels."""
+import asyncio
+import json
+import math
+from .command_scope import provider
+
+
+def _character_from_card(card, expected_scope):
+    from .llm_affection import require_character_context
+    if not isinstance(card, dict) or not card.get("available") or card.get("disabled"):
+        return None
+    scope = card.get("scope")
+    fields = ("platform", "umo", "persona_id", "instance_id")
+    if not isinstance(scope, dict) or any(not isinstance(scope.get(k), str) or not scope[k].strip() for k in fields):
+        return None
+    if any(scope.get(k) != value for k, value in expected_scope.items() if k in fields):
+        return None
+    character = {"core_prompt": card.get("core_prompt"), "fingerprint": card.get("fingerprint"),
+                 "persona_id": scope["persona_id"]}
+    try:
+        return require_character_context(character)
+    except ValueError:
+        return None
+
+
+async def character_for_score(context, scope):
+    if not isinstance(scope, dict) or any(not isinstance(scope.get(k), str) or not scope[k].strip()
+                                        for k in ("platform", "umo", "persona_id", "instance_id")):
+        return None
+    owner = provider(context, 'worldbook')
+    if owner is None:
+        return None
+    card = await asyncio.wait_for(owner.get_character_context(scope), 2)
+    return _character_from_card(card, scope)
+
+
+async def character_for_event(context, event):
+    """Resolve only the persona bound to this exact native event/session."""
+    owner = provider(context, 'worldbook')
+    if owner is None:
+        return None
+    umo = getattr(event, "unified_msg_origin", None)
+    if not isinstance(umo, str) or not umo.strip() or len(umo.rsplit(":", 2)) != 3:
+        return None
+    platform = umo.split(":", 1)[0]
+    seed = {"platform": platform, "umo": umo, "persona_id": "", "instance_id": ""}
+    card = await asyncio.wait_for(owner.get_character_context(seed, event), 2)
+    return _character_from_card(card, {"platform": platform, "umo": umo})
+
+
+# Retain legacy award-key decoding for historical records; live scoring uses llm_affection.
+
+def award_key(reason):
+    if not isinstance(reason,str) or not reason.startswith('persona_award:'):
+        return None
+    try:
+        value,_=json.JSONDecoder().raw_decode(reason[len('persona_award:'):])
+        key=value.get('message_key')
+        return key if isinstance(key,str) and len(key)==64 else None
+    except (ValueError,AttributeError):
+        return None
+
+
+def anan_stage(score):
+    try:
+        score=float(score)
+    except (TypeError, ValueError):
+        return '好感未知，不推断关系阶段。'
+    if not math.isfinite(score) or score < 0:
+        return '好感未知，不推断关系阶段。'
+    for limit, text in (
+        (20, '试探：围绕具体兴趣交流，保留心事，可以好奇和接受善意。'),
+        (40, '熟悉：分享小成绩和想法，想被注意，显出小得意与偏爱。'),
+        (60, '信任：愿意展示不完美、承认不安，仍可能任性和误会。'),
+        (100, '安心：更直接表达想要与拒绝，逐渐容许快乐和意见不同。'),
+        (float('inf'), '稳定亲近：自然偏爱、分享与争论，能安心分开，不需不断证明关系。'),
+    ):
+        if score < limit:
+            return '按当前好感直接采用关系与安心阶段：'+text+'无需额外经历门槛；不得补写历史、自动同意亲密或抹去核心性格。'
