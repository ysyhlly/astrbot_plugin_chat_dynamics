+"""Uncapped affection growth and shared relationship-expression guidance."""
+
+from decimal import Decimal, InvalidOperation, localcontext
+import math
+from typing import Any, Mapping
+from .reciprocal_affection import perceived_snapshot, relationship_expression
+
+REFERENCE_AFFECTION = 100
+AFFECTION_RULE_VERSION = 1
+EXPERIENCE_QUANTUM = Decimal("0.000000000001")
+MAX_EXPERIENCE = Decimal("99999999999999999999999999.999999999999")
+
+
+def _decimal(value: Any, name: str) -> Decimal:
+    """Validate a finite numeric value.
+
+    Args:
+        value: Numeric input.
+        name: Field name used in validation errors.
+
+    Returns:
+        The finite decimal value.
+
+    Raises:
+        ValueError: If the input is not a finite number.
+    """
+    if isinstance(value, bool) or not isinstance(value, (int, float, str, Decimal)):
+        raise ValueError(f"{name} must be a finite number")
+    try:
+        result = Decimal(str(value))
+    except InvalidOperation as exc:
+        raise ValueError(f"{name} must be a finite number") from exc
+    if not result.is_finite():
+        raise ValueError(f"{name} must be a finite number")
+    return result
+
+
+def canonical_experience(value: Any) -> Decimal:
+    """Validate and quantize persistent experience without a score cap.
+
+    Args:
+        value: Nonnegative accumulated experience.
+
+    Returns:
+        Experience with twelve decimal places.
+
+    Raises:
+        ValueError: If the value exceeds storage capacity or is negative.
+    """
+    result = _decimal(value, "affection_exp")
+    if result < 0 or result > MAX_EXPERIENCE:
+        raise ValueError("Affection experience exceeds storage capacity")
+    with localcontext() as ctx:
+        ctx.prec = 64
+        return result.quantize(EXPERIENCE_QUANTUM)
+
+
+def affection_experience(level: Any, interval: Any = 20) -> Decimal:
+    """Convert an affection score to equivalent accumulated experience.
+
+    Args:
+        level: Nonnegative affection score; scores above 100 are supported.
+        interval: Score interval at which marginal growth cost doubles.
+
+    Returns:
+        Equivalent experience, rounded to persistent precision.
+
+    Raises:
+        ValueError: If inputs are invalid or exceed numeric capacity.
+    """
+    score = _decimal(level, "affection_level")
+    step = _decimal(interval, "affection_growth_interval")
+    if score < 0 or step <= 0:
+        raise ValueError("Affection level must be nonnegative and interval positive")
+    with localcontext() as ctx:
+        ctx.prec = 64
+        ln2 = Decimal(2).ln()
+        exponent = score / step * ln2
+        if exponent > (1 + MAX_EXPERIENCE * ln2 / step).ln():
+            raise ValueError("Affection experience exceeds storage capacity")
+        return canonical_experience(step / ln2 * (exponent.exp() - 1))
+
+
+def affection_level(experience: Any, interval: Any = 20) -> Decimal:
+    """Recover a precise affection score from persisted experience.
+
+    Args:
+        experience: Accumulated experience.
+        interval: Growth interval associated with that experience.
+
+    Returns:
+        A nonnegative score without a 100-point ceiling.
+
+    Raises:
+        ValueError: If experience or interval is invalid.
+    """
+    xp = canonical_experience(experience)
+    step = _decimal(interval, "affection_growth_interval")
+    if step <= 0:
+        raise ValueError("Affection growth interval must be positive")
+    with localcontext() as ctx:
+        ctx.prec = 64
+        ln2 = Decimal(2).ln()
+        return step / ln2 * (1 + xp * ln2 / step).ln()
+
+
+def affection_snapshot(
+    level: Any = 0,
+    *,
+    experience: Any = None,
+    stored_interval: Any = None,
+    interval: Any = 20,
+    power: Any = 2,
+) -> dict[str, Any]:
+    """Derive uncapped score and power-law influence from one authoritative state.
+
+    Args:
+        level: Legacy score used only when experience has not been migrated.
+        experience: Authoritative persisted experience, if available.
+        stored_interval: Growth interval under which experience was earned.
+        interval: Current growth interval; changing it preserves the score.
+        power: Exponent controlling expression influence.
+
+    Returns:
+        JSON-safe experience, score, growth cost and expression coefficient.
+
+    Raises:
+        ValueError: If the inputs or derived values exceed numeric capacity.
+    """
+    step = _decimal(interval, "affection_growth_interval")
+    exponent = _decimal(power, "affection_influence_power")
+    if step <= 0 or exponent < 1:
+        raise ValueError("Affection interval must be positive and influence power at least one")
+    if experience is None:
+        score = max(Decimal(0), _decimal(level, "affection_level"))
+        xp = affection_experience(score, step)
+    else:
+        xp = canonical_experience(experience)
+        old_step = step if stored_interval is None else _decimal(stored_interval, "stored_interval")
+        score = affection_level(xp, old_step)
+        if old_step != step:
+            xp = affection_experience(score, step)
+    with localcontext() as ctx:
+        ctx.prec = 64
+        try:
+            influence = float((score / REFERENCE_AFFECTION) ** exponent)
+            growth_cost = float((score / step * Decimal(2).ln()).exp())
+        except (InvalidOperation, OverflowError) as exc:
+            raise ValueError("Affection influence exceeds numeric capacity") from exc
+    if not math.isfinite(influence) or not math.isfinite(growth_cost):
+        raise ValueError("Affection influence exceeds numeric capacity")
+    return {
+        "affection_level": float(score),
+        "affection_exp": str(xp),
+        "affection_growth_interval": float(step),
+        "affection_influence_power": float(exponent),
+        "affection_rule_version": AFFECTION_RULE_VERSION,
+        "reference_affection": REFERENCE_AFFECTION,
+        "influence_coefficient": influence,
+        "growth_cost": growth_cost,
+        "max_affection": None,
+    }
+
+
+def format_affection_guidance(data: Mapping[str, Any] | None, config: Any = None) -> str:
+    """Format the same relationship guidance for all reply-generation paths.
+
+    Args:
+        data: Stored or derived affection data, or None for a new user.
+        config: Plugin configuration with optional curve parameters.
+
+    Returns:
+        Chinese guidance for intimacy, care and familiarity during a reply.
+    """
+    data = data or {}
+    from .relationship_stability import format_tone_guidance
+
+    interval = getattr(config, "affection_growth_interval", 20)
+    power = getattr(config, "affection_influence_power", 2)
+    if not isinstance(interval, (int, float, str, Decimal)) or isinstance(interval, bool):
+        interval = 20
+    if not isinstance(power, (int, float, str, Decimal)) or isinstance(power, bool):
+        power = 2
+    state = affection_snapshot(
+        data.get("affection_level", 0),
+        experience=data.get("affection_exp"),
+        stored_interval=data.get("affection_growth_interval"),
+        interval=interval,
+        power=power,
+    )
+    factor = state["influence_coefficient"]
+    enabled = getattr(config, "enable_perceived_affection", True)
+    perception = perceived_snapshot(data, enabled=bool(enabled))
+    expression = relationship_expression(factor, perception)
+    if not enabled:
+        perceived_text = "对方对我的好感感知：功能已关闭。"
+    elif not perception["perceived_affection_known"]:
+        perceived_text = "对方对我的好感感知：暂无足够依据；保持原有表达，不把未知当成讨厌。"
+    else:
+        perceived_text = (
+            f"感受到对方对我的好感: {perception['perceived_affection']:.1f} 点（0–100，判断把握度 "
+            f"{perception['perceived_affection_confidence']:.0%}）；这是根据互动做出的推测，不能当作对方真实想法。"
+        )
+    distance_text = (
+        "对方明确希望保持距离：优先遵循这一偏好，减少亲昵称呼和刻意套近乎；关心围绕当前话题，避免追问近况。"
+        if perception["perceived_affection_distance"]
+        else "若我很在意对方而对方亲近意愿较低，关心保持自然，亲昵表达要克制；对方友好而我尚不熟悉时，友善回应并逐步熟悉。"
+    )
+    return (
+        "【对该用户的关系表达】\n"
+        f"好感度: {state['affection_level']:.3f} 点（100 为参考刻度，可继续增长）\n"
+        f"关系表达影响: {factor:.4g} 倍（相对 100 点）\n"
+        f"{perceived_text}\n"
+        "亲密语气、主动关心、熟悉感的双向关系强度分别为 "
+        f"{expression['intimacy_coefficient']:.4g}、{expression['care_coefficient']:.4g}、{expression['familiarity_coefficient']:.4g} 倍。\n"
+        f"{distance_text}\n"
+        "基本礼貌和正常帮助保持为基线；结合这个强度和现有人格，自然调整亲近语气、"
+        "在本次回复中关心近况、延续共同话题及减少客套。\n"
+        "共同经历以可靠记忆为依据；尊重用户明确的称呼和舒适度偏好，"
+        "玩笑、昵称、撒娇遵循具体语境。此系数是表达强度，保持已有回复决策。"
+        + format_tone_guidance(
+            data, enabled=bool(getattr(config, "enable_relationship_stability", True))
+        )
+    )
