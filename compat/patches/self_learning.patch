+    async def get_verified_narrative_source_refs(self, scope_key_value, event_ids):
+        """Return typed received-event references proven by this plugin's own store."""
+        scope_key_value = str(scope_key_value or "")
+        ids = list(
+            dict.fromkeys(
+                str(value) for value in (event_ids or []) if str(value or "").strip()
+            )
+        )
+        if not scope_key_value or not ids:
+            return []
+        from sqlalchemy import and_, select
+
+        async with self.get_session() as session:
+            stmt = select(NarrativeObservation).where(
+                NarrativeObservation.scope_key == scope_key_value,
+                NarrativeObservation.event_id.in_(ids),
+            )
+            observations = (await session.execute(stmt)).scalars().all()
+            verified = []
+            for observation in observations:
+                try:
+                    envelope = json.loads(observation.envelope)
+                    scope = envelope.get("scope") or {}
+                    event_id = str(envelope.get("event_id") or "")
+                    actor_id = str(envelope.get("actor_id") or "")
+                    if (
+                        envelope.get("schema_version") != 1
+                        or envelope.get("type") != "message.received"
+                        or event_id != observation.event_id
+                        or observation.event_key
+                        != hashlib.sha256(
+                            (scope_key_value + ":" + event_id).encode()
+                        ).hexdigest()
+                        or not actor_id
+                        or actor_id == "bot"
+                        or scope_key(scope) != scope_key_value
+                    ):
+                        continue
+                    raw_stmt = (
+                        select(RawMessage.id)
+                        .where(
+                            and_(
+                                RawMessage.group_id == scope_key_value,
+                                RawMessage.message_id == event_id,
+                                RawMessage.sender_id == actor_id,
+                            )
+                        )
+                        .limit(1)
+                    )
+                    if (await session.execute(raw_stmt)).first() is None:
+                        continue
+                    verified.append(
+                        {
+                            "source_event_id": event_id,
+                            "scope_key": scope_key_value,
+                            "actor_id": actor_id,
+                            "event_type": "message.received",
+                        }
+                    )
+                except (TypeError, ValueError, KeyError):
+                    continue
+        return verified
+
+    async def get_verified_narrative_source_events(self, scope_key_value, event_ids):
+        """Return exact event envelopes only after the same-scope receive proof passes."""
+        refs = await self.get_verified_narrative_source_refs(scope_key_value, event_ids)
+        if not refs:
+            return []
+        ids = [ref["source_event_id"] for ref in refs]
+        verified_ids = {ref["source_event_id"] for ref in refs}
+        async with self.get_session() as session:
+            stmt = select(NarrativeObservation).where(
+                NarrativeObservation.scope_key == str(scope_key_value),
+                NarrativeObservation.event_id.in_(ids),
+            )
+            rows = (await session.execute(stmt)).scalars().all()
+        result = []
+        for row in rows:
+            if row.event_id not in verified_ids:
+                continue
+            try:
+                envelope = json.loads(row.envelope)
+            except (TypeError, ValueError):
+                continue
+            if envelope.get("type") == "message.received":
+                result.append(envelope)
+        return result
+
+    async def observe_narrative_event(self, event: dict) -> bool:
