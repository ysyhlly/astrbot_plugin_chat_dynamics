+"""Evidence-based perception of the user's affection and preferred distance."""
+
+import hashlib
+import math
+import re
+import time
+from typing import Any, Mapping
+
+PERCEPTION_HALF_LIFE = 30 * 86400
+PERCEPTION_PRIOR_WEIGHT = 2.0
+PERCEPTION_MAX_WEIGHT = 12.0
+PERCEPTION_REPEAT_WINDOW = 86400
+PERCEPTION_SIGNALS = {
+    "like": (1.0, 3.0),
+    "warmth": (0.3, 0.5),
+    "dislike": (-1.0, 3.0),
+    # Distance is a preference, not proof of dislike.
+    "distance": (0.0, 0.0),
+    "welcome_closeness": (0.5, 1.5),
+}
+
+
+def normalize_observation(observation: Any, message: str | None = None) -> dict | None:
+    """Validate a grounded observation rather than accepting a model-made score.
+
+    Args:
+        observation: Optional kind, confidence, evidence and source.
+        message: Current message used to verify verbatim evidence when available.
+
+    Returns:
+        A sanitized observation with a deduplication signature, or None.
+    """
+    if not isinstance(observation, Mapping):
+        return None
+    kind = observation.get("kind")
+    confidence = observation.get("confidence")
+    evidence = observation.get("evidence")
+    if (
+        not isinstance(kind, str)
+        or kind not in PERCEPTION_SIGNALS
+        or isinstance(confidence, bool)
+        or not isinstance(confidence, (int, float))
+    ):
+        return None
+    if not math.isfinite(confidence) or not 0.65 <= confidence <= 1:
+        return None
+    if not isinstance(evidence, str) or not 1 <= len(evidence.strip()) <= 160:
+        return None
+    evidence = evidence.strip()
+    if message is not None and evidence not in message:
+        return None
+    if message is not None:
+        unquoted = re.sub(
+            r""""[^"\n]*"|'[^'\n]*'|`[^`\n]*`|“[^”]*”|「[^」]*」|(?:^|\n)>[^\n]*""", "", message
+        )
+        if evidence not in unquoted:
+            return None
+        clauses = re.split(r"(?<=[。！？?!])|\n", unquoted)
+        clause = next((part for part in clauses if evidence in part), "")
+        if re.search(
+            r"[?？]|如果|假如|假设|开玩笑|反话|讽刺|才怪|假的|骗你|逗你|假装|没说|没有说|他说|她说|有人说|别人说|翻译|复读|替我说|帮我说|转述|例如|比如|he said|she said",
+            clause,
+            re.IGNORECASE,
+        ):
+            return None
+        suffix = unquoted[unquoted.find(evidence) + len(evidence) :]
+        if kind in {"like", "dislike"} and (
+            re.search(
+                r"(?:喜欢|讨厌)你(?:这个|这次的|刚才的|现在的|的|写的|做的|说的|给的)(?:回答|建议|说法|语气|昵称|方式|代码|方案|作品)",
+                evidence,
+            )
+            or evidence.endswith("你")
+            and re.match(
+                r"(?:这个|这次的|刚才的|现在的|的|写的|做的|说的|给的)(?:回答|建议|说法|语气|昵称|方式|代码|方案|作品)",
+                suffix,
+            )
+        ):
+            return None
+        if kind == "like" and not re.search(
+            r"喜欢|爱|想你|想念|like|love|miss", evidence, re.IGNORECASE
+        ):
+            return None
+        if kind == "dislike" and not re.search(
+            r"不喜欢|讨厌|烦你|hate|dislike", evidence, re.IGNORECASE
+        ):
+            return None
+        if kind == "distance" and not re.search(
+            r"距离|没那么熟|不熟|套近乎|太亲密|这么亲密", evidence
+        ):
+            return None
+    if observation.get("target", "bot") != "bot":
+        return None
+    signature_text = kind + ":" + re.sub(r"[\W_]+", "", evidence.casefold())
+    return {
+        "kind": kind,
+        "confidence": float(confidence),
+        "evidence": evidence,
+        "source": observation.get("source")
+        if isinstance(observation.get("source"), str)
+        and observation.get("source") in {"llm", "rule"}
+        else "llm",
+        "signature": hashlib.sha256(signature_text.encode()).hexdigest(),
+        "target": "bot",
+    }
+
+
+def rule_observation(message: str) -> dict | None:
+    """Recognize conservative direct signals when structured analysis is unavailable.
+
+    Args:
+        message: Current message directed to the bot.
+
+    Returns:
+        A grounded explicit signal, or None for ordinary or ambiguous messages.
+    """
+    text = str(message or "").strip()
+    # Do not turn reported speech, hypotheticals or questions into user sentiment.
+    if not text or re.search(
+        r'[「」“”"\n]|(?:他说|她说|别人说|有人说|如果|假如|假设|开玩笑|不是|并非|[?？])', text
+    ):
+        return None
+    patterns = (
+        (
+            "distance",
+            r"(?:请(?:你)?保持距离|别(?:再)?套近乎|我们(?:还)?没那么熟|不要(?:再)?太亲密|别这么亲密)",
+        ),
+        (
+            "welcome_closeness",
+            r"(?:不用那么客气|别那么客气|可以亲密(?:一)?点|你可以撒娇|我喜欢你这样叫我)",
+        ),
+        (
+            "dislike",
+            r"(?:我(?:真的|很|非常|越来越)?(?:不喜欢你|讨厌你)|i (?:really )?(?:dislike|hate) you)",
+        ),
+        (
+            "like",
+            r"(?:我(?:真的|很|挺|非常|越来越|还挺)?(?:喜欢你|爱你|喜欢和你聊天)|i (?:really )?(?:like|love) you)",
+        ),
+        ("warmth", r"(?:你(?:真的|真|太|很)?(?:棒|厉害|可爱)|谢谢你|辛苦你了|希望你开心)"),
+    )
+    for kind, pattern in patterns:
+        match = re.search(pattern, text, re.IGNORECASE)
+        if match:
+            return normalize_observation(
+                {"kind": kind, "confidence": 0.9, "evidence": match.group(), "source": "rule"}, text
+            )
+    return None
+
+
+def perceived_snapshot(
+    data: Mapping[str, Any] | None = None, *, now: float | None = None, enabled: bool = True
+) -> dict:
+    """Derive a bounded estimate and confidence without treating silence as rejection.
+
+    Args:
+        data: Persistent evidence sum, weight, timestamp and distance preference.
+        now: Current time; injectable for verification.
+        enabled: Whether perception affects expression.
+
+    Returns:
+        Current perceived affection, confidence and decayed evidence state.
+
+    Raises:
+        ValueError: If stored evidence is not finite or consistent.
+    """
+    data = data or {}
+    raw_total = total = float(data.get("perceived_affection_sum") or 0)
+    raw_weight = weight = float(data.get("perceived_affection_weight") or 0)
+    if (
+        not math.isfinite(total)
+        or not math.isfinite(weight)
+        or weight < 0
+        or weight > PERCEPTION_MAX_WEIGHT + 1e-8
+        or abs(total) > weight + 1e-8
+    ):
+        raise ValueError("Invalid perceived affection evidence")
+    timestamp = data.get("perceived_affection_updated_at")
+    now = time.time() if now is None else now
+    if timestamp is not None:
+        decay = 2 ** (-max(0, now - float(timestamp)) / PERCEPTION_HALF_LIFE)
+        total *= decay
+        weight *= decay
+    confidence = weight / (PERCEPTION_PRIOR_WEIGHT + weight) if enabled else 0.0
+    score = 50 + 50 * total / (PERCEPTION_PRIOR_WEIGHT + weight)
+    return {
+        "perceived_affection": score,
+        "perceived_affection_confidence": confidence,
+        "perceived_affection_known": confidence >= 0.05,
+        "perceived_affection_distance": bool(data.get("perceived_affection_distance"))
+        if enabled
+        else False,
+        "perceived_affection_enabled": bool(enabled),
+        "perceived_affection_sum": raw_total,
+        "perceived_affection_weight": raw_weight,
+        "perceived_affection_updated_at": timestamp,
+    }
+
+
+def update_perception(
+    data: Mapping[str, Any], observation: Mapping[str, Any], *, now: int, add_evidence: bool = True
+) -> dict:
+    """Apply one unique evidence observation to persistent perception.
+
+    Args:
+        data: Persistent or already decayed perception state.
+        observation: Sanitized observation.
+        now: Observation time.
+        add_evidence: False for repeated evidence that only changes a distance preference.
+
+    Returns:
+        New persistent evidence fields.
+    """
+    before = perceived_snapshot(data, now=now)
+    value, strength = PERCEPTION_SIGNALS[observation["kind"]]
+    added = strength * observation["confidence"] if add_evidence else 0
+    timestamp = before["perceived_affection_updated_at"]
+    decay = (
+        1 if timestamp is None else 2 ** (-max(0, now - float(timestamp)) / PERCEPTION_HALF_LIFE)
+    )
+    total = before["perceived_affection_sum"] * decay + value * added
+    weight = before["perceived_affection_weight"] * decay + added
+    if weight > PERCEPTION_MAX_WEIGHT:
+        total *= PERCEPTION_MAX_WEIGHT / weight
+        weight = PERCEPTION_MAX_WEIGHT
+    distance = before["perceived_affection_distance"]
+    if observation["kind"] == "distance":
+        distance = True
+    elif observation["kind"] == "welcome_closeness":
+        distance = False
+    return {
+        "perceived_affection_sum": total,
+        "perceived_affection_weight": weight,
+        "perceived_affection_updated_at": now,
+        "perceived_affection_distance": distance,
+    }
+
+
+def relationship_expression(own_influence: float, perception: Mapping[str, Any]) -> dict:
+    """Combine both directions while retaining baseline help and expressed distance.
+
+    Args:
+        own_influence: Existing uncapped affection influence.
+        perception: Derived perceived affection and confidence.
+
+    Returns:
+        Intimacy, care and familiarity coefficients for reply expression.
+    """
+    mutuality = (
+        perception["perceived_affection_confidence"] * (perception["perceived_affection"] - 50) / 50
+    )
+    intimacy = own_influence * (1 + mutuality)
+    familiarity = intimacy
+    care = own_influence * (1 + 0.5 * max(0, mutuality))
+    if perception["perceived_affection_distance"]:
+        intimacy = min(intimacy, 0.2)
+        familiarity = min(familiarity, 0.2)
+    return {
+        "intimacy_coefficient": intimacy,
+        "care_coefficient": care,
+        "familiarity_coefficient": familiarity,
+    }
