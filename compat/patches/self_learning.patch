+"""Bounded, resumable projection of narrative observation scope metadata."""
+
+import asyncio
+import json
+import time
+
+from sqlalchemy import func, select, update
+from sqlalchemy.exc import IntegrityError, OperationalError, SQLAlchemyError
+
+from ....models.orm.message import NarrativeObservation, NarrativeObservationProjectionState
+from ....utils.narrative_contract import legacy_group_id, scope_key
+
+
+STATE_ID = 1
+PROJECTION_VERSION = 1
+
+
+def _public_state(row):
+    if row is None:
+        return {
+            "status": "pending", "cursor_event_key": None,
+            "high_water_event_key": None, "quarantined_count": 0,
+            "reason": "projection_state_not_initialized",
+        }
+    return {
+        "status": row.status,
+        "cursor_event_key": row.cursor_event_key,
+        "high_water_event_key": row.high_water_event_key,
+        "quarantined_count": int(row.quarantined_count or 0),
+        "reason": "projection_backfill_in_progress" if row.status == "running" else "",
+    }
+
+
+async def projection_status(facade):
+    try:
+        async with facade.get_session() as session:
+            row = await session.get(NarrativeObservationProjectionState, STATE_ID)
+            return _public_state(row)
+    except SQLAlchemyError as exc:
+        detail = str(exc).lower()
+        missing_schema = any(marker in detail for marker in (
+            "no such table", "no such column", "does not exist", "undefined table",
+            "unknown column", "undefined column",
+        ))
+        return {
+            "status": "schema_not_ready" if missing_schema else "unavailable",
+            "cursor_event_key": None, "high_water_event_key": None,
+            "quarantined_count": 0,
+            "reason": "projection_schema_missing" if missing_schema else "projection_status_read_failed",
+        }
+
+
+async def _backfill_projection_chunk_once(facade, batch_size=250):
+    """Project at most one ordered keyset page and checkpoint it atomically."""
+    batch_size = max(1, min(int(batch_size), 1000))
+    async with facade.get_session() as session:
+        state = await session.get(NarrativeObservationProjectionState, STATE_ID)
+        if state is None:
+            high_water = await session.scalar(select(func.max(NarrativeObservation.event_key)))
+            state = NarrativeObservationProjectionState(
+                id=STATE_ID, version=PROJECTION_VERSION,
+                high_water_event_key=high_water, cursor_event_key=None,
+                status="running", quarantined_count=0, updated_at=time.time(),
+            )
+            session.add(state)
+            try:
+                await session.commit()
+            except IntegrityError:
+                await session.rollback()
+                return await projection_status(facade)
+            if not high_water:
+                state.status = "complete"
+                state.updated_at = time.time()
+                await session.commit()
+                return _public_state(state)
+            return _public_state(state)
+
+        if state.version == PROJECTION_VERSION and state.status in {
+            "complete", "complete_with_quarantine",
+        }:
+            return _public_state(state)
+
+        high_water = state.high_water_event_key
+        predicates = [NarrativeObservation.projection_version == 0]
+        if high_water:
+            predicates.append(NarrativeObservation.event_key <= high_water)
+        else:
+            quarantined = await session.scalar(select(func.count()).select_from(
+                NarrativeObservation
+            ).where(NarrativeObservation.projection_version == 2)) or 0
+            state.status = "complete_with_quarantine" if quarantined else "complete"
+            state.updated_at = time.time()
+            await session.commit()
+            return _public_state(state)
+        if state.cursor_event_key:
+            predicates.append(NarrativeObservation.event_key > state.cursor_event_key)
+        rows = (await session.scalars(
+            select(NarrativeObservation)
+            .where(*predicates)
+            .order_by(NarrativeObservation.event_key)
+            .limit(batch_size)
+        )).all()
+
+        if not rows:
+            # Verify the entire high-water range. This also catches keyset gaps
+            # caused by concurrent workers or an interrupted prior transaction.
+            remaining = await session.scalar(select(func.count()).select_from(
+                NarrativeObservation
+            ).where(
+                NarrativeObservation.projection_version == 0,
+                NarrativeObservation.event_key <= high_water,
+            )) or 0
+            if remaining:
+                state.cursor_event_key = None
+                state.status = "running"
+                state.updated_at = time.time()
+                await session.commit()
+                return _public_state(state)
+            state.status = "complete_with_quarantine" if state.quarantined_count else "complete"
+            state.updated_at = time.time()
+            await session.commit()
+            return _public_state(state)
+
+        previous_cursor = state.cursor_event_key
+        quarantined = 0
+        for row in rows:
+            try:
+                envelope = json.loads(row.envelope)
+                raw_scope = envelope.get("scope") if isinstance(envelope, dict) else None
+                if not isinstance(raw_scope, dict):
+                    raise ValueError("missing scope")
+                # Validate both the envelope's scope contract and its identity
+                # against the row key. The latter binds projected group and
+                # cutoff facts to the exact row that carries the envelope.
+                projected_scope_key = scope_key(raw_scope)
+                if projected_scope_key != row.scope_key:
+                    raise ValueError("envelope scope does not match observation row")
+                row.legacy_group_id = legacy_group_id(raw_scope)
+                row.projection_version = PROJECTION_VERSION
+            except (TypeError, ValueError, json.JSONDecodeError):
+                # Keep the envelope queryable by the quarantined-only path. A
+                # malformed row is never silently treated as a confirmed empty.
+                row.legacy_group_id = None
+                row.projection_version = 2
+                quarantined += 1
+
+        last_key = rows[-1].event_key
+        new_quarantined_count = int(state.quarantined_count or 0) + quarantined
+        now = time.time()
+        cursor_predicate = (
+            NarrativeObservationProjectionState.cursor_event_key.is_(None)
+            if previous_cursor is None else
+            NarrativeObservationProjectionState.cursor_event_key == previous_cursor
+        )
+        result = await session.execute(update(NarrativeObservationProjectionState).where(
+            NarrativeObservationProjectionState.id == STATE_ID,
+            cursor_predicate,
+        ).values(
+            cursor_event_key=last_key,
+            quarantined_count=new_quarantined_count,
+            status="running",
+            updated_at=now,
+        ))
+        if result.rowcount != 1:
+            await session.rollback()
+            return await projection_status(facade)
+        state.cursor_event_key = last_key
+        state.quarantined_count = new_quarantined_count
+        state.status = "running"
+        state.updated_at = now
+        try:
+            await session.commit()
+        except OperationalError:
+            await session.rollback()
+            raise
+        return _public_state(state)
+
+
+async def backfill_projection_chunk(facade, batch_size=250):
+    """Retry transient SQLite/MySQL writer contention without losing a checkpoint."""
+    for attempt in range(5):
+        try:
+            return await _backfill_projection_chunk_once(facade, batch_size=batch_size)
+        except OperationalError:
+            if attempt == 4:
+                raise
+            await asyncio.sleep(min(0.01 * (2 ** attempt), 0.2))
