+"""Resolve command targets through live public character and life interfaces."""
+import asyncio
+
+def provider(context, name):
+    catalog = getattr(context, 'get_all_stars', None)
+    if not callable(catalog):
+        return None
+    entries = catalog()
+    entries = entries.items() if isinstance(entries, dict) else (('', item) for item in entries or [])
+    expected = 'astrbot_plugin_' + name
+    for key, item in entries:
+        get = item.get if isinstance(item, dict) else lambda field, default=None: getattr(item, field, default)
+        if not get('activated', True):
+            continue
+        if expected not in (key, get('name'), get('root_dir_name')):
+            continue
+        instance = get('star_cls') or get('star') or get('plugin')
+        if instance is not None and not isinstance(instance, type):
+            return instance
+    return None
+
+async def resolve(plugin, event):
+    umo = str(getattr(event, 'unified_msg_origin', ''))
+    parts = umo.rsplit(':', 2)
+    if len(parts) != 3 or parts[1] != 'GroupMessage':
+        return None
+    world = provider(plugin.context, 'worldbook')
+    life = provider(plugin.context, 'dynamic_life_state')
+    if world is None or life is None:
+        return None
+    character = await asyncio.wait_for(world.get_character_context(
+        {'platform':parts[0], 'umo':umo, 'persona_id':'', 'instance_id':''}, event), 2)
+    if not character or character.get('disabled') or not character.get('available', True):
+        return None
+    scope = character.get('scope') or {}
+    if scope.get('umo') != umo or not plugin._narrative_scope_allowed(scope, event.get_sender_id()):
+        return None
+    snapshot = await asyncio.wait_for(life.get_snapshot(scope), 2)
+    return (scope, life, snapshot) if snapshot.get('managed') else None
