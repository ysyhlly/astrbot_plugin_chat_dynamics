+def _event_message_type_label(event: object) -> str:
+    getter = getattr(event, "get_message_type", None)
+    if not callable(getter):
+        return ""
+    try:
+        value = getter()
+    except Exception:
+        return ""
+    name = getattr(value, "name", "")
+    return f"{name} {value}".strip().casefold()
+
+
+def _is_private_event(event: object) -> bool:
+    label = _event_message_type_label(event)
+    return ("private" in label or "friend" in label) and "group" not in label
+
+
+def _is_group_event(event: object) -> bool:
+    getter = getattr(event, "get_group_id", None)
+    if not callable(getter):
+        return False
+    try:
+        return bool(str(getter() or "").strip())
+    except Exception:
+        return False
+
+
+def _group_source_id(umo: object, platform: object = "") -> str:
+    """Return the group ID only for a canonical, platform-matching group UMO."""
+    text = str(umo or "").strip()
+    parts = text.split(":")
+    if len(parts) < 3 or parts[1].casefold() != "groupmessage":
+        return ""
+    expected_platform = str(platform or "").strip().casefold()
+    if expected_platform and parts[0].casefold() != expected_platform:
+        return ""
+    return ":".join(parts[2:]).strip()
+
+
+def _expression_candidate_is_eligible(candidate: dict, card_version: str) -> bool:
+    """Require semantic, evidence, review, and current-card gates for style use."""
+    current = str(card_version or "").strip()
+    if not current or not isinstance(candidate, dict):
+        return False
+    status = candidate.get("status")
+    if not isinstance(status, str):
+        return False
+    evidence_ids = candidate.get("source_evidence_ids") or []
+    if not isinstance(evidence_ids, (list, tuple)):
+        return False
+    operator_approved = (
+        candidate.get("source_kind") == "operator_approved"
+        and bool(str(candidate.get("operator_approval_id") or "").strip())
+        and not evidence_ids
+        and not (candidate.get("source_event_refs") or [])
+        and status == "approved"
+    )
+    if not evidence_ids and not operator_approved:
+        return False
+    # Only LM-issued evidence identities qualify. Raw message IDs, imported
+    # history IDs, and material-only IDs do not prove a real received event.
+    if evidence_ids and any(
+        not isinstance(ref, str) or not ref.startswith("ev1:") for ref in evidence_ids
+    ):
+        return False
+    source_refs = candidate.get("source_event_refs") or []
+    if operator_approved:
+        source_refs_valid = True
+    else:
+        source_refs_valid = bool(source_refs) and not any(
+            not isinstance(ref, dict)
+            or ref.get("event_type") != "message.received"
+            or not ref.get("source_event_id")
+            or not ref.get("actor_id")
+            for ref in source_refs
+        )
+    if not source_refs_valid:
+        return False
+    checked = (
+        candidate.get("compatibility_checked_version")
+        or candidate.get("checked_version")
+        or ""
+    )
+    return bool(
+        candidate.get("candidate_kind") == "expressive_style"
+        and candidate.get("generated_against_card_version") == current
+        and candidate.get("compatibility_status") == "compatible"
+        and checked == current
+        and status in {"approved", "reviewed"}
+    )
+
+
+def _effective_core_version(character: dict) -> str:
+    """Hash only effective core character material, excluding volatile world hits."""
+    if not isinstance(character, dict):
+        return ""
+    material = {
+        "schema": "effective_core_v1",
+        "card_id": character.get("card_id"),
+        "core_prompt": character.get("core_prompt"),
+        "group_rules": character.get("group_rules"),
+    }
+    if not all(
+        isinstance(material[key], str)
+        for key in ("card_id", "core_prompt", "group_rules")
+    ):
+        return ""
+    canonical = json.dumps(
+        material, sort_keys=True, separators=(",", ":"), ensure_ascii=False
+    )
+    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()
+
