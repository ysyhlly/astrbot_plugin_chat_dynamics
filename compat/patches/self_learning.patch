+"""Conservative, body-only sentiment hints; never mutate relationship state."""
+import re
+
+
+def rule_interaction(message: str) -> str | None:
+    text = str(message or "").strip()
+    # Quoted speech is not the current author's sentiment. Nested platform
+    # quoting is deliberately left unknown rather than partially interpreted.
+    if re.search(r"\[(?:引用|Reply|回复)|[「『“\"]|(?:他说|她说|有人说)", text, re.I):
+        return None
+    text = re.sub(r"\[(?:At|at|CQ:at)[^\]]*\]|@[^\s()（）]+[（(]\d+[)）]|@\d+", " ", text)
+    text = re.sub(r"https?://\S+|(?<!\w)\d{5,}(?!\w)", " ", text).strip().lower()
+    # Mixed, negated and third-party remarks need semantic context. A broad
+    # substring such as 好/6/死/狗 is not evidence of praise or abuse.
+    if re.search(r"(?:不是|并不|没有|别|不要|不太|没那么|不怎么|不喜欢|讨厌)", text):
+        return None
+    praise = r"(?:你|您)?(?:真|真的很|太|很|超级|好)?(?:棒|厉害|可爱|漂亮|优秀|温柔|贴心|聪明)(?:了|啊|呀|呢|喵|哦|～|~|\s)*"
+    clauses = [part.strip() for part in re.split(r"[，,。！!]+", text) if part.strip()]
+    if clauses and all(re.fullmatch(praise, part) for part in clauses):
+        return "compliment"
+    if re.fullmatch(r"(?:谢谢(?:你|您|啦|了)?|感谢(?:你|您)?|多谢|thanks|thx)[！!。～~\s]*", text):
+        return "thanks"
+    if re.fullmatch(r"(?:你好(?:呀|啊)?|早上好|晚上好|早安|晚安|午安|嗨|哈喽|hello|hi)[！!。～~\s]*", text):
+        return "care"
+    if re.fullmatch(r"(?:你(?:是|个|这个|就是)?|滚|去死).*(?:傻逼|蠢货|白痴|废物|垃圾|畜生|去死)|(?:滚|去死)[！!。\s]*", text):
+        return "insult"
+    return None
