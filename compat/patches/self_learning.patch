+    def get_call_statistics(self) -> Dict[str, Any]:
+        """获取调用统计信息"""
+        self._try_lazy_init()
+        stats = {}
+        total_calls = 0
+        total_time = 0
+        total_errors = 0
+        total_timeouts = 0
+        
+        for provider_type, data in self.call_stats.items():
+            calls = data['total_calls']
+            time_spent = data['total_time']
+            errors = data['errors']
+            timeouts = data.get('timeouts', 0)
+            
+            total_calls += calls
+            total_time += time_spent
+            total_errors += errors
+            total_timeouts += timeouts
+            
+            avg_time = (time_spent / calls * 1000) if calls > 0 else 0
+            success_rate = ((calls - errors) / calls) if calls > 0 else 1.0
+            
+            stats[provider_type] = {
+                'total_calls': calls,
+                'avg_response_time_ms': round(avg_time, 2),
+                'success_rate': success_rate,
+                'error_count': errors,
+                'timeout_count': timeouts
+            }
+        
+        # 添加总体统计
+        overall_avg_time = (total_time / total_calls * 1000) if total_calls > 0 else 0
+        overall_success_rate = ((total_calls - total_errors) / total_calls) if total_calls > 0 else 1.0
+        
+        stats['overall'] = {
+            'total_calls': total_calls,
+            'avg_response_time_ms': round(overall_avg_time, 2),
+            'success_rate': overall_success_rate,
+            'error_count': total_errors,
+            'timeout_count': total_timeouts
+        }
+        recent = [
+            entry
+            for entry in self._recent_calls
+            if entry[0] >= time.time() - 900 and entry[3] == self._binding_generation
+        ]
+        stats["overall"]["recent"] = {
+            "window_seconds": 900,
+            "total_calls": len(recent),
+            "error_count": sum(entry[1] for entry in recent),
+            "avg_response_time_ms": round(sum(entry[2] for entry in recent) * 1000 / len(recent), 2)
+            if recent
+            else 0,
+        }
+        issues = dict(self._binding_issues)
+        for role in ("filter", "refine", "reinforce"):
+            if not self.supports_text_chat(getattr(self, f"{role}_provider")):
+                issues.setdefault(role, "text_provider_unavailable")
+        stats["overall"]["binding"] = {
+            "configured_roles": 3 - len(issues),
+            "issues": issues,
+            "generation": self._binding_generation,
+        }
+
+        return stats
