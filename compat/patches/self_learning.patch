+    async def _text_chat_with_rebind_retry(
+        self,
+        provider_attr: str,
+        role_label: str,
+        prompt: str,
+        contexts: List[Dict[str, str]],
+        system_prompt: Optional[str],
+        *,
+        purpose: str = "general",
+        call_timeout: Optional[float] = None,
+        **kwargs,
+    ) -> Optional[LLMResponse]:
+        """Call one role provider under a single deadline.
+
+        Mirrors narrative_affection_chat_completion: the provider coroutine is
+        bounded by asyncio.wait_for and every outcome is logged with the same
+        structured fields (call_id / purpose / provider_id / deadline_s /
+        attempt / elapsed_ms / outcome). The deadline also covers the optional
+        stale-provider rebind retry, so one logical call cannot exceed it.
+        """
+        provider = self._current_registered_provider(provider_attr, role_label)
+        if not self.supports_text_chat(provider):
+            return None
+
+        timeout_seconds = (
+            call_timeout
+            if call_timeout and call_timeout > 0
+            else self._llm_call_timeout_default
+        )
+        deadline = time.monotonic() + timeout_seconds
+        call_id = self._next_call_id(purpose)
+        started = time.monotonic()
+        attempt = 0
+        outcome = "start"
+
+        def _remaining() -> float:
+            return max(0.001, deadline - time.monotonic())
+
+        try:
+            attempt = 1
+            logger.debug(
+                f"[LearningLLM] call_id={call_id} purpose={purpose} "
+                f"provider_id={self._provider_label(provider)} "
+                f"deadline_s={int(timeout_seconds)} attempt={attempt} outcome=start"
+            )
+            try:
+                response = await asyncio.wait_for(
+                    provider.text_chat(
+                        prompt=prompt,
+                        contexts=contexts,
+                        system_prompt=system_prompt,
+                        **kwargs,
+                    ),
+                    timeout=_remaining(),
+                )
+                if self._current_registered_provider(provider_attr, role_label) is not provider:
+                    outcome = "discarded_replaced_provider"
+                    return None
+                outcome = "success" if response else "empty"
+                return response
+            except asyncio.TimeoutError:
+                outcome = "timeout"
+                raise
+            except Exception as exc:
+                outcome = "error"
+                if not self._refresh_provider_bindings_after_error(role_label, exc):
+                    raise
+
+                retry_provider = self._current_registered_provider(provider_attr, role_label)
+                if not retry_provider or retry_provider is provider:
+                    raise
+                if deadline - time.monotonic() <= 0.001:
+                    outcome = "timeout"
+                    raise asyncio.TimeoutError(
+                        f"{role_label} provider retry budget exhausted"
+                    ) from exc
+
+                attempt = 2
+                logger.info(
+                    f"[LearningLLM] call_id={call_id} purpose={purpose} "
+                    f"provider_id={self._provider_label(retry_provider)} "
+                    f"deadline_s={int(timeout_seconds)} attempt={attempt} "
+                    f"outcome=rebind_retry"
+                )
+                try:
+                    response = await asyncio.wait_for(
+                        retry_provider.text_chat(
+                            prompt=prompt,
+                            contexts=contexts,
+                            system_prompt=system_prompt,
+                            **kwargs,
+                        ),
+                        timeout=_remaining(),
+                    )
+                except asyncio.TimeoutError:
+                    outcome = "timeout"
+                    raise
+                except asyncio.CancelledError:
+                    outcome = "cancelled"
+                    raise
+                except Exception:
+                    outcome = "error"
+                    raise
+                if self._current_registered_provider(provider_attr, role_label) is not retry_provider:
+                    outcome = "discarded_replaced_provider"
+                    return None
+                outcome = "success" if response else "empty"
+                return response
+        except asyncio.CancelledError:
+            outcome = "cancelled"
+            raise
+        finally:
+            elapsed_ms = int((time.monotonic() - started) * 1000)
+            fields = (
+                f"call_id={call_id} purpose={purpose} "
+                f"provider_id={self._provider_label(provider)} "
+                f"deadline_s={int(timeout_seconds)} attempt={attempt} "
+                f"outcome={outcome} elapsed_ms={elapsed_ms}"
+            )
+            if outcome in ("timeout", "error"):
+                logger.warning(f"[LearningLLM] {fields}")
+            else:
+                logger.debug(f"[LearningLLM] {fields}")
+
+    @staticmethod
+    def _filter_cache_key(
+        prompt: str,
+        contexts: Optional[List[Dict[str, str]]],
+        system_prompt: Optional[str],
+        kwargs: Dict[str, Any],
+    ) -> str:
+        key_payload = {
+            "prompt": prompt or "",
+            "contexts": contexts or [],
+            "system_prompt": system_prompt or "",
+            "kwargs": {
+                key: value
+                for key, value in sorted(kwargs.items())
+                if key not in {"stream", "timeout", "call_timeout"}
+            },
+        }
+        return hashlib.sha256(repr(key_payload).encode("utf-8", errors="ignore")).hexdigest()
