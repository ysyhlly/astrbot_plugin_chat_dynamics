+    def _queue_expression_candidate_review(self, scope, candidate, card_version):
+        """Schedule bounded semantic/card review only for evidence-backed candidates."""
+        refs = candidate.get("source_event_refs") or []
+        operator_approved = (
+            candidate.get("source_kind") == "operator_approved"
+            and bool(str(candidate.get("operator_approval_id") or "").strip())
+            and not refs
+        )
+        if (
+            not card_version
+            or (not refs and not operator_approved)
+            or any(
+                not isinstance(ref, dict)
+                or ref.get("event_type") != "message.received"
+                or ref.get("scope_key") != scope_key(scope)
+                for ref in refs
+            )
+        ):
+            return
+        checked = (
+            candidate.get("compatibility_checked_version")
+            or candidate.get("checked_version")
+            or ""
+        )
+        if (
+            candidate.get("generated_against_card_version") == card_version
+            and checked == card_version
+            and candidate.get("status") in {"approved", "reviewed"}
+        ):
+            return
+        expression_id = candidate.get("id")
+        if expression_id is None:
+            return
+        key = (scope_key(scope), str(expression_id), str(card_version))
+        now = time.time()
+        inflight = getattr(self, "_style_review_inflight", None)
+        if inflight is None:
+            inflight = self._style_review_inflight = set()
+        retry_after = getattr(self, "_style_review_retry_after", None)
+        if retry_after is None:
+            retry_after = self._style_review_retry_after = {}
+        if key in inflight or retry_after.get(key, 0) > now or len(inflight) >= 4:
+            return
+        task = asyncio.create_task(
+            self._review_expression_candidate(scope, candidate, card_version)
+        )
+        inflight.add(key)
+        task.add_done_callback(lambda _task, k=key: inflight.discard(k))
+        self._track_task(task)
