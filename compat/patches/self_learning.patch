+# --- Single-entry sample evaluation (shared by capture / pipeline / collector) ---
+
+# Keyword names accepted by should_ignore_learning_sample structured branch.
+_METADATA_KWARG_KEYS = frozenset(METADATA_FIELD_NAMES) | {"metadata"}
+
+# Reserved key carrying one evaluation result inside the collector payload dict
+# so the collector does not re-evaluate a sample the pipeline already decided.
+SAMPLE_DECISION_KEY = "_self_learning_sample_decision_v1"
+
+
+@dataclass(frozen=True)
+class LearningSampleDecision:
+    """One sample-filter evaluation, reusable by later pipeline stages.
+
+    The metadata field is the normalized structured metadata that produced the
+    verdict, so downstream stages do not need to extract it again.
+    """
+
+    ignored: bool
+    text: str = ""
+    sender_id: Optional[str] = None
+    metadata: Dict[str, Any] = field(default_factory=dict)
+
+    def matches(self, message_text: Any, sender_id: Optional[str] = None) -> bool:
+        """Return True when this decision was made for the same text/sender."""
+        return _normalize_text(message_text) == self.text and (
+            (sender_id or None) == (self.sender_id or None)
+        )
+
+
+def _metadata_kwargs(metadata: Any) -> Dict[str, Any]:
+    """Keep only the structured fields should_ignore_learning_sample accepts."""
+    if not isinstance(metadata, dict):
+        return {}
+    return {key: metadata[key] for key in _METADATA_KWARG_KEYS if key in metadata}
+
+
+def evaluate_learning_sample(
+    message_text: Any,
+    *,
+    sender_id: Optional[str] = None,
+    is_bot: bool = False,
+    metadata: Any = None,
+    event: Any = None,
+) -> LearningSampleDecision:
+    """Extract metadata and decide once whether a sample is learnable.
+
+    Pass either a raw metadata mapping or an event; when both are given the
+    explicit mapping wins for the keys it provides. The verdict comes from the
+    same should_ignore_learning_sample predicate the callers used before, so
+    results are unchanged - only the number of evaluations drops.
+    """
+    merged: Dict[str, Any] = {}
+    if event is not None:
+        merged.update(extract_learning_event_metadata(event))
+    merged.update(_metadata_kwargs(metadata))
+
+    text = _normalize_text(message_text)
+    ignored = should_ignore_learning_sample(
+        text,
+        sender_id=sender_id,
+        is_bot=is_bot,
+        **merged,
+    )
+    return LearningSampleDecision(
+        ignored=ignored,
+        text=text,
+        sender_id=sender_id,
+        metadata=merged,
+    )
+
+
+def reuse_learning_sample(
+    decision: Optional[LearningSampleDecision],
+    message_text: Any,
+    *,
+    sender_id: Optional[str] = None,
+    is_bot: bool = False,
+    metadata: Any = None,
+    event: Any = None,
+) -> LearningSampleDecision:
+    """Reuse a decision when it was computed for the same text/sender.
+
+    Falls back to a fresh evaluation otherwise, so filtering is never silently
+    skipped when the value is missing or belongs to a different sample.
+    """
+    if decision is not None and decision.matches(message_text, sender_id):
+        return decision
+    return evaluate_learning_sample(
+        message_text,
+        sender_id=sender_id,
+        is_bot=is_bot,
+        metadata=metadata,
+        event=event,
+    )
