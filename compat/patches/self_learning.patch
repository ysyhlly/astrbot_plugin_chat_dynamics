+"""Small validated public data contracts; no dependencies on other plugins."""
+
+import hashlib
+import json
+from datetime import datetime
+
+
+def scope_key(scope: dict) -> str:
+    if not isinstance(scope, dict):
+        raise ValueError("scope must be an object")
+    values = {key: scope.get(key, "") for key in (
+        "platform", "umo", "persona_id", "instance_id"
+    )}
+    if not all(isinstance(value, str) and value.strip() for value in values.values()):
+        raise ValueError("scope requires platform, umo, persona_id and instance_id")
+    values = {key: value.strip() for key, value in values.items()}
+    return "narrative:v1:" + hashlib.sha256(
+        json.dumps(values, sort_keys=True, ensure_ascii=False).encode()
+    ).hexdigest()
+
+
+def legacy_group_id(scope: dict) -> str | None:
+    """Return the legacy bare group id for an exact group scope."""
+    if not isinstance(scope, dict):
+        return None
+    umo = scope.get("umo")
+    if not isinstance(umo, str):
+        return None
+    parts = umo.rsplit(":", 2)
+    if len(parts) != 3 or parts[1] != "GroupMessage":
+        return None
+    group_id = parts[2].strip()
+    return group_id or None
+
+
+def event_timestamp(value) -> float:
+    if isinstance(value, (int, float)):
+        return float(value)
+    return datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp()
+
+
+def is_narrative_event(event) -> bool:
+    getter = getattr(event, "get_extra", None)
+    if not callable(getter):
+        return False
+    return any(isinstance(value, (dict, bool, str, int)) and bool(value)
+               for value in (getter("_narrative_managed_v1"), getter("_narrative_internal_v1")))
