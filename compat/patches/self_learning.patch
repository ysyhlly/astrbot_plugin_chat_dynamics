+"""Validate interaction pairs only against this plugin's own stored observations."""
+import hashlib,json,time,math
+from sqlalchemy import select
+from ....models.orm.affection import NarrativeAffectionJob
+from ....models.orm.message import NarrativeObservation
+from ....utils.narrative_contract import scope_key
+
+
+def job_id(key, source):
+    return hashlib.sha256((key + ':' + source).encode()).hexdigest()
+
+
+async def enqueue(session, event):
+    key = scope_key(event['scope'])
+    candidates = []
+    if event['type'] == 'message.received' and event.get('data', {}).get('directed_to_bot') is True:
+        candidates = [{'source_event_id':event['event_id'], 'actor_id':event['actor_id'],
+                       'basis':'platform_addressed','confidence':1.0}]
+    elif event['type'] == 'delivery.success' and event.get('text') and not event.get('data', {}).get('intent_id'):
+        candidates = event.get('data', {}).get('interaction_evidence', [])[:1]
+    for evidence in candidates:
+        if not isinstance(evidence, dict):continue
+        source, user = evidence.get('source_event_id'), evidence.get('actor_id')
+        confidence = evidence.get('confidence', 0)
+        if (not isinstance(source,str) or not source or not isinstance(user,str) or not user
+                or type(confidence) not in (int,float) or not math.isfinite(confidence) or confidence < .72
+                or evidence.get('basis') not in {'platform_addressed','jev_addressed','confirmed_continuation'}):
+            continue
+        identity=job_id(key,source)
+        existing=await session.get(NarrativeAffectionJob,identity)
+        if existing:
+            continue
+        payload={'scope':event['scope'],'evidence':evidence,
+                 'receipt_event_id':event['event_id'] if event['type']=='delivery.success' else None}
+        now=time.time()
+        session.add(NarrativeAffectionJob(job_id=identity,scope_key=key,source_event_id=source,user_id=user,
+            payload=json.dumps(payload,ensure_ascii=False),status='pending',retry_at=0,created_at=now,updated_at=now))
+
+
+async def validate(session, job):
+    payload=json.loads(job.payload);scope=payload['scope']
+    async def observed(event_id,kind):
+        row=await session.get(NarrativeObservation,job_id(job.scope_key,event_id))
+        if not row:return None
+        e=json.loads(row.envelope)
+        return e if (e.get('type')==kind and all(e.get('scope',{}).get(k)==scope.get(k)
+            for k in ('platform','umo','persona_id','instance_id'))) else None
+    source=await observed(job.source_event_id,'message.received')
+    if not source or source.get('actor_id') != job.user_id:return None
+    if source.get('data',{}).get('directed_to_bot') is True:
+        return source
+    receipt_id=payload.get('receipt_event_id')
+    if not receipt_id:return None
+    receipt=await observed(receipt_id,'delivery.success')
+    if not receipt or not receipt.get('text') or receipt.get('data',{}).get('intent_id'):return None
+    if not 0 <= receipt['occurred_at'] - source['occurred_at'] <= 900:return None
+    evidence=payload['evidence']
+    if evidence not in receipt.get('data',{}).get('interaction_evidence',[]):return None
+    if evidence.get('basis')=='confirmed_continuation':
+        parent_id=evidence.get('parent_receipt_id')
+        parent=await observed(parent_id,'delivery.success') if parent_id else None
+        if not parent or parent.get('data',{}).get('recipient_user_id')!=job.user_id:return None
+        if not 0 <= source['occurred_at']-parent['occurred_at'] <= 600:return None
+    elif evidence.get('basis')!='jev_addressed':
+        return None
+    return source
