+"""Restore evidenced same-group relationship history exactly once."""
+
+import asyncio
+import json
+import time
+from decimal import Decimal
+
+from sqlalchemy import func, select, update
+from sqlalchemy.exc import IntegrityError, OperationalError
+from sqlalchemy.orm import raiseload
+
+from ....models.orm.affection import (
+    AffectionInteraction,
+    NarrativeRelationshipImport,
+    UserAffection,
+)
+from ....models.orm.message import NarrativeObservation, RawMessage
+from ....repositories.affection_repository import AffectionRepository
+from ....utils.affection_math import affection_snapshot, canonical_experience
+from ....utils.narrative_contract import scope_key
+from .narrative_observation_projection import projection_status
+
+
+def _legacy_group(scope):
+    parts = str(scope.get("umo", "")).rsplit(":", 2)
+    if (
+        len(parts) != 3 or parts[1] != "GroupMessage"
+        or scope.get("instance_id") != scope.get("persona_id")
+    ):
+        return None
+    return parts[2]
+
+
+async def restore_many(facade, scope, user_ids):
+    """Restore several participants from one exact-scope indexed evidence read."""
+    key = scope_key(scope)
+    legacy_group = _legacy_group(scope)
+    users = list(dict.fromkeys(str(user_id) for user_id in (user_ids or []) if str(user_id)))
+    if not legacy_group or not users:
+        return {"status": "ready", "restored_ids": [], "pending_ids": []}
+
+    state = await projection_status(facade)
+    if state.get("status") not in {"complete", "complete_with_quarantine"}:
+        status = state.get("status") or "pending"
+        if status == "running":
+            status = "pending"
+        return {"status": status, "reason": state.get("reason") or "projection_backfill", "restored_ids": [],
+                "pending_ids": users}
+
+    marker = f":GroupMessage:{legacy_group}\""
+    for attempt in range(6):
+        try:
+            async with facade.get_session() as session:
+                # Only the small quarantined subset is checked with envelope
+                # matching. Normal observations use the covering typed index.
+                quarantined = await session.scalar(select(func.count()).select_from(
+                    NarrativeObservation
+                ).where(
+                    NarrativeObservation.projection_version == 2,
+                    NarrativeObservation.envelope.contains(marker, autoescape=True),
+                )) or 0
+                if quarantined:
+                    return {"status": "quarantined", "reason": "invalid_observation_envelope",
+                            "restored_ids": [], "pending_ids": users}
+
+                scopes = set((await session.scalars(select(
+                    NarrativeObservation.scope_key
+                ).where(
+                    NarrativeObservation.legacy_group_id == legacy_group,
+                    NarrativeObservation.projection_version == 1,
+                ).distinct())).all())
+                if not scopes or scopes != {key}:
+                    # Match the former behavior: any second scope attached to
+                    # the same bare group ID makes legacy ownership ambiguous.
+                    ambiguous = bool(scopes and scopes != {key})
+                    return {"status": "ambiguous" if ambiguous else "ready",
+                            "reason": "ambiguous_scope" if ambiguous else "no_evidence",
+                            "restored_ids": [], "pending_ids": users if ambiguous else []}
+
+                cutoff_value = await session.scalar(select(func.min(
+                    NarrativeObservation.timestamp
+                )).where(
+                    NarrativeObservation.legacy_group_id == legacy_group,
+                    NarrativeObservation.scope_key == key,
+                    NarrativeObservation.projection_version == 1,
+                ))
+                if cutoff_value is None:
+                    return {"status": "ready", "reason": "no_evidence",
+                            "restored_ids": [], "pending_ids": []}
+                cutoff = int(cutoff_value)
+
+                proof_users = set((await session.scalars(select(
+                    RawMessage.sender_id
+                ).where(
+                    RawMessage.group_id == legacy_group,
+                    RawMessage.sender_id.in_(users),
+                    RawMessage.timestamp < cutoff,
+                ).distinct())).all())
+                if not proof_users:
+                    return {"status": "ready", "reason": "no_pre_cutoff_raw_message",
+                            "restored_ids": [], "pending_ids": []}
+
+                platforms = set((await session.scalars(select(
+                    RawMessage.platform
+                ).where(
+                    RawMessage.group_id == legacy_group,
+                    RawMessage.timestamp < cutoff,
+                ).distinct())).all())
+                if len({platform for platform in platforms if platform}) > 1:
+                    return {"status": "ambiguous", "reason": "ambiguous_platform_history",
+                            "restored_ids": [], "pending_ids": users}
+
+                ledgers = set((await session.scalars(select(
+                    NarrativeRelationshipImport.user_id
+                ).where(
+                    NarrativeRelationshipImport.scope_key == key,
+                    NarrativeRelationshipImport.user_id.in_(users),
+                ))).all())
+                affection_rows = (await session.scalars(select(UserAffection).options(
+                    raiseload(UserAffection.interactions)
+                ).where(
+                    UserAffection.group_id.in_((legacy_group, key)),
+                    UserAffection.user_id.in_(users),
+                ))).all()
+                by_group_user = {(row.group_id, row.user_id): row for row in affection_rows}
+                legacy_rows = {
+                    user_id: by_group_user.get((legacy_group, user_id))
+                    for user_id in proof_users
+                }
+                legacy_ids = [row.id for row in legacy_rows.values() if row is not None]
+                deltas_by_affection = {affection_id: [] for affection_id in legacy_ids}
+                if legacy_ids:
+                    delta_rows = (await session.execute(select(
+                        AffectionInteraction.user_affection_id,
+                        AffectionInteraction.experience_delta,
+                    ).where(
+                        AffectionInteraction.user_affection_id.in_(legacy_ids),
+                        AffectionInteraction.timestamp >= cutoff,
+                    ))).all()
+                    for affection_id, delta in delta_rows:
+                        deltas_by_affection.setdefault(affection_id, []).append(delta)
+
+                repo = AffectionRepository(session)
+                restored = []
+                for user_id in users:
+                    if user_id not in proof_users or user_id in ledgers:
+                        continue
+                    legacy = legacy_rows.get(user_id)
+                    if legacy is None:
+                        continue
+                    deltas = deltas_by_affection.get(legacy.id, [])
+                    if any(delta is None for delta in deltas):
+                        continue  # Never reconstruct from incomplete evidence.
+
+                    old = repo.snapshot(
+                        legacy, facade.config.affection_growth_interval,
+                        facade.config.affection_influence_power,
+                    )
+                    baseline = Decimal(old["affection_exp"]) - sum(
+                        (Decimal(str(delta)) for delta in deltas), Decimal(0)
+                    )
+                    if baseline < 0:
+                        continue
+                    baseline = canonical_experience(baseline)
+
+                    current = by_group_user.get((key, user_id))
+                    if current is None:
+                        current = UserAffection(
+                            group_id=key, user_id=user_id, affection_level=0,
+                            affection_exp="0", affection_revision=0,
+                            affection_growth_interval=str(facade.config.affection_growth_interval),
+                            created_at=int(time.time()), updated_at=int(time.time()),
+                        )
+                        session.add(current)
+                        await session.flush()
+                    before = repo.snapshot(
+                        current, facade.config.affection_growth_interval,
+                        facade.config.affection_influence_power,
+                    )
+                    xp = canonical_experience(Decimal(before["affection_exp"]) + baseline)
+                    derived = affection_snapshot(
+                        experience=xp,
+                        interval=facade.config.affection_growth_interval,
+                        power=facade.config.affection_influence_power,
+                    )
+                    revision = current.affection_revision or 0
+                    result = await session.execute(update(UserAffection).where(
+                        UserAffection.id == current.id,
+                        UserAffection.affection_revision == revision,
+                    ).values(
+                        affection_exp=str(xp),
+                        affection_level=int(derived["affection_level"]),
+                        affection_growth_interval=str(facade.config.affection_growth_interval),
+                        affection_rule_version=1,
+                        affection_revision=revision + 1,
+                    ))
+                    if result.rowcount != 1:
+                        raise RuntimeError("relationship revision conflict")
+                    session.add(NarrativeRelationshipImport(
+                        scope_key=key, user_id=user_id, source_group_id=legacy_group,
+                        source_affection_id=legacy.id, source_cutoff=cutoff,
+                        baseline_exp=str(baseline), imported_at=int(time.time()),
+                    ))
+                    restored.append(user_id)
+
+                await session.commit()
+                return {"status": "ready", "restored_ids": restored, "pending_ids": []}
+        except (IntegrityError, OperationalError, RuntimeError):
+            if attempt == 5:
+                raise
+            await asyncio.sleep(min(0.01 * 2**attempt, 0.2))
+
+
+async def restore(facade, scope, user_id):
+    """Backward-compatible single-user wrapper."""
+    return await restore_many(facade, scope, [user_id])
