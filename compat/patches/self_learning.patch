+"""Separate short-lived feelings from persistent relationship evidence."""
+
+import json
+import math
+import time
+from typing import Any, Mapping
+
+TONE_HALF_LIFE = 1800
+TONE_LIFETIME = 7200
+NEGATIVE_WINDOW = 7 * 86400
+NEGATIVE_EPISODE_GAP = 1800
+LONG_CONFIRMATION_GAP = 6 * 3600
+LONG_NEGATIVE_COOLDOWN = 86400
+PERCEPTION_CONFIRMATION_WINDOW = 14 * 86400
+
+TONE_IMPACTS = {
+    "compliment": 0.25,
+    "praise": 0.25,
+    "thanks": 0.2,
+    "comfort": 0.35,
+    "care": 0.25,
+    "gift": 0.3,
+    "encourage": 0.3,
+    "support": 0.3,
+    "apology": 0.4,
+    "flirt": 0.15,
+    "tease": 0.1,
+    "insult": -0.7,
+    "harassment": -0.8,
+    "abuse": -0.8,
+    "threat": -1.0,
+}
+SIGNAL_VALENCE = {"like": 1, "warmth": 1, "welcome_closeness": 1, "dislike": -1}
+
+
+def tone_snapshot(data: Mapping[str, Any] | None, *, now=None, enabled=True) -> dict:
+    """Read a decaying feeling without modifying persistent relationship scores.
+
+    Args:
+        data: Raw persisted tone and its timestamp.
+        now: Optional clock for deterministic verification.
+        enabled: Whether the temporary feeling participates in expression.
+
+    Returns:
+        Raw state, current feeling and its display label.
+    """
+    data = data or {}
+    raw = float(data.get("relationship_tone") or 0)
+    if not math.isfinite(raw) or not -1 <= raw <= 1:
+        raise ValueError("Invalid relationship tone")
+    timestamp = data.get("relationship_tone_updated_at")
+    now = time.time() if now is None else now
+    age = max(0, now - timestamp) if timestamp is not None else TONE_LIFETIME
+    current = raw * 2 ** (-age / TONE_HALF_LIFE) if enabled and age < TONE_LIFETIME else 0
+    if abs(current) < 0.05:
+        current = 0
+    return {
+        "relationship_tone": raw,
+        "relationship_tone_updated_at": timestamp,
+        "current_relationship_tone": current,
+        "relationship_tone_active": bool(current),
+        "relationship_tone_label": "有些戒备"
+        if current < 0
+        else "感到温暖"
+        if current > 0
+        else "平稳",
+    }
+
+
+def update_tone(
+    data: Mapping[str, Any], interaction: str, observation, *, reliable: bool, now: int
+) -> dict:
+    """Update only this user's immediate feeling from trustworthy input.
+
+    Args:
+        data: Existing raw tone state.
+        interaction: Classified interaction name.
+        observation: Grounded directional relationship evidence, if available.
+        reliable: Whether the interaction came from a valid model result.
+        now: Event timestamp.
+
+    Returns:
+        Fields to persist, or an empty mapping for an ordinary message.
+    """
+    impact = TONE_IMPACTS.get(interaction, 0) if reliable else 0
+    if observation:
+        signal_impact = {"like": 0.3, "warmth": 0.2, "dislike": -0.5, "welcome_closeness": 0.2}.get(
+            observation["kind"], 0
+        )
+        if not impact:
+            impact = signal_impact
+    if not impact:
+        return {}
+    current = tone_snapshot(data, now=now)["current_relationship_tone"]
+    return {
+        "relationship_tone": max(-1, min(1, current * 0.5 + impact)),
+        "relationship_tone_updated_at": now,
+    }
+
+
+def decode_event(value) -> dict:
+    """Decode optional historical metadata while ignoring legacy records.
+
+    Args:
+        value: Stored JSON text or an existing mapping.
+
+    Returns:
+        A metadata mapping, or an empty mapping for legacy/invalid values.
+    """
+    try:
+        result = json.loads(value) if isinstance(value, str) else value
+        return result if isinstance(result, dict) else {}
+    except (ValueError, TypeError):
+        return {}
+
+
+def negative_confirmation(events, *, now: int) -> tuple[bool, bool]:
+    """Require separate episodes across time before one daily long-term deduction.
+
+    Args:
+        events: Timestamp/metadata pairs within the previous seven days.
+        now: Current trustworthy negative interaction time.
+
+    Returns:
+        Whether this is a new episode and whether a long-term deduction is allowed.
+    """
+    episodes = [(stamp, decode_event(event)) for stamp, event in events]
+    episodes = [
+        (stamp, event)
+        for stamp, event in episodes
+        if event.get("negative_episode") and now - NEGATIVE_WINDOW <= stamp <= now
+    ]
+    if episodes and now - max(stamp for stamp, _ in episodes) < NEGATIVE_EPISODE_GAP:
+        return False, False
+    allowed = (
+        len(episodes) >= 2 and now - min(stamp for stamp, _ in episodes) >= LONG_CONFIRMATION_GAP
+    )
+    if any(
+        event.get("long_negative_applied") and now - stamp < LONG_NEGATIVE_COOLDOWN
+        for stamp, event in episodes
+    ):
+        allowed = False
+    return True, allowed
+
+
+def perception_confirmed(observation: Mapping[str, Any], events, *, now: int) -> bool:
+    """Require a repeated directional attitude separated by at least six hours.
+
+    Args:
+        observation: Current normalized evidence.
+        events: Timestamp/observation pairs from the recent history.
+        now: Event timestamp.
+
+    Returns:
+        Whether an earlier matching direction supports a persistent update.
+    """
+    direction = SIGNAL_VALENCE.get(observation["kind"])
+    return direction is not None and any(
+        LONG_CONFIRMATION_GAP <= now - stamp <= PERCEPTION_CONFIRMATION_WINDOW
+        and SIGNAL_VALENCE.get(decode_event(event).get("kind")) == direction
+        for stamp, event in events
+    )
+
+
+def format_tone_guidance(data: Mapping[str, Any] | None, *, enabled=True) -> str:
+    """Provide a temporary expression overlay with stable relationship boundaries.
+
+    Args:
+        data: Raw per-user tone state.
+        enabled: Whether separation is enabled.
+
+    Returns:
+        Chinese reply guidance without creating an outbound message.
+    """
+    if not enabled:
+        return ""
+    state = tone_snapshot(data)
+    feeling = state["current_relationship_tone"]
+    if feeling < 0:
+        instruction = "刚才的互动让我有些戒备：本次语气稍收敛，减少撒娇和调侃，平静回应；对方善意沟通或道歉时自然缓和，不能迁怒、挖苦或冷落对方。"
+    elif feeling > 0:
+        instruction = "刚才的互动让我感到温暖：本次回应可以更柔和、自然表达感谢；称呼和亲密程度仍遵循长期关系及对方偏好。"
+    else:
+        instruction = "当前感受平稳，沿用长期关系表达。"
+    return f"\n【对该用户的当前感受（短期）】\n{instruction}当前感受会逐渐消退，最多持续两小时；它只影响当前语气，不代表长期好感或对方长期态度改变，也不能影响对其他用户的态度。"
