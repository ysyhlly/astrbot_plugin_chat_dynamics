+"""One model decision supplies the signed affection experience delta."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import hashlib
+import json
+import math
+from decimal import Decimal
+
+SCORING_VERSION = "llm_persona_experience_v1"
+
+@dataclass(frozen=True)
+class LLMAffectionDecision:
+    direction: str
+    experience_delta: float
+    reason: str
+    evidence: str
+    persona_evidence: str
+    message_hash: str
+    persona_fingerprint: str
+    persona_id: str
+
+    def audit_reason(self, *, source_event_id: str = "") -> str:
+        return "llm_affection:" + json.dumps(
+            {"schema": SCORING_VERSION, "source_event_id": source_event_id, **self.__dict__}, ensure_ascii=False,
+            separators=(",", ":"), allow_nan=False,
+        )
+
+
+def require_character_context(character):
+    """Require a concrete, versioned current persona before any model judgment."""
+    if not isinstance(character, dict):
+        raise ValueError("affection_persona_unavailable")
+    core = character.get("core_prompt")
+    if not isinstance(core, str) or not core.strip() or len(core) > 16000:
+        raise ValueError("affection_persona_core_invalid")
+    for key in ("persona_id", "fingerprint"):
+        value = character.get(key)
+        if not isinstance(value, str) or not value.strip() or len(value) > 256:
+            raise ValueError("affection_persona_identity_invalid")
+    return character
+
+
+def validate_decision(value, message: str, character=None, *, current_experience=None):
+    character = require_character_context(character)
+    if not isinstance(value, dict):
+        raise ValueError("affection_decision_missing")
+    direction = value.get("direction")
+    delta = value.get("experience_delta")
+    try:
+        valid_number = type(delta) in (int, float) and math.isfinite(delta)
+    except OverflowError:
+        valid_number = False
+    if not valid_number:
+        raise ValueError("affection_delta_invalid")
+    expected = "increase" if delta > 0 else "decrease" if delta < 0 else "unchanged"
+    if direction != expected:
+        raise ValueError("affection_direction_mismatch")
+    if current_experience is not None and Decimal(str(delta)) < -Decimal(str(current_experience)) - Decimal("0.000000000001"):
+        raise ValueError("affection_below_zero")
+    reason = value.get("reason")
+    evidence = value.get("evidence", "")
+    trait = value.get("persona_evidence", "")
+    if not isinstance(reason, str) or not 1 <= len(reason.strip()) <= 500:
+        raise ValueError("affection_reason_invalid")
+    if not isinstance(evidence, str) or len(evidence) > 500 or (evidence and evidence not in message):
+        raise ValueError("affection_source_evidence_invalid")
+    if delta != 0 and not evidence.strip():
+        raise ValueError("affection_source_evidence_missing")
+    if not isinstance(trait, str) or len(trait) > 500:
+        raise ValueError("affection_persona_evidence_invalid")
+    core = character.get("core_prompt", "") if isinstance(character, dict) else ""
+    if trait and (not isinstance(core, str) or trait not in core):
+        raise ValueError("affection_persona_evidence_invalid")
+    if delta != 0 and core and not trait.strip():
+        raise ValueError("affection_persona_evidence_missing")
+    return LLMAffectionDecision(
+        direction, float(delta), reason.strip(), evidence, trait,
+        hashlib.sha256(message.encode()).hexdigest(),
+        character["fingerprint"], character["persona_id"],
+    )
