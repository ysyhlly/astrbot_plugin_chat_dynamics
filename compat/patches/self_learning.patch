+    def _resolve_call_timeout(self, kwargs: Dict[str, Any]) -> float:
+        """Return the deadline (seconds) for one provider call.
+
+        The dedicated call_timeout keyword is consumed here; the provider level
+        timeout keyword is left untouched so existing callers keep their previous
+        semantics. Configuration is read defensively: a missing or invalid
+        llm_call_timeout falls back to the 90s default already used by
+        narrative_affection_chat_completion, and the value is clamped.
+        """
+        raw = kwargs.pop("call_timeout", None)
+        if raw is None and self._config is not None:
+            raw = getattr(self._config, "llm_call_timeout", None)
+        try:
+            timeout = float(raw)
+        except (TypeError, ValueError):
+            timeout = self._llm_call_timeout_default
+        if timeout <= 0:
+            timeout = self._llm_call_timeout_default
+        return max(self._llm_call_timeout_min, min(timeout, self._llm_call_timeout_max))
